import tripol.http
import tripol.time

func received(reply:http.Response, size:int)->int {
    assert reply.status==200 and reply.error=="" and len(reply.text)==size,"Unexpected HTTP benchmark response"
    return len(reply.text)
}

url=input("")
n=input_int("")
mode=input("")
width=input_int("")
size=input_int("")
directory=input("")
show "READY"
input_int("")
samples=ints(n/width)
start=time.now_ns()
count=0
if width==4 {
    for batch in range(n/4) {
        began=time.now_ns()
        scratch {
            request=http.request("GET",url)
            first=request.start()
            second=request.start()
            third=request.start()
            fourth=request.start()
            count+=received(first.await(),size)
            count+=received(second.await(),size)
            count+=received(third.await(),size)
            count+=received(fourth.await(),size)
        }
        samples[batch]=time.elapsed_ns(began)
    }
} else {
    for index in range(n) {
        began=time.now_ns()
        scratch {
            if mode=="stream" {
                reply=http.download(url,f"{directory}/{index}.bin")
                assert reply.status==200 and reply.error=="" and reply.bytes==size,"Unexpected HTTP download"
                count+=reply.bytes
            } else {
                count+=received(http.get(url),size)
            }
        }
        samples[index]=time.elapsed_ns(began)
    }
}
show time.elapsed_ns(start),count
for sample in samples {show sample}
show "END"
input_int("")
