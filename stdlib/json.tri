import tripol.utf8
import tripol.errors
// Small JSON writer; input strings must be valid UTF-8. No general parser yet.
func quote(s:string) -> string {return json_quote(s)}
func integer(n:int) -> string {return text(n)}
func boolean(b:bool) -> string {if b {return "true"}; return "false"}
func pair(key:string,value:string) -> string {return "{"+quote(key)+":"+quote(value)+"}"}
func integers(a:ints) -> string {
    assert len(a)<=128, "JSON array limit 128 integers"
    result="["
    for i in range(len(a)) {if i>0 {result+=","}; result+=text(a[i])}
    return result+"]"
}
// Bounded JSON grammar scanner. Byte offsets, no allocations while validating.
func ws(s:string,i:int,n:int)->int {
 while i<n {b=byte_at(s,i); if b!=32 and b!=9 and b!=10 and b!=13 {return i}; i+=1}
 return i
}
func hex(b:int)->bool {return (b>=48 and b<=57) or (b>=65 and b<=70) or (b>=97 and b<=102)}
func digit(b:int)->bool {return b>=48 and b<=57}
func quoted(s:string,i:int,n:int)->int {
 if i>=n or byte_at(s,i)!=34 {return -1}
 i+=1
 while i<n {
  b=byte_at(s,i); i+=1
  if b==34 {return i}
  if b<32 {return -1}
  if b==92 {
   if i>=n {return -1}
   b=byte_at(s,i);i+=1
   if b==117 {repeat 4 {if i>=n or not hex(byte_at(s,i)) {return -1};i+=1}}
   else if b!=34 and b!=92 and b!=47 and b!=98 and b!=102 and b!=110 and b!=114 and b!=116 {return -1}
  } else if b>=128 {
   // Reject invalid UTF-8 including overlong encodings and surrogate bytes.
   count=0; lo=128; hi=191
   if b>=194 and b<=223 {count=1}
   else if b>=224 and b<=239 {count=2;if b==224 {lo=160};if b==237 {hi=159}}
   else if b>=240 and b<=244 {count=3;if b==240 {lo=144};if b==244 {hi=143}}
   else {return -1}
   if i+count>n {return -1}
   c=byte_at(s,i);if c<lo or c>hi {return -1};i+=1
   repeat count-1 {c=byte_at(s,i);if c<128 or c>191 {return -1};i+=1}
  }
 }
 return -1
}
// Compare one raw JSON string to UTF-8 text without allocating a decoded copy.
func string_equals(raw:string,value:string)->bool {
 n=len(raw)
 size=len(value)
 if size>512 or n<size+2 or n>size*6+2 or quoted(raw,0,n)!=n {return false}
 at=1
 pos=0
 end=n-1
 while at<end {
  if pos>=size {return false}
  b=byte_at(raw,at)
  at+=1
  if b==92 {
   b=byte_at(raw,at)
   at+=1
   if b==117 {
    high=0
    scalar=0
    while true {
     scalar=0
     for i in range(4) {
      h=byte_at(raw,at+i)
      digit=0
      if h<=57 {digit=h-48} else if h<=70 {digit=h-55} else {digit=h-87}
      scalar=scalar*16+digit
     }
     at+=4
     if high>0 {
      if scalar<56320 or scalar>57343 {return false}
      scalar=65536+(high-55296)*1024+(scalar-56320)
      break
     }
     if scalar<55296 or scalar>56319 {
      if scalar>=56320 and scalar<=57343 {return false}
      break
     }
     if at+6>end or byte_at(raw,at)!=92 or byte_at(raw,at+1)!=117 {return false}
     high=scalar
     at+=2
    }
    width=utf8.width_at(value,pos)
    if width==0 or utf8.scalar_at(value,pos)!=scalar {return false}
    pos+=width
    continue
   }
   if b==98 {b=8}
   else if b==102 {b=12}
   else if b==110 {b=10}
   else if b==114 {b=13}
   else if b==116 {b=9}
  }
  if b!=byte_at(value,pos) {return false}
  pos+=1
 }
 return pos==size
}
// Decode a single JSON string. NUL is outside TRIPOL's string model.
func unquote(raw:string)->string {
 n=len(raw)
 if n<2 or quoted(raw,0,n)!=n {return ""}
 last=n-1
 at=1
 start=1
 result=""
 while at<last {
  if byte_at(raw,at)!=92 {at+=1;continue}
  if at>start {result+=slice(raw,start,at)}
  at+=1
  b=byte_at(raw,at)
  at+=1
  if b==117 {
   scalar=0
   high=0
   while true {
    scalar=0
    for i in range(4) {
     h=byte_at(raw,at+i)
     digit=0
     if h<=57 {digit=h-48} else if h<=70 {digit=h-55} else {digit=h-87}
     scalar=scalar*16+digit
    }
    at+=4
    if high>0 {
     if scalar<56320 or scalar>57343 {return ""}
     scalar=65536+(high-55296)*1024+scalar-56320
     break
    }
    if scalar<55296 or scalar>56319 {
     if scalar==0 or (scalar>=56320 and scalar<=57343) {return ""}
     break
    }
    if at+6>last or byte_at(raw,at)!=92 or byte_at(raw,at+1)!=117 {return ""}
    high=scalar
    at+=2
   }
   result+=utf8_char(scalar)
  } else {
   if b==98 {b=8}
   else if b==102 {b=12}
   else if b==110 {b=10}
   else if b==114 {b=13}
   else if b==116 {b=9}
   result+=utf8_char(b)
  }
  start=at
 }
 if start<last {result+=slice(raw,start,last)}
 return result
}
func literal(s:string,i:int,n:int,w:string)->int {
 k=len(w);if i+k>n {return -1}
 for j in range(k) {if byte_at(s,i+j)!=byte_at(w,j) {return -1}}
 return i+k
}
func number(s:string,i:int,n:int)->int {
 if i<n and byte_at(s,i)==45 {i+=1}
 if i>=n {return -1}
 if byte_at(s,i)==48 {i+=1}
 else {if not digit(byte_at(s,i)) {return -1};while i<n and digit(byte_at(s,i)) {i+=1}}
 if i<n and byte_at(s,i)==46 {i+=1;start=i;while i<n and digit(byte_at(s,i)) {i+=1};if i==start {return -1}}
 if i<n and (byte_at(s,i)==101 or byte_at(s,i)==69) {
  i+=1;if i<n and (byte_at(s,i)==43 or byte_at(s,i)==45) {i+=1}
  begin=i;while i<n and digit(byte_at(s,i)) {i+=1};if i==begin {return -1}
 }
 return i
}
func value(s:string,i:int,n:int,depth:int)->int {
 if depth>32 {return -1}; i=ws(s,i,n);if i>=n {return -1}
 b=byte_at(s,i)
 if b==34 {return quoted(s,i,n)}
 if b==116 {return literal(s,i,n,"true")}
 if b==102 {return literal(s,i,n,"false")}
 if b==110 {return literal(s,i,n,"null")}
 if b==123 or b==91 {
  closing=93;if b==123 {closing=125}
  i=ws(s,i+1,n);if i<n and byte_at(s,i)==closing {return i+1}
  while i<n {
   if b==123 {i=quoted(s,i,n);if i<0 {return -1};i=ws(s,i,n);if i>=n or byte_at(s,i)!=58 {return -1};i+=1}
   i=value(s,i,n,depth+1);if i<0 {return -1};i=ws(s,i,n)
   if i>=n {return -1};if byte_at(s,i)==closing {return i+1}
   if byte_at(s,i)!=44 {return -1};i=ws(s,i+1,n)
  }
  return -1
 }
 return number(s,i,n)
}
func valid(s:string)->bool {
 n=len(s);if n>4096 {return false};i=value(s,0,n,0);return i>=0 and ws(s,i,n)==n
}
// Exact JSON key spelling (quoted, including escape sequences); empty on missing or invalid.
func get_raw(s:string,key:string)->string {
 if len(s)>4096 {return ""};return get_raw_large(s,key)
}
// Gateway-sized bounded input, up to 65535 bytes; same grammar and depth.
func get_raw_large(s:string,key:string)->string {
 n=len(s)
 if len(key)>512 or n>65535 {return ""}
 i=ws(s,0,n)
 if i>=n or byte_at(s,i)!=123 {return ""}
 i=ws(s,i+1,n)
 wanted=quote(key)
 found=""
 while i<n {
  end=quoted(s,i,n)
  if end<0 {return ""}
  match=found=="" and end-i==len(wanted)
  if match {
   for j in range(end-i) {
    if byte_at(s,i+j)!=byte_at(wanted,j) {match=false;break}
   }
  }
  i=ws(s,end,n)
  if i>=n or byte_at(s,i)!=58 {return ""}
  i=ws(s,i+1,n)
  end=value(s,i,n,1)
  if end<0 {return ""}
  if match {found=slice(s,i,end)}
  i=ws(s,end,n)
  if i>=n {return ""}
  if byte_at(s,i)==125 {
   if ws(s,i+1,n)==n {return found}
   return ""
  }
  if byte_at(s,i)!=44 {return ""}
  i=ws(s,i+1,n)
 }
 return ""
}

// A JSON object builder shared by files, API requests and other consumers.
struct Object {
 __keys:string_list
 __values:string_list
}

func object()->Object {
 return Object(string_list(),string_list())
}

func Object.__put(self:Object,key:string,encoded:string)->bool {
 keys=self.__keys
 values=self.__values
 for i in range(keys.size()) {
  if keys.get(i)==key {values.set(i,encoded);return true}
 }
 keys.add(key)
 values.add(encoded)
 return true
}

func Object.set(self:Object,key:string,value:string)->bool {
 return self.__put(key,quote(value))
}

func Object.set(self:Object,key:string,value:int)->bool {
 return self.__put(key,text(value))
}

func Object.set(self:Object,key:string,value:bool)->bool {
 return self.__put(key,boolean(value))
}

func Object.set(self:Object,key:string,value:Object)->bool {
 return self.__put(key,value.encode())
}

func Object.encode(self:Object)->string {
 keys=self.__keys
 values=self.__values
 output="{"
 for i in range(keys.size()) {
  name=quote(keys.get(i))
  value=values.get(i)
  assert len(output)+len(name)+len(value)+3<=65535,"JSON object exceeds the TRIPOL string capacity"
  if i>0 {output+=","}
  output+=name+":"+value
 }
 return output+"}"
}

func Object.with(self:Object,key:string,value:string)->Object {
 self.set(key,value)
 return self
}
func Object.with(self:Object,key:string,value:int)->Object {
 self.set(key,value)
 return self
}
func Object.with(self:Object,key:string,value:bool)->Object {
 self.set(key,value)
 return self
}
func Object.with(self:Object,key:string,value:Object)->Object {
 self.set(key,value)
 return self
}

// These readers are the shared implementations used by the typed decoder.
func __decode_string(raw:string)->string {
 assert len(raw)>=2 and byte_at(raw,0)==34,"Expected a JSON string"
 out=unquote(raw)
 assert out!="" or raw=="\"\"","JSON string contains an unsupported character or Unicode escape"
 return out
}

func __decode_int(raw:string)->int {
 assert errors.is_int(raw),"Expected a JSON integer in the signed 64-bit range"
 return parse_int(raw)
}

func __decode_bool(raw:string)->bool {
 assert raw=="true" or raw=="false","Expected a JSON boolean"
 return raw=="true"
}

func __decode_object(raw:string)->Object {
 n=len(raw)
 i=ws(raw,0,n)
 assert i<n and byte_at(raw,i)==123,"Expected a JSON object"
 stop=value(raw,i,n,0)
 assert stop>=0 and ws(raw,stop,n)==n,"Invalid JSON object"
 result=object()
 keys=result.__keys
 values=result.__values
 i=ws(raw,i+1,n)
 while byte_at(raw,i)!=125 {
  end=quoted(raw,i,n)
  name=__decode_string(slice(raw,i,end))
  assert not keys.contains(name),"Duplicate key in JSON object"
  i=ws(raw,ws(raw,end,n)+1,n)
  end=value(raw,i,n,1)
  keys.add(name)
  values.add(slice(raw,i,end))
  i=ws(raw,end,n)
  if byte_at(raw,i)==44 {i=ws(raw,i+1,n)}
 }
 return result
}

func __decode_field(object_value:Object,name:string)->string {
 keys=object_value.__keys
 values=object_value.__values
 for i in range(keys.size()) {
  if keys.get(i)==name {return values.get(i)}
 }
 return ""
}

func __decode_array(raw:string)->string_list {
 n=len(raw)
 i=ws(raw,0,n)
 assert i<n and byte_at(raw,i)==91,"Expected a JSON array"
 stop=value(raw,i,n,0)
 assert stop>=0 and ws(raw,stop,n)==n,"Invalid JSON array"
 values=string_list()
 i=ws(raw,i+1,n)
 while byte_at(raw,i)!=93 {
  end=value(raw,i,n,1)
  values.add(slice(raw,i,end))
  i=ws(raw,end,n)
  if byte_at(raw,i)==44 {i=ws(raw,i+1,n)}
 }
 return values
}

// Positive integer limbs are least-significant first. The caller picks a base
// that leaves room for each multiplication and carry in a signed 64-bit slot.
func __multiply(limbs:list,factor:int,carry:int,base:int)->bool {
 for i in range(limbs.size()) {
  word=limbs.get(i)*factor+carry
  limbs.set(i,word%base)
  carry=word/base
 }
 while carry>0 {
  limbs.add(carry%base)
  carry/=base
 }
 return true
}

func __compare(left:list,right:list)->int {
 if left.size()!=right.size() {return left.size()-right.size()}
 i=left.size()-1
 while i>=0 {
  a=left.get(i)
  b=right.get(i)
  if a!=b {return a-b}
  i-=1
 }
 return 0
}

func __subtract(left:list,right:list)->bool {
 borrow=0
 for i in range(left.size()) {
  value=left.get(i)-borrow
  if i<right.size() {value-=right.get(i)}
  borrow=0
  if value<0 {value+=1073741824;borrow=1}
  left.set(i,value)
 }
 while left.size()>1 and left.get(left.size()-1)==0 {
  left.remove_at(left.size()-1)
 }
 return true
}

func __bit_length(limbs:list)->int {
 word=limbs.get(limbs.size()-1)
 size=(limbs.size()-1)*30
 while word>0 {size+=1;word/=2}
 return size
}

func __power(limbs:list,power:int,factor:int,step:int,step_factor:int,base:int)->bool {
 while power>=step {
  __multiply(limbs,step_factor,0,base)
  power-=step
 }
 rest=1
 repeat power {rest*=factor}
 if rest>1 {__multiply(limbs,rest,0,base)}
 return true
}

func __half(limbs:list)->bool {
 carry=0
 i=limbs.size()-1
 while i>=0 {
  word=limbs.get(i)+carry
  limbs.set(i,word/2)
  carry=word%2*1073741824
  i-=1
 }
 if limbs.size()>1 and limbs.get(limbs.size()-1)==0 {limbs.remove_at(limbs.size()-1)}
 return true
}

// A binary64 rounding boundary has at most 768 significant decimal digits.
// Keep 800 digits and remember whether any discarded digit is nonzero.
func __decode_float(raw:string)->float {
 size=len(raw)
 assert number(raw,0,size)==size and size>0,"Expected a finite JSON decimal"
 i=0
 sign=0
 if byte_at(raw,0)==45 {i=1;sign=-9223372036854775807-1}
 numerator=list([0])
 denominator=list([1])
 fractional=false
 scale=0
 significant=0
 omitted=0
 sticky=false
 while i<size {
  b=byte_at(raw,i)
  if b==101 or b==69 {break}
  i+=1
  if b==46 {fractional=true;continue}
  if fractional {scale-=1}
  digit_value=b-48
  if significant==0 and digit_value==0 {continue}
  significant+=1
  if significant<=800 {__multiply(numerator,10,digit_value,1073741824)}
  else {omitted+=1;sticky=sticky or digit_value!=0}
 }
 if significant==0 {return float_from_bits(sign)}
 scale+=omitted
 if i<size {
  i+=1
  negative=byte_at(raw,i)==45
  if negative or byte_at(raw,i)==43 {i+=1}
  exponent=0
  while i<size {
   if exponent<100000 {exponent=exponent*10+byte_at(raw,i)-48}
   i+=1
  }
  if negative {scale-=exponent} else {scale+=exponent}
 }
 leading=scale+significant-omitted-1
 assert leading<=308,"JSON decimal exceeds the finite binary64 range"
 if leading < -325 {return float_from_bits(sign)}
 if scale>=0 {__power(numerator,scale,10,9,1000000000,1073741824)}
 else {__power(denominator,-scale,10,9,1000000000,1073741824)}

 exponent=__bit_length(numerator)-__bit_length(denominator)
 if exponent<0 {__power(numerator,-exponent,2,29,536870912,1073741824)}
 else {__power(denominator,exponent,2,29,536870912,1073741824)}
 if __compare(numerator,denominator)<0 {
  if exponent>0 {__half(denominator)} else {__multiply(numerator,2,0,1073741824)}
  exponent-=1
 }
 if exponent < -1075 {return float_from_bits(sign)}
 if exponent == -1075 {
  if sticky or __compare(numerator,denominator)>0 {return float_from_bits(sign+1)}
  return float_from_bits(sign)
 }

 __subtract(numerator,denominator)
 fraction=1
 places=52
 if exponent < -1022 {places=exponent+1074}
 repeat places {
  __multiply(numerator,2,0,1073741824)
  fraction*=2
  if __compare(numerator,denominator)>=0 {
   __subtract(numerator,denominator)
   fraction+=1
  }
 }
 __multiply(numerator,2,0,1073741824)
 remainder=__compare(numerator,denominator)
 if remainder>0 or (remainder==0 and (sticky or fraction%2==1)) {fraction+=1}
 if exponent>=-1022 {fraction+=(exponent+1022)*4503599627370496}
 assert fraction<9218868437227405312,"JSON decimal exceeds the finite binary64 range"
 return float_from_bits(sign+fraction)
}

// Write the exact decimal expansion of a finite IEEE binary64 value. This
// keeps even subnormals round-trippable without depending on locale or libc.
func __encode_float(value:float)->string {
 raw=float_bits(value)
 prefix=""
 if raw<0 {prefix="-";raw-=(-9223372036854775807-1)}
 if raw==0 {return prefix+"0"}
 coded=raw/4503599627370496
 assert coded<2047,"JSON cannot encode a non-finite decimal"
 limb=raw%4503599627370496
 shift=-1074
 if coded>0 {limb+=4503599627370496;shift=coded-1075}
 digits=list([limb%1000000000])
 if limb>=1000000000 {digits.add(limb/1000000000)}
 if shift>=0 {__power(digits,shift,2,29,536870912,1000000000)}
 else {__power(digits,-shift,5,12,244140625,1000000000)}
 i=digits.size()-1
 output=text(digits.get(i))
 i-=1
 while i>=0 {
  chunk=text(digits.get(i))
  repeat 9-len(chunk) {output+="0"}
  output+=chunk
  i-=1
 }
 if shift>=0 {return prefix+output}
 fractional=-shift
 end=len(output)
 while end>0 and fractional>0 and byte_at(output,end-1)==48 {end-=1;fractional-=1}
 output=slice(output,0,end)
 if fractional==0 {return prefix+output}
 if fractional<end {return prefix+slice(output,0,end-fractional)+"."+slice(output,end-fractional,end)}
 result=prefix+"0."
 repeat fractional-end {result+="0"}
 return result+output
}

func __decode_type(raw:string,kind:string,optional:bool)->bool {
 if raw=="" or raw=="null" {return optional}
 if kind=="string" {return byte_at(raw,0)==34}
 if kind=="int" {return errors.is_int(raw)}
 if kind=="bool" {return raw=="true" or raw=="false"}
 if kind=="float" {return number(raw,0,len(raw))==len(raw)}
 if kind=="list" {return byte_at(raw,0)==91}
 return byte_at(raw,0)==123
}

func __append(output:string,item:string)->string {
 assert len(output)+len(item)+2<=65535,"JSON output exceeds the TRIPOL string capacity"
 if len(output)==1 {return output+item}
 return output+","+item
}
