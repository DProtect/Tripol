// Lexical path helpers (both separators), not filesystem resolution or sandboxing.
func separator(b:int)->bool {return b==47 or b==92}
func last_separator(s:string)->int {
 n=len(s);i=n-1;while i>=0 {if separator(byte_at(s,i)) {return i};i-=1};return -1
}
func basename(s:string)->string {return slice(s,last_separator(s)+1,len(s))}
func dirname(s:string)->string {i=last_separator(s);if i<0 {return ""};if i==0 {return slice(s,0,1)};return slice(s,0,i)}
func extension(s:string)->string {
 start=last_separator(s)+1;i=len(s)-1
 while i>start {if byte_at(s,i)==46 {return slice(s,i,len(s))};i-=1}
 return ""
}
func join(a:string,b:string)->string {
 if len(a)==0 {return b};if len(b)==0 {return a}
 if separator(byte_at(a,len(a)-1)) {return a+b};return a+"/"+b
}
