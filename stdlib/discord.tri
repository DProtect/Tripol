}

func Webhook.send(self:Webhook,batch:Embeds)->string {
 return self.__send(batch.payload())
}

func Webhook.send(self:Webhook,layout:Components)->string {
 return self.__send(layout.payload())
}

func Webhook.send_files(self:Webhook,layout:Components,paths:string_list)->string {
 return self.__send(upload_envelope(layout.payload(),paths),true)
}

func Webhook.send_files(self:Webhook,embed:Embed,paths:string_list)->string {
 return self.__send(upload_envelope(embed.payload(),paths),true)
}

func Webhook.send_files(self:Webhook,content:string,paths:string_list)->string {
