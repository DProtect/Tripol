 return event_id(json.get_raw_large(reply,"id"))
}

func Member.dm(self:Member,content:string)->string {
 payload=interaction_message(content)
 credential=token()
 body="{\"recipient_id\":"+json.quote(self.__user)+"}"
 channel=event_id(json.get_raw_large(discord_rest(2,"/api/v10/users/@me/channels",credential,body),"id"))
 if channel=="" {return ""}
 return event_id(json.get_raw_large(discord_rest(2,channel_path(channel),credential,payload),"id"))
}

