}

func Channel.invite(self:Channel,max_age=86400,max_uses=0,temporary=false,unique=true)->string {
 assert max_age>=0 and max_age<=604800,"Discord invite duration must be 0 to 604800 seconds"
 assert max_uses>=0 and max_uses<=100,"Discord invite use limit must be 0 to 100"
 body="{\"max_age\":"+text(max_age)+",\"max_uses\":"+text(max_uses)+",\"temporary\":"+json.boolean(temporary)+",\"unique\":"+json.boolean(unique)+"}"
 return json.unquote(json.get_raw_large(discord_rest(2,"/api/v10/channels/"+self.__id+"/invites",token(),body),"code"))
}

func Channel.invites(self:Channel)->string {
 return discord_rest(1,"/api/v10/channels/"+self.__id+"/invites",token(),"")
}

func Guild.invites(self:Guild)->string {
 return discord_rest(1,self.__path("invites"),token(),"")
}

func invite_path(code:string)->string {
 assert len(code)>0 and len(code)<=100,"Provide the Discord invite code"
 for i in range(len(code)) {
  b=byte_at(code,i)
  assert (b>=48 and b<=57) or (b>=65 and b<=90) or (b>=97 and b<=122) or b==45 or b==95,"Invalid Discord invite code"
 }
 return "/api/v10/invites/"+code
}

func invite_info(code:string,counts=false)->string {
 return discord_rest(1,invite_path(code)+"?with_counts="+json.boolean(counts)+"&with_expiration=true",token(),"")
}

func revoke_invite(code:string)->bool {
 return len(discord_rest(5,invite_path(code),token(),""))>0
}

func archive_minutes(duration:string)->int {
 if duration=="hour" {return 60}
 if duration=="day" {return 1440}
 if duration=="three_days" {return 4320}
 assert duration=="week","Choose hour, day, three_days or week for auto archive"
 return 10080
}

func Channel.thread(self:Channel,name:string,archive="day",private=false)->string {
 assert utf8.valid(name) and utf8.count(name)>=1 and utf8.count(name)<=100,"Discord thread names require 1 to 100 characters"
 kind=11
 if private {kind=12}
 body="{\"name\":"+json.quote(name)+",\"type\":"+text(kind)+",\"auto_archive_duration\":"+text(archive_minutes(archive))+"}"
 return event_id(json.get_raw_large(discord_rest(2,"/api/v10/channels/"+self.__id+"/threads",token(),body),"id"))
}

func Channel.thread_from(self:Channel,message_id:string,name:string,archive="day")->string {
 assert message_id!="" and event_id(json.quote(message_id))==message_id,"Invalid Discord message ID"
 assert utf8.valid(name) and utf8.count(name)>=1 and utf8.count(name)<=100,"Discord thread names require 1 to 100 characters"
 body="{\"name\":"+json.quote(name)+",\"auto_archive_duration\":"+text(archive_minutes(archive))+"}"
 return event_id(json.get_raw_large(discord_rest(2,channel_path(self.__id)+"/"+message_id+"/threads",token(),body),"id"))
}

func Channel.archive(self:Channel,enabled=true)->bool {
 return len(discord_rest(4,"/api/v10/channels/"+self.__id,token(),"{\"archived\":"+json.boolean(enabled)+"}"))>0
}

func Channel.lock_thread(self:Channel,enabled=true)->bool {
 return len(discord_rest(4,"/api/v10/channels/"+self.__id,token(),"{\"locked\":"+json.boolean(enabled)+"}"))>0
}

func Channel.thread_member(self:Channel,user_id="@me",enabled=true)->bool {
 assert user_id=="@me" or (user_id!="" and event_id(json.quote(user_id))==user_id),"Invalid Discord thread member ID"
 method=3
 if not enabled {method=5}
 return len(discord_rest(method,"/api/v10/channels/"+self.__id+"/thread-members/"+user_id,token(),""))>0
}

func Channel.__tag_ids(self:Channel,tags:string_list)->string {
 assert tags.size()<=5,"Discord posts accept up to five tags"
 result="["
 for i in range(tags.size()) {
  id=tags.get(i)
  assert id!="" and event_id(json.quote(id))==id,"Provide a Discord forum tag ID"
  for j in range(i) {assert tags.get(j)!=id,"Duplicate Discord forum tag"}
  if i>0 {result+=","}
  result+=json.quote(id)
 }
 return result+"]"
}

func Channel.post(self:Channel,title:string,content:string,archive="day")->string {
 return self.post(title,content,string_list(),archive)
}

func Channel.post(self:Channel,title:string,content:string,tags:string_list,archive="day")->string {
 assert utf8.valid(title) and utf8.count(title)>=1 and utf8.count(title)<=100,"Discord forum titles require 1 to 100 characters"
 body="{\"name\":"+json.quote(title)+",\"auto_archive_duration\":"+text(archive_minutes(archive))+",\"message\":"+interaction_message(content)+",\"applied_tags\":"+self.__tag_ids(tags)+"}"
 return event_id(json.get_raw_large(discord_rest(2,"/api/v10/channels/"+self.__id+"/threads",token(),body),"id"))
}

func Channel.apply_tags(self:Channel,tags:string_list)->bool {
 return len(discord_rest(4,"/api/v10/channels/"+self.__id,token(),"{\"applied_tags\":"+self.__tag_ids(tags)+"}"))>0
}

struct ForumTags {
 __entries:string_list
 __ids:string_list
}

func forum_tags()->ForumTags {
 return ForumTags(string_list(),string_list())
}

func ForumTags.tag(self:ForumTags,name:string,id="",moderated=false,emoji="")->bool {
 assert utf8.valid(name) and utf8.count(name)>=1 and utf8.count(name)<=20,"Discord forum tag names require 1 to 20 characters"
 entries=self.__entries
 ids=self.__ids
 assert entries.size()<20,"Discord forums accept up to 20 tags"
 assert id=="" or (event_id(json.quote(id))==id and not ids.contains(id)),"Use a unique existing tag ID or leave it empty"
 item="{\"name\":"+json.quote(name)+",\"moderated\":"+json.boolean(moderated)
 if id!="" {item+=",\"id\":"+json.quote(id)}
 if emoji!="" {
  parsed=emoji_payload(emoji)
  custom=json.get_raw_large(parsed,"id")
  if custom!="" {item+=",\"emoji_id\":"+custom}
  else {item+=",\"emoji_name\":"+json.get_raw_large(parsed,"name")}
 }
 entries.add(item+"}")
 ids.add(id)
 return true
}

func ForumTags.payload(self:ForumTags)->string {
 entries=self.__entries
 result="["
 for i in range(entries.size()) {
  if i>0 {result+=","}
  result+=entries.get(i)
 }
 return result+"]"
}

func Channel.set_forum_tags(self:Channel,tags:ForumTags)->bool {
 return len(discord_rest(4,"/api/v10/channels/"+self.__id,token(),"{\"available_tags\":"+tags.payload()+"}"))>0
}

func Channel.slowmode(self:Channel,seconds:int)->bool {
 assert seconds>=0 and seconds<=21600,"Discord slowmode requires 0 to 21600 seconds"
 body="{\"rate_limit_per_user\":"+text(seconds)+"}"
 return len(discord_rest(4,"/api/v10/channels/"+self.__id,token(),body))>0
}

func Channel.delete_message(self:Channel,message_id:string)->bool {
 assert message_id!="" and event_id(json.quote(message_id))==message_id,"Invalid Discord message ID"
 return len(discord_rest(5,channel_path(self.__id)+"/"+message_id,token(),""))>0
}

func Channel.edit_message(self:Channel,message_id:string,content:string)->bool {
 assert message_id!="" and event_id(json.quote(message_id))==message_id,"Invalid Discord message ID"
 return len(discord_rest(4,channel_path(self.__id)+"/"+message_id,token(),interaction_message(content)))>0
}

func Channel.edit_components(self:Channel,message_id:string,layout:Components)->bool {
 assert message_id!="" and event_id(json.quote(message_id))==message_id,"Invalid Discord message ID"
 return len(discord_rest(4,channel_path(self.__id)+"/"+message_id,token(),layout.payload()))>0
}

func Channel.purge(self:Channel,message_ids:string_list)->bool {
 count=message_ids.size()
 assert count>=2 and count<=100,"Discord bulk deletion requires 2 to 100 message IDs"
 seen=string_list(count)
 body="{\"messages\":["
 for i in range(count) {
  id=message_ids[i]
  assert id!="" and event_id(json.quote(id))==id,"Invalid Discord message ID"
  assert not seen.contains(id),"Discord bulk deletion requires distinct message IDs"
  seen.add(id)
  if i>0 {body+=","}
  body+=json.quote(id)
 }
 return len(discord_rest(2,channel_path(self.__id)+"/bulk-delete",token(),body+"]}"))>0
}

func Channel.pin(self:Channel,message_id:string,pinned=true)->bool {
 assert message_id!="" and event_id(json.quote(message_id))==message_id,"Invalid Discord message ID"
 method=3
 if not pinned {method=5}
 return len(discord_rest(method,channel_path(self.__id)+"/pins/"+message_id,token(),""))>0
}

func Channel.react(self:Channel,message_id:string,emoji:string,enabled=true)->bool {
 assert message_id!="" and event_id(json.quote(message_id))==message_id,"Invalid Discord message ID"
 assert emoji!="" and utf8.valid(emoji),"Discord reaction requires a Unicode emoji or name:id"
 path=channel_path(self.__id)+"/"+message_id+"/reactions/"
 assert len(emoji)<=1020-len(path),"Discord reaction path exceeds the transport capacity"
 hex="0123456789ABCDEF"
 for i in range(len(emoji)) {
  b=byte_at(emoji,i)
  if (b>=48 and b<=57) or (b>=65 and b<=90) or (b>=97 and b<=122) or b==95 {
   path+=slice(emoji,i,i+1)
  } else {
   path+="%"+slice(hex,b/16,b/16+1)+slice(hex,b%16,b%16+1)
  }
 }
 assert len(path)+4<=1024,"Discord reaction path exceeds the transport capacity"
 method=3
 if not enabled {method=5}
 return len(discord_rest(method,path+"/@me",token(),""))>0
}
