  assert timestamp_valid(until),"Discord requires an ISO 8601 timeout timestamp"
  deadline=json.quote(until)
 }
 return len(discord_rest(4,self.__path("members"),token(),"{\"communication_disabled_until\":"+deadline+"}"))>0
