 body="[{\"id\":"+json.quote(channel_id)+",\"position\":"+text(position)+"}]"
 return len(discord_rest(4,self.__path("channels"),token(),body))>0
}

func Guild.private_channel(self:Guild,name:string,user_id:string,parent_id="")->string {
 assert utf8.valid(name) and utf8.count(name)>=1 and utf8.count(name)<=100,"Discord channel names require 1 to 100 characters"
 assert user_id!="" and event_id(json.quote(user_id))==user_id,"Provide the user's Discord ID"
 assert parent_id=="" or event_id(json.quote(parent_id))==parent_id,"Provide a category ID or leave it empty"
 body="{\"name\":"+json.quote(name)+",\"type\":0,\"permission_overwrites\":[{\"id\":"+json.quote(self.id)+",\"type\":0,\"deny\":\"1024\"},{\"id\":"+json.quote(user_id)+",\"type\":1,\"allow\":\"3072\"}]"
 if parent_id!="" {body+=",\"parent_id\":"+json.quote(parent_id)}
 return event_id(json.get_raw_large(discord_rest(2,self.__path("channels"),token(),body+"}"),"id"))
}

struct Webhook {
 __id:string
 __credential:string
}

struct WebhookInfo {
 id:string
 name:string
 channel_id:string
 guild_id:string
}

func webhook_ref(id:string,credential="")->Webhook {
 assert id!="" and event_id(json.quote(id))==id,"Invalid Discord webhook ID"
 return Webhook(id,credential)
}

func Webhook.id(self:Webhook)->string {return self.__id}

func Channel.create_webhook(self:Channel,name:string)->Webhook {
 assert utf8.valid(name) and utf8.count(name)>=1 and utf8.count(name)<=80,"Discord webhook names require 1 to 80 characters"
 body=discord_rest(2,"/api/v10/channels/"+self.__id+"/webhooks",token(),"{\"name\":"+json.quote(name)+"}")
 return Webhook(event_id(json.get_raw_large(body,"id")),json.unquote(json.get_raw_large(body,"token")))
}

func Webhook.read(self:Webhook)->WebhookInfo {
 if self.__id=="" {return WebhookInfo("","","","")}
 body=discord_rest(1,"/api/v10/webhooks/"+self.__id,token(),"")
 return WebhookInfo(event_id(json.get_raw_large(body,"id")),json.unquote(json.get_raw_large(body,"name")),event_id(json.get_raw_large(body,"channel_id")),event_id(json.get_raw_large(body,"guild_id")))
}

func Webhook.edit(self:Webhook,name:string,channel_id="")->bool {
 if self.__id=="" {return false}
 assert utf8.valid(name) and utf8.count(name)>=1 and utf8.count(name)<=80,"Discord webhook names require 1 to 80 characters"
 assert channel_id=="" or event_id(json.quote(channel_id))==channel_id,"Invalid Discord webhook channel ID"
 body="{\"name\":"+json.quote(name)
 if channel_id!="" {body+=",\"channel_id\":"+json.quote(channel_id)}
 return len(discord_rest(4,"/api/v10/webhooks/"+self.__id,token(),body+"}"))>0
}

func Webhook.delete(self:Webhook)->bool {
 if self.__id=="" {return false}
 return len(discord_rest(5,"/api/v10/webhooks/"+self.__id,token(),""))>0
}

func Webhook.__send(self:Webhook,payload:string,multipart=false)->string {
 if self.__id=="" or self.__credential=="" or not gw_host_available() {return ""}
 method=11
 if multipart {method=12}
 return event_id(json.get_raw_large(discord_rest(method,self.__id,self.__credential,payload),"id"))
}

func Webhook.send(self:Webhook,content:string)->string {
 return self.__send(interaction_message(content))
}

