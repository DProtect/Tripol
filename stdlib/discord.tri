import tripol.http
import tripol.datetime
import tripol.https
import tripol.env
import tripol.json
import tripol.time
import tripol.errors
import tripol.utf8
import tripol.bits
// Public Discord API discovery, no bot token or authentication required.
func gateway()->string {return https.get("discord.com","/api/v10/gateway")}
func api_host()->string {return "discord.com"}
// Native Windows REST helpers; Gateway R4 below.
func token()->string {
 t=env.get("DISCORD_TOKEN")
 assert len(t)>0 and len(t)<=512,"Set DISCORD_TOKEN in your environment"
 return t
}
func channel_path(channel:string)->string {
 assert len(channel)>0 and len(channel)<=20,"Invalid Discord channel ID"
 for i in range(len(channel)) {b=byte_at(channel,i);assert b>=48 and b<=57,"Channel ID must contain digits only"}
 return "/api/v10/channels/"+channel+"/messages"
}
func send(channel:string,message:string)->bool {
 assert len(message)>0 and len(message)<=512,"Discord message limit: 512 UTF-8 bytes"
 body="{\"content\":"+json.quote(message)+",\"allowed_mentions\":{\"parse\":[]}}"
 result=discord_request(channel_path(channel),token(),body)
 return len(result)>0
}
func latest(channel:string)->string {
 result=discord_request(channel_path(channel)+"?limit=1",token(),"")
 if not json.valid(result) {return ""}
 if len(result)<3 {return ""}
 if byte_at(result,0)!=91 {return ""}
 start=json.ws(result,1,len(result))
 end=json.value(result,start,len(result),0)
 if end<0 {return ""}
 if byte_at(result,start)!=123 {return ""}
 return slice(result,start,end)
}
func message_id(message:string)->int {
 raw=json.get_raw(message,"id")
 if len(raw)<3 or len(raw)>21 {return 0}
 if byte_at(raw,0)!=34 or byte_at(raw,len(raw)-1)!=34 {return 0}
 for i in range(1,len(raw)-1) {b=byte_at(raw,i);if b<48 or b>57 {return 0}}
 return errors.int_or(slice(raw,1,len(raw)-1),0)
}
func matches(message:string,command:string)->bool {
 if len(message)==0 {return false}
 author=json.get_raw(message,"author")
 if len(author)==0 {return false}
 if json.get_raw(author,"bot")=="true" {return false}
 if len(json.get_raw(message,"webhook_id"))>0 {return false}
 return json.string_equals(json.get_raw(message,"content"),command)
}
// Single command in a quiet test channel; polls only the newest message.
func listen(channel:string,command:string,response:string)->int {
 assert len(command)>0 and len(command)<=128,"Invalid command"
 assert len(response)>0 and len(response)<=512,"Invalid response"
 last=0
 scratch {last=message_id(latest(channel))}
 show "TRIPOL Discord bot listening (REST). Ctrl+C to stop."
 while true {
  time.sleep(2500)
  scratch {
   message=latest(channel)
   id=message_id(message)
   if id>last {
    last=id
    if matches(message,command) {send(channel,response)}
   }
  }
 }
 return 0
}

// R3: a single process-local bot with up to 16 exact commands.
// Configuration is copied to fixed private storage, outside temporary arenas.
func login(secret:string)->bool {
 assert len(secret)>0 and len(secret)<=512,"Invalid bot token length"
 for i in range(len(secret)) {
  b=byte_at(secret,i)
  assert (b>=48 and b<=57) or (b>=65 and b<=90) or (b>=97 and b<=122) or b==45 or b==46 or b==95,"Invalid bot token characters"
 }
 return bot_slot_set(0,secret)
}
func login_env()->bool {
 ok=false
 scratch {ok=login(token())}
 return ok
}
func channel(id:string)->bool {
 assert len(id)>0 and len(id)<=20,"Invalid Discord channel ID"
 for i in range(len(id)) {b=byte_at(id,i);assert b>=48 and b<=57,"Channel ID must contain digits only"}
 return bot_slot_set(1,id)
}
func reply(command:string,response:string)->bool {
 assert len(command)>0 and len(command)<=128,"Invalid command"
 assert len(response)>0 and len(response)<=512,"Invalid response"
 found=false
 scratch {
  for i in range(16) {
   slot=2+i*2
   existing=bot_slot_get(slot)
   if existing==command or existing=="" {
    bot_slot_set(slot,command)
    bot_slot_set(slot+1,response)
    found=true
    break
   }
  }
 }
 assert found,"Maximum 16 Discord commands"
 return found
}
func reset()->bool {
 for i in range(39) {bot_slot_set(i,"")}
 return true
}
func configured()->bool {
 ok=false
 scratch {ok=len(bot_slot_get(0))>0}
 return ok
}
// Offline command lookup; never returns token or channel.
func preview(command:string)->string {
 match=-1
 scratch {
  for i in range(16) {
   slot=2+i*2
   existing=bot_slot_get(slot)
   if existing=="" {break}
   if existing==command {match=slot+1;break}
  }
 }
 if match<0 {return ""}
 return bot_slot_get(match)
}
// Resolve a raw message offline; same matching rules as run().
func dispatch(message:string)->string {
 match=-1
 scratch {
  for i in range(16) {
   slot=2+i*2
   command=bot_slot_get(slot)
   if command=="" {break}
   if matches(message,command) {match=slot+1;break}
  }
 }
 if match<0 {return ""}
 return bot_slot_get(match)
}
func send_to(id:string,message:string)->bool {
 assert len(message)>0 and len(message)<=512,"Invalid Discord message"
 ok=false
 scratch {
  secret=bot_slot_get(0)
  assert len(secret)>0,"Call discord.login first"
  body="{\"content\":"+json.quote(message)+",\"allowed_mentions\":{\"parse\":[]}}"
  result=discord_request(channel_path(id),secret,body)
  ok=len(result)>0
 }
 return ok
}
// A selected channel is optional for Gateway replies, but required for unsolicited messages.
func has_channel()->bool {
 ok=false
 scratch {ok=len(bot_slot_get(1))>0}
 return ok
}
func all_channels()->bool {return bot_slot_set(1,"")}
func say(message:string)->bool {
 ok=false
 scratch {
  assert has_channel(),"Select a channel before calling discord.say"
  ok=send_to(bot_slot_get(1),message)
 }
 return ok
}
func parse_latest(result:string)->string {
 if not json.valid(result) or len(result)<3 {return ""}
 if byte_at(result,0)!=91 {return ""}
 start=json.ws(result,1,len(result))
 end=json.value(result,start,len(result),0)
 if end<0 {return ""}
 if byte_at(result,start)!=123 {return ""}
 return slice(result,start,end)
}
func run_rest()->int {
 assert configured() and has_channel(),"REST requires login and a selected channel"
 last=0
 scratch {
  raw=discord_request(channel_path(bot_slot_get(1))+"?limit=1",bot_slot_get(0),"")
  last=message_id(parse_latest(raw))
 }
 show "TRIPOL Discord R3 (REST) - Ctrl+C to stop."
 while true {
  time.sleep(2500)
  scratch {
   raw=discord_request(channel_path(bot_slot_get(1))+"?limit=1",bot_slot_get(0),"")
   message=parse_latest(raw)
   id=message_id(message)
   if id>last {
    last=id
    response=dispatch(message)
    if len(response)>0 {say(response)}
   }
  }
 }
 return 0
}


// R5 Gateway configuration: optional channel filter, exact prefix commands.
// Shortcut for a locally configured single-channel bot.
func setup(secret:string,id:string)->bool {
 login(secret)
 return channel(id)
}
func status(value:string)->bool {
 assert value=="online" or value=="idle" or value=="dnd" or value=="invisible","Invalid Discord status"
 return bot_slot_set(34,value)
}
func activity(value:string)->bool {
 assert len(value)<=128,"Activity limit 128 bytes"
 return bot_slot_set(35,value)
}
// Send once after READY instead of making a REST request before connecting.
func welcome(value:string)->bool {
 assert len(value)<=512,"Welcome limit 512 bytes"
 return bot_slot_set(36,value)
}
func connected()->bool {
 ok=false
 scratch {ok=bot_slot_get(38)=="ready"}
 return ok
}
// Last heartbeat round trip in ms; -1 until the first ACK.
func ping()->int {
 result=-1
 scratch {result=errors.int_or(bot_slot_get(37),-1)}
 return result
}
func identify_payload(intents=33281)->string {
 secret=bot_slot_get(0)
 state=bot_slot_get(34)
 if state=="" {state="online"}
 act=bot_slot_get(35)
 activities="[]"
 if len(act)>0 {activities="[{\"name\":"+json.quote(act)+",\"type\":0}]"}
 // GUILDS | GUILD_MESSAGES | MESSAGE_CONTENT (privileged).
 os=platform_name()
 return "{\"op\":2,\"d\":{\"token\":"+json.quote(secret)+",\"intents\":"+text(intents)+",\"properties\":{\"os\":"+json.quote(os)+",\"browser\":\"TRIPOL\",\"device\":\"TRIPOL\"},\"presence\":{\"since\":null,\"activities\":"+activities+",\"status\":"+json.quote(state)+",\"afk\":false}}}"
}
func heartbeat_payload(sequence:int)->string {
 if sequence<0 {return "{\"op\":1,\"d\":null}"}
 return "{\"op\":1,\"d\":"+text(sequence)+"}"
}
// Validate the event channel ID and apply the optional channel filter.
func event_channel(event:string)->string {
 if json.get_raw_large(event,"op")!="0" or json.get_raw_large(event,"t")!="\"MESSAGE_CREATE\"" {return ""}
 d=json.get_raw_large(event,"d")
 raw=json.get_raw_large(d,"channel_id")
 if len(raw)<3 or len(raw)>22 {return ""}
 if byte_at(raw,0)!=34 or byte_at(raw,len(raw)-1)!=34 {return ""}
 for i in range(1,len(raw)-1) {b=byte_at(raw,i);if b<48 or b>57 {return ""}}
 id=slice(raw,1,len(raw)-1)
 filter=bot_slot_get(1)
 if len(filter)>0 and filter!=id {return ""}
 return id
}
// Offline testable Gateway MESSAGE_CREATE dispatch. Optional channel filter,
// exact command content, no bots or webhooks. No token or network required.
func gateway_reply(event:string)->string {
 slot_found=-1
 scratch {
  if json.get_raw_large(event,"op")=="0" and json.get_raw_large(event,"t")=="\"MESSAGE_CREATE\"" {
   d=json.get_raw_large(event,"d")
   if len(event_channel(event))>0 {
    author=json.get_raw_large(d,"author")
    if len(author)>0 and json.get_raw_large(author,"bot")!="true" and len(json.get_raw_large(d,"webhook_id"))==0 {
     content=json.get_raw_large(d,"content")
     for i in range(16) {
      slot=2+i*2
      command=bot_slot_get(slot)
      if command=="" {break}
      if json.string_equals(content,command) {slot_found=slot+1;break}
     }
    }
   }
  }
 }
 if slot_found<0 {return ""}
 return bot_slot_get(slot_found)
}
// The JSON event is preserved for consumers that need additional Discord fields.
struct Message {
 event_json:string
 content_json:string
 channel_id:string
 author_id:string
}

func Message.matches(self:Message,content:string)->bool {
 return json.string_equals(self.content_json,content)
}

func Message.reply(self:Message,content:string)->string {
 assert len(content)>0 and len(content)<=512 and utf8.valid(content),"Discord response must be 1 to 512 UTF-8 bytes"
 return content
}

func ignore_message(message:Message)->string {return ""}

// Validate a Discord snowflake without converting its unsigned value to int64.
func event_id(raw:string)->string {
 if len(raw)<3 or len(raw)>22 {return ""}
 if byte_at(raw,0)!=34 or byte_at(raw,len(raw)-1)!=34 {return ""}
 for i in range(1,len(raw)-1) {
  b=byte_at(raw,i)
  if b<48 or b>57 {return ""}
 }
 return slice(raw,1,len(raw)-1)
}

func dispatch_message(event:string,handler:func(Message)->string)->string {
 if json.get_raw_large(event,"op")!="0" or json.get_raw_large(event,"t")!="\"MESSAGE_CREATE\"" {return ""}
 data=json.get_raw_large(event,"d")
 channel_id=event_id(json.get_raw_large(data,"channel_id"))
 if len(channel_id)==0 {return ""}
 author=json.get_raw_large(data,"author")
 author_id=event_id(json.get_raw_large(author,"id"))
 if len(author_id)==0 or json.get_raw_large(author,"bot")=="true" or len(json.get_raw_large(data,"webhook_id"))>0 {return ""}
 content=json.get_raw_large(data,"content")
 if len(content)<2 or byte_at(content,0)!=34 {return ""}
 result=handler(Message(event,content,channel_id,author_id))
 assert len(result)<=512 and utf8.valid(result),"Discord response must be UTF-8, up to 512 bytes"
 return result
}

func run(intents=33281)->int {
 return run_handler(&ignore_message,intents)
}

func run_handler(handler:func(Message)->string,intents=33281)->int {
 return run_session(handler,intents,string_list(),empty_interactions())
}

func run_session(handler:func(Message)->string,intents:int,keys:string_list,handlers:list[func(Interaction)->string])->int {
 assert intents==1 or intents==33281,"Unsupported Discord Gateway intents"
 return events().__run(handler,intents,keys,handlers,string_list())
}

func GatewayEvents.__run(self:GatewayEvents,handler:func(Message)->string,intents:int,keys:string_list,handlers:list[func(Interaction)->string],policies:string_list)->int {
 assert configured(),"Call discord.login first"
 scratch {assert has_channel() or len(bot_slot_get(36))==0,"Welcome requires a selected channel"}
 events=self.__names
 callbacks=self.__handlers
 if gw_host_available() {
  started=false
  scratch {started=gw_host_start(identify_payload(intents))=="1"}
  assert started,"Unable to start Discord Gateway"
  bot_slot_set(37,"");bot_slot_set(38,"")
  show "TRIPOL Discord Gateway connecting..."
  done=false;greeted=false
  while not done {
   scratch {
    event=gw_host_poll()
    if event=="!" {done=true}
    else if len(event)>0 {
     kind=json.get_raw_large(event,"t")
     if kind=="\"READY\"" or kind=="\"RESUMED\"" {
      bot_slot_set(38,"ready")
      if not greeted and kind=="\"READY\"" {
       greeted=true
       show "TRIPOL Discord Gateway READY - Ctrl+C to stop."
       greeting=bot_slot_get(36)
       if len(greeting)>0 {say(greeting)}
      }
     } else if kind=="\"MESSAGE_CREATE\"" {
      channel_id=event_channel(event)
      if len(channel_id)>0 {
       response=gateway_reply(event)
       if len(response)==0 and handler!=&ignore_message {response=dispatch_message(event,handler)}
       if len(response)>0 {send_to(channel_id,response)}
      }
     } else if kind=="\"INTERACTION_CREATE\"" and keys.size()>0 {
      selector=interaction_selector(event)
      for i in range(keys.size()) {
       key=keys.get(i)
       if interaction_matches(key,selector) {
        policy=""
        if i<policies.size() {policy=policies.get(i)}
        deliver_interaction(event,key,handlers.get(i),policy)
        break
       }
      }
     }
     for i in range(events.size()) {
      name=events.get(i)
      if json.string_equals(kind,name) {
       deliver_gateway_event(event,name,callbacks.get(i))
       break
      }
     }
    }
   }
  }
  gw_host_stop()
  bot_slot_set(38,"")
  return 1
 }
 assert gw_open(),"Gateway TLS/WebSocket open failed"
 bot_slot_set(37,"");bot_slot_set(38,"")
 show "TRIPOL Discord Gateway connecting..."
 interval=0; sequence=-1; next_heartbeat=0; sent=0; awaiting=false; done=false
 started=time.now_ms(); ready=false
 while not done {
  scratch {
   // Wait on a local thread handle, not a REST request. Wakes on data arrival.
   event=gw_receive(100)
   if event=="!" {done=true;show "Gateway closed or receive failed."}
   else if len(event)>0 {
    op=errors.int_or(json.get_raw_large(event,"op"),-1)
    if op==10 and interval==0 {
     d=json.get_raw_large(event,"d")
     interval=errors.int_or(json.get_raw_large(d,"heartbeat_interval"),0)
     if interval<1000 or interval>300000 {gw_abort()}
     next_heartbeat=time.now_ms()+time.now_ns()%interval
     gw_send(identify_payload(intents))
    } else if op==0 {
     seq=errors.int_or(json.get_raw_large(event,"s"),-1)
     if seq>=0 {sequence=seq}
     kind=json.get_raw_large(event,"t")
     if kind=="\"READY\"" and not ready {
      ready=true;bot_slot_set(38,"ready")
      show "TRIPOL Discord Gateway READY - Ctrl+C to stop."
      greeting=bot_slot_get(36)
      if len(greeting)>0 {say(greeting)}
     } else if ready and kind=="\"MESSAGE_CREATE\"" {
      channel_id=event_channel(event)
      if len(channel_id)>0 {
       response=gateway_reply(event)
       if len(response)==0 and handler!=&ignore_message {response=dispatch_message(event,handler)}
       if len(response)>0 {send_to(channel_id,response)}
      }
     } else if ready and kind=="\"INTERACTION_CREATE\"" and keys.size()>0 {
      selector=interaction_selector(event)
      for i in range(keys.size()) {
       key=keys.get(i)
       if interaction_matches(key,selector) {
        policy=""
        if i<policies.size() {policy=policies.get(i)}
        deliver_interaction(event,key,handlers.get(i),policy)
        break
       }
      }
     }
     if ready {
      for i in range(events.size()) {
       name=events.get(i)
       if json.string_equals(kind,name) {
        deliver_gateway_event(event,name,callbacks.get(i))
        break
       }
      }
     }
    } else if op==11 {
     if awaiting {bot_slot_set(37,text(time.now_ms()-sent));awaiting=false}
    } else if op==1 {
     gw_send(heartbeat_payload(sequence));sent=time.now_ms();awaiting=true
    } else if op==7 or op==9 {
     done=true;show "Gateway requested reconnect or invalidated the session. Stopped safely."
    }
   }
   if not done {
    now=time.now_ms()
    if not ready and now-started>30000 {gw_abort()}
    if interval>0 and now>=next_heartbeat {
     if awaiting {gw_abort()}
     gw_send(heartbeat_payload(sequence));sent=now;awaiting=true
     next_heartbeat=now+interval
    }
   }
  }
 }
 gw_close();bot_slot_set(38,"")
 return 1
}

// SIMPLE API R2. Configuration belongs to the object. The native Gateway
// currently runs one session at a time, using its existing bounded storage.
struct Bot {
 prefix_text:string
 presence:string
 activity_text:string
 command_names:string_list
 responses:string_list
 message_handler:func(Message)->string
 handles_messages:bool
 interaction_keys:string_list
 interaction_handlers:list[func(Interaction)->string]
 slash_definitions:string_list
 slash_guilds:string_list
 __cooldowns_path:string=""
}

func bot()->Bot {
 return Bot("", "online", "", string_list(4), string_list(4), &ignore_message, false, string_list(), empty_interactions(), string_list(), string_list())
}

func Bot.prefix(self:Bot,value:string)->bool {
 assert len(value)<=32 and utf8.valid(value),"Discord prefix must be UTF-8, up to 32 bytes"
 self.prefix_text=value
 return true
}

func Bot.status(self:Bot,value:string)->bool {
 assert value=="online" or value=="idle" or value=="dnd" or value=="invisible","Invalid Discord status"
 self.presence=value
 return true
}

func Bot.activity(self:Bot,value:string)->bool {
 assert len(value)<=128 and utf8.valid(value),"Activity must be UTF-8, up to 128 bytes"
 self.activity_text=value
 return true
}

func Bot.command(self:Bot,name:string,response:string)->bool {
 assert len(name)>0 and len(name)<=96 and utf8.valid(name),"Discord command must be UTF-8, 1 to 96 bytes"
 assert len(response)>0 and len(response)<=512 and utf8.valid(response),"Discord response must be UTF-8, 1 to 512 bytes"
 names=self.command_names
 replies=self.responses
 assert names.size()==replies.size() and names.size()<=16,"Invalid Discord command table"
 for i in range(names.size()) {
  if names[i]==name {
   replies.set(i,response)
   return true
  }
 }
 assert names.size()<16,"Maximum 16 Discord commands"
 names.add(name)
 replies.add(response)
 return true
}

// Text lookup with no token or network. Prefix changes apply immediately.
func Bot.preview(self:Bot,content:string)->string {
 names=self.command_names
 replies=self.responses
 assert names.size()==replies.size() and names.size()<=16,"Invalid Discord command table"
 prefix=self.prefix_text
 if not has_prefix(content,prefix) {return ""}
 name=slice(content,len(prefix),len(content))
 for i in range(names.size()) {
  if names[i]==name {return replies[i]}
 }
 return ""
}

func Bot.on_message(self:Bot,handler:func(Message)->string)->bool {
 self.message_handler=handler
 self.handles_messages=true
 return true
}

func Bot.preview_event(self:Bot,event:string)->string {
 return dispatch_message(event,self.message_handler)
}

func Bot.start(self:Bot)->int {
 return self.start_with_events(events())
}

func Bot.start_with_events(self:Bot,registry:GatewayEvents)->int {
 names=self.command_names
 replies=self.responses
 assert names.size()==replies.size() and names.size()<=16,"Invalid Discord command table"
 reset()
 login_env()
 let prefix=self.prefix_text
 status(self.presence)
 activity(self.activity_text)
 for i in range(names.size()) {
  name=names[i]
  response=replies[i]
  scratch {reply(prefix+name,response)}
 }
 if self.__cooldowns_path!="" {
  assert gw_host_available(),"Persistent Discord cooldowns require tripol run or tripol discord-run"
  assert discord_rest(8,"load","",json.quote(self.__cooldowns_path))=="0","Could not open the Discord cooldown store"
 }
 policies=string_list()
 specs=self.slash_definitions
 hosted=gw_host_available()
 for i in range(specs.size()) {
  policy=self.__policy_at(specs.get(i))
  assert hosted or errors.int_or(json.get_raw_large(policy,"seconds"),0)==0,"Discord cooldowns require tripol run or tripol discord-run"
  policies.add(policy)
 }
 // Registering a text command explicitly requests guild message content.
 sync_slash_commands(self.slash_definitions,self.slash_guilds)
 intents=registry.intent_mask()
 if names.size()>0 or self.handles_messages {intents=bits.set(bits.set(intents,9),15)}
 return registry.__run(self.message_handler,intents,self.interaction_keys,self.interaction_handlers,policies)
}

struct GatewayEvent {
 name:string
 sequence:int
 guild_id:string
 channel_id:string
 user_id:string
 data_json:string
}

func GatewayEvent.field(self:GatewayEvent,name:string)->string {
 return json.get_raw_large(self.data_json,name)
}

func ignore_gateway_event(event:GatewayEvent)->bool {return false}

struct GatewayEvents {
 __names:string_list
 __handlers:list[func(GatewayEvent)->bool]
 __intents:int
}

func events()->GatewayEvents {
 handlers=list([&ignore_gateway_event])
 handlers.clear()
 return GatewayEvents(string_list(),handlers,1)
}

func gateway_intent(name:string)->int {
 if name=="" {return -1}
 if name=="members" {name="GUILD_MEMBERS"}
 else if name=="messages" {name="GUILD_MESSAGES"}
 else if name=="presences" {name="GUILD_PRESENCES"}
 name=gateway_event_name(name)
 names=list(["GUILDS","GUILD_MEMBERS","GUILD_MODERATION","GUILD_EXPRESSIONS","GUILD_INTEGRATIONS","GUILD_WEBHOOKS","GUILD_INVITES","GUILD_VOICE_STATES","GUILD_PRESENCES","GUILD_MESSAGES","GUILD_MESSAGE_REACTIONS","GUILD_MESSAGE_TYPING","DIRECT_MESSAGES","DIRECT_MESSAGE_REACTIONS","DIRECT_MESSAGE_TYPING","MESSAGE_CONTENT","GUILD_SCHEDULED_EVENTS","","","","AUTO_MODERATION_CONFIGURATION","AUTO_MODERATION_EXECUTION","","","GUILD_MESSAGE_POLLS","DIRECT_MESSAGE_POLLS"])
 for i in range(names.size()) {if names[i]==name {return i}}
 return -1
}

func GatewayEvents.intent(self:GatewayEvents,name:string)->bool {
 index=gateway_intent(name)
 assert index>=0,"Unknown Discord Gateway intent"
 self.__intents=bits.set(self.__intents,index)
 return true
}

func GatewayEvents.intent_mask(self:GatewayEvents)->int {return self.__intents}

func gateway_event_name(name:string)->string {
 if name=="member_join" {return "GUILD_MEMBER_ADD"}
 if name=="member_leave" {return "GUILD_MEMBER_REMOVE"}
 if name=="member_update" {return "GUILD_MEMBER_UPDATE"}
 result=""
 for i in range(len(name)) {
  ch=byte_at(name,i)
  if ch>=97 and ch<=122 {ch-=32}
  if not ((ch>=65 and ch<=90) or (ch>=48 and ch<=57) or ch==95) {return ""}
  result+=utf8_char(ch)
 }
 return result
}

func GatewayEvents.on(self:GatewayEvents,name:string,handler:func(GatewayEvent)->bool)->bool {
 name=gateway_event_name(name)
 assert name!="","Use an official Discord Gateway event name"
 assert name!="INTERACTION_CREATE","Register typed interactions on the bot"
 assert name!="VOICE_SERVER_UPDATE","Voice server credentials are reserved for the voice transport"
 if name=="GUILD_MEMBER_ADD" or name=="GUILD_MEMBER_REMOVE" or name=="GUILD_MEMBER_UPDATE" or name=="GUILD_MEMBERS_CHUNK" {
  assert bits.test(self.__intents,1),"Enable GUILD_MEMBERS before registering member callbacks"
 }
 if name=="PRESENCE_UPDATE" {assert bits.test(self.__intents,8),"Enable GUILD_PRESENCES before registering presence callbacks"}
 return self.__bind(name,handler)
}

func GatewayEvents.on_http(self:GatewayEvents,name:string,handler:func(GatewayEvent)->bool)->bool {
 assert slash_name(name),"Use a lowercase HTTP event name"
 return self.__bind("TRIPOL_HTTP:"+name,handler)
}

func GatewayEvents.on_http_delivery(self:GatewayEvents,name:string,handler:func(GatewayEvent)->bool)->bool {
 assert slash_name(name),"Use a lowercase HTTP event name"
 return self.__bind("TRIPOL_HTTP_DELIVERY:"+name,handler)
}

func GatewayEvents.__bind(self:GatewayEvents,name:string,handler:func(GatewayEvent)->bool)->bool {
 names=self.__names
 handlers=self.__handlers
 for i in range(names.size()) {
  if names[i]==name {
   handlers.set(i,handler)
   return true
  }
 }
 names.add(name)
 handlers.add(handler)
 return true
}

func deliver_gateway_event(event:string,name:string,handler:func(GatewayEvent)->bool)->bool {
 if name=="INTERACTION_CREATE" or name=="VOICE_SERVER_UPDATE" {return false}
 if json.get_raw_large(event,"op")!="0" or not json.string_equals(json.get_raw_large(event,"t"),name) {return false}
 data=json.get_raw_large(event,"d")
 if len(data)<2 or byte_at(data,0)!=123 {return false}
 sequence=errors.int_or(json.get_raw_large(event,"s"),-1)
 guild_id=event_id(json.get_raw_large(data,"guild_id"))
 if guild_id=="" and (name=="GUILD_CREATE" or name=="GUILD_DELETE" or name=="GUILD_UPDATE") {guild_id=event_id(json.get_raw_large(data,"id"))}
 channel_id=event_id(json.get_raw_large(data,"channel_id"))
 if channel_id=="" and (has_prefix(name,"CHANNEL_") or has_prefix(name,"THREAD_")) {channel_id=event_id(json.get_raw_large(data,"id"))}
 user_id=event_id(json.get_raw_large(data,"user_id"))
 if user_id=="" {user_id=event_id(json.get_raw_large(json.get_raw_large(data,"user"),"id"))}
 if user_id=="" {user_id=event_id(json.get_raw_large(json.get_raw_large(data,"author"),"id"))}
 return handler(GatewayEvent(name,sequence,guild_id,channel_id,user_id,data))
}

func GatewayEvents.preview(self:GatewayEvents,event:string)->bool {
 kind=json.get_raw_large(event,"t")
 names=self.__names
 handlers=self.__handlers
 for i in range(names.size()) {
  if json.string_equals(kind,names[i]) {return deliver_gateway_event(event,names[i],handlers[i])}
 }
 return false
}

// Traditional embeds use Discord's character limits.
struct Embed {
 title_text:string
 description_text:string
 footer_text:string
 color_value:int
 title_url:string
 image_url:string
 thumbnail_url:string
 footer_icon_url:string
 author_text:string
 author_url:string
 author_icon_url:string
 timestamp_text:string
 labels:string_list
 values:string_list
 inline_flags:bool_list
}

func embed()->Embed {
 return Embed("", "", "", -1, "", "", "", "", "", "", "", "", string_list(4), string_list(4), bool_list(4))
}

func Embed.title(self:Embed,value:string)->bool {
 assert utf8.count(value)<=256,"Embed title allows up to 256 characters"
 self.title_text=value
 return true
}

func Embed.description(self:Embed,value:string)->bool {
 assert utf8.count(value)<=4096,"Embed description allows up to 4096 characters"
 self.description_text=value
 return true
}

func Embed.footer(self:Embed,value:string,icon_url="")->bool {
 assert utf8.valid(value) and utf8.count(value)<=2048,"Embed footer allows up to 2048 characters"
 assert icon_url=="" or (value!="" and attachment_media_url(icon_url)),"Invalid Discord footer icon"
 self.footer_text=value
 self.footer_icon_url=icon_url
 return true
}

func rgb_color(value:string)->int {
 assert len(value)==7 and byte_at(value,0)==35,"Use #RRGGBB for a Discord color"
 packed=0
 for i in range(1,7) {
  b=byte_at(value,i)
  assert json.hex(b),"Use #RRGGBB for a Discord color"
  digit=0
  if b<=57 {digit=b-48} else if b<=70 {digit=b-55} else {digit=b-87}
  packed=packed*16+digit
 }
 return packed
}

func Embed.color(self:Embed,value:string)->bool {
 self.color_value=rgb_color(value)
 return true
}

func Embed.url(self:Embed,value:string)->bool {
 assert value=="" or media_url(value),"Invalid Discord embed URL"
 self.title_url=value
 return true
}

func Embed.image(self:Embed,value:string)->bool {
 assert value=="" or attachment_media_url(value),"Invalid Discord embed image URL"
 self.image_url=value
 return true
}

func Embed.thumbnail(self:Embed,value:string)->bool {
 assert value=="" or attachment_media_url(value),"Invalid Discord embed thumbnail URL"
 self.thumbnail_url=value
 return true
}

func Embed.field(self:Embed,label:string,value:string,inline=false)->bool {
 assert len(label)>0 and utf8.count(label)<=256,"Embed field name requires 1 to 256 characters"
 assert len(value)>0 and utf8.count(value)<=1024,"Embed field value requires 1 to 1024 characters"
 labels=self.labels
 values=self.values
 flags=self.inline_flags
 assert labels.size()==values.size() and labels.size()==flags.size() and labels.size()<25,"Maximum 25 embed fields"
 labels.add(label)
 values.add(value)
 flags.add(inline)
 return true
}

// Complete create-message JSON body with mentions disabled. The public send
// operation uses the same payload and the existing authenticated transport.
func Embed.text_size(self:Embed)->int {
 labels=self.labels
 values=self.values
 count=utf8.count(self.title_text)+utf8.count(self.description_text)+utf8.count(self.footer_text)+utf8.count(self.author_text)
 for i in range(labels.size()) {count+=utf8.count(labels[i])+utf8.count(values[i])}
 return count
}

func Embed.entry(self:Embed)->string {
 labels=self.labels
 values=self.values
 flags=self.inline_flags
 assert labels.size()==values.size() and labels.size()==flags.size() and labels.size()<=25,"Invalid embed fields"
 count=self.text_size()
 assert (count>0 or len(self.image_url)>0 or len(self.thumbnail_url)>0) and count<=6000,"Embed requires text or media and accepts at most 6000 characters"
 body="{"
 separator=""
 if len(self.title_text)>0 {
  body+="\"title\":"+json.quote(self.title_text)
  separator=","
 }
 if len(self.description_text)>0 {
  body+=separator+"\"description\":"+json.quote(self.description_text)
  separator=","
 }
 if len(self.footer_text)>0 {
  body+=separator+"\"footer\":{\"text\":"+json.quote(self.footer_text)
  if self.footer_icon_url!="" {body+=",\"icon_url\":"+json.quote(self.footer_icon_url)}
  body+="}"
  separator=","
 }
 if self.author_text!="" {
  body+=separator+"\"author\":{\"name\":"+json.quote(self.author_text)
  if self.author_url!="" {body+=",\"url\":"+json.quote(self.author_url)}
  if self.author_icon_url!="" {body+=",\"icon_url\":"+json.quote(self.author_icon_url)}
  body+="}"
  separator=","
 }
 if self.timestamp_text!="" {
  body+=separator+"\"timestamp\":"+json.quote(self.timestamp_text)
  separator=","
 }
 if self.color_value>=0 {
  body+=separator+"\"color\":"+text(self.color_value)
  separator=","
 }
 if len(self.title_url)>0 {
  body+=separator+"\"url\":"+json.quote(self.title_url)
  separator=","
 }
 if len(self.image_url)>0 {
  body+=separator+"\"image\":{\"url\":"+json.quote(self.image_url)+"}"
  separator=","
 }
 if len(self.thumbnail_url)>0 {
  body+=separator+"\"thumbnail\":{\"url\":"+json.quote(self.thumbnail_url)+"}"
  separator=","
 }
 if labels.size()>0 {
  body+=separator+"\"fields\":["
  for i in range(labels.size()) {
   if i>0 {body+=","}
   body+="{\"name\":"+json.quote(labels[i])+",\"value\":"+json.quote(values[i])+",\"inline\":"+json.boolean(flags[i])+"}"
  }
  body+="]"
 }
 return body+"}"
}

func Embed.payload(self:Embed)->string {
 return "{\"embeds\":["+self.entry()+"],\"allowed_mentions\":{\"parse\":[]}}"
}

func Embed.send(self:Embed,channel_id:string)->bool {
 body=self.payload()
 ok=false
 scratch {ok=len(discord_request(channel_path(channel_id),token(),body))>0}
 return ok
}

func Embed.send_files(self:Embed,channel_id:string,paths:string_list)->string {
 return send_attachments(channel_id,self.payload(),paths)
}

func attachment_name_valid(filename:string)->bool {
 if filename=="" or filename=="." or filename==".." {return false}
 for i in range(len(filename)) {
  b=byte_at(filename,i)
  if not ((b>=48 and b<=57) or (b>=65 and b<=90) or (b>=97 and b<=122) or b==45 or b==46 or b==95) {return false}
 }
 return true
}

func attachment_url(filename:string)->string {
 assert attachment_name_valid(filename),"Use an attachment filename with letters, digits, dots, underscores or hyphens"
 return "attachment://"+filename
}

func attachment_media_url(value:string)->bool {
 if has_prefix(value,"attachment://") {return attachment_name_valid(slice(value,13,len(value)))}
 return media_url(value)
}

func upload_envelope(payload:string,paths:string_list)->string {
 assert paths.size()>=1 and paths.size()<=10,"Discord messages accept one to ten uploaded files"
 prefix="{\"payload\":"
 middle=",\"files\":["
 assert len(payload)+len(prefix)+len(middle)+2<=65535,"Multipart metadata exceeds the TRIPOL string capacity"
 body=prefix+payload+middle
 for i in range(paths.size()) {
  assert paths[i]!="","Provide a path for each Discord attachment"
  path=json.quote(paths[i])
  assert len(body)+len(path)+3<=65535,"Multipart metadata exceeds the TRIPOL string capacity"
  if i>0 {body+=","}
  body+=path
 }
 return body+"]}"
}

func send_attachments(channel_id:string,payload:string,paths:string_list)->string {
 if not gw_host_available() {return ""}
 reply=discord_rest(6,channel_path(channel_id),token(),upload_envelope(payload,paths))
 return event_id(json.get_raw_large(reply,"id"))
}

// Validate the supported URL subset without issuing a network request.
func media_url(value:string)->bool {
 if len(value)>2048 or not utf8.valid(value) {return false}
 start=0
 if has_prefix(value,"https://") {start=8}
 else if has_prefix(value,"http://") {start=7}
 else {return false}
 if len(value)<=start {return false}
 first=byte_at(value,start)
 if first==47 or first==63 or first==35 or first==64 {return false}
 for i in range(start,len(value)) {
  b=byte_at(value,i)
  if b<=32 or b==92 or b==127 {return false}
 }
 return true
}

struct Components {
 entries:string_list
 total:int
 containers:bool
 custom_ids:string_list
 text_chars:int
 __root_accent:int=-1
}

func components()->Components {
 return Components(string_list(4),0,false,string_list(4),0)
}

func container(color="#FFFFFF")->Components {
 panel=components()
 panel.__root_accent=rgb_color(color)
 return panel
}

// Keep the total limit inclusive of nested children and accessories.
func Components.append_entry(self:Components,entry:string,weight:int)->bool {
 limit=40
 if self.__root_accent>=0 {limit=39}
 assert weight>=1 and weight<=limit and self.total>=0 and self.total+weight<=limit,"Maximum 40 Discord message components including the container"
 list=self.entries
 list.add(entry)
 self.total+=weight
 return true
}

func Components.entries_json(self:Components)->string {
 list=self.entries
 assert self.total>0 and self.total<=40 and list.size()>0 and list.size()<=self.total,"Invalid Discord component count"
 body="["
 for i in range(list.size()) {
  if i>0 {body+=","}
  assert len(body)+len(list[i])+1<=65535,"Discord component payload exceeds the TRIPOL string capacity"
  body+=list[i]
 }
 return body+"]"
}

func Components.append_text(self:Components,entry:string,weight:int,characters:int)->bool {
 assert characters>=0 and self.text_chars+characters<=4000,"Discord Text Display content may total up to 4000 characters"
 self.append_entry(entry,weight)
 self.text_chars+=characters
 return true
}

func Components.text(self:Components,content:string)->bool {
 assert len(content)>0,"Text Display requires nonempty UTF-8"
 return self.append_text("{\"type\":10,\"content\":"+json.quote(content)+"}",1,utf8.count(content))
}

func Components.separator(self:Components,spacing=1,divider=true)->bool {
 assert spacing==1 or spacing==2,"Discord separator spacing must be 1 or 2"
 return self.append_entry("{\"type\":14,\"divider\":"+json.boolean(divider)+",\"spacing\":"+text(spacing)+"}",1)
}

func Components.link(self:Components,label:string,url:string,emoji="",disabled=false)->bool {
 buttons=button_row()
 buttons.link(label,url,disabled,emoji)
 return self.row(buttons)
}

func Components.premium(self:Components,sku_id:string,disabled=false)->bool {
 buttons=button_row()
 buttons.premium(sku_id,disabled)
 return self.row(buttons)
}

func Components.button(self:Components,label:string,custom_id:string,style=1,emoji="",disabled=false)->bool {
 buttons=button_row()
 buttons.button(label,custom_id,style,disabled,emoji)
 return self.row(buttons)
}

func Components.button(self:Components,label:string,custom_id:string,style:string,emoji="",disabled=false)->bool {
 return self.button(label,custom_id,button_style(style),emoji,disabled)
}

func Components.section(self:Components,content:string,thumbnail_url:string,description="")->bool {
 assert len(content)>0 and utf8.valid(content),"Discord section requires nonempty UTF-8"
 assert attachment_media_url(thumbnail_url),"Invalid Discord thumbnail URL"
 assert utf8.valid(description) and utf8.count(description)<=1024,"Discord thumbnail descriptions allow up to 1024 characters"
 thumb="{\"type\":11,\"media\":{\"url\":"+json.quote(thumbnail_url)+"}"
 if len(description)>0 {thumb+=",\"description\":"+json.quote(description)}
 body="{\"type\":9,\"components\":[{\"type\":10,\"content\":"+json.quote(content)+"}],\"accessory\":"+thumb+"}}"
 return self.append_text(body,3,utf8.count(content))
}

func Components.gallery(self:Components,urls:string_list)->bool {
 assert urls.size()>=1 and urls.size()<=10,"Discord gallery requires 1 to 10 items"
 body="{\"type\":12,\"items\":["
 for i in range(urls.size()) {
  assert attachment_media_url(urls[i]),"Invalid Discord gallery URL"
  if i>0 {body+=","}
  body+="{\"media\":{\"url\":"+json.quote(urls[i])+"}}"
 }
 return self.append_entry(body+"]}",1)
}

func Components.container(self:Components,children:Components,accent=-1,spoiler=false)->bool {
 assert not children.containers and children.__root_accent<0 and self.__root_accent<0,"Discord containers cannot contain containers"
 assert accent>=-1 and accent<=16777215,"Invalid Discord container RGB color"
 assert children.total>=1 and children.total<40 and self.total+children.total+1<=40,"Maximum 40 Discord message components"
 ids=self.custom_ids
 child_ids=children.custom_ids
 for i in range(child_ids.size()) {assert not ids.contains(child_ids[i]),"Duplicate Discord component ID"}
 body="{\"type\":17,\"components\":"+children.entries_json()+",\"spoiler\":"+json.boolean(spoiler)
 if accent>=0 {body+=",\"accent_color\":"+text(accent)}
 self.append_text(body+"}",children.total+1,children.text_chars)
 for i in range(child_ids.size()) {ids.add(child_ids[i])}
 self.containers=true
 return true
}

func Components.payload(self:Components)->string {
 body=self.entries_json()
 prefix="{\"flags\":32768,\"components\":"
 suffix=",\"allowed_mentions\":{\"parse\":[]}}"
 if self.__root_accent>=0 {
  wrapper="[{\"type\":17,\"accent_color\":"+text(self.__root_accent)+",\"components\":"
  assert len(prefix)+len(wrapper)+len(body)+len(suffix)+2<=65535,"Discord component payload exceeds the TRIPOL string capacity"
  return prefix+wrapper+body+"}]"+suffix
 }
 assert len(prefix)+len(body)+len(suffix)<=65535,"Discord component payload exceeds the TRIPOL string capacity"
 return prefix+body+suffix
}

func Components.send(self:Components,channel_id:string)->bool {
 body=self.payload()
 result=false
 scratch {result=len(discord_request(channel_path(channel_id),token(),body))>0}
 return result
}

func Components.file(self:Components,filename:string,spoiler=false)->bool {
 body="{\"type\":13,\"file\":{\"url\":"+json.quote(attachment_url(filename))+"},\"spoiler\":"+json.boolean(spoiler)+"}"
 return self.append_entry(body,1)
}

func Components.send_files(self:Components,channel_id:string,paths:string_list)->string {
 return send_attachments(channel_id,self.payload(),paths)
}

// Typed events keep the Discord event body and submitted data available.
struct Interaction {
 kind:int
 name:string
 id:string
 application_id:string
 guild_id:string
 channel_id:string
 user_id:string
 data_json:string
 has_message:bool
 // Internal credentials are populated only by live dispatch.
 __interaction_token:string=""
 __response_state:int=0
 __member_permissions:string=""
 __member_roles:string=""
 __app_permissions:string=""
 __cooldown_request:string=""
}

func interaction_message(content:string,ephemeral=false)->string {
 assert len(content)>0 and utf8.valid(content) and utf8.count(content)<=2000,"Discord replies require 1 to 2000 characters"
 flags=""
 if ephemeral {flags=",\"flags\":64"}
 return "{\"content\":"+json.quote(content)+flags+",\"allowed_mentions\":{\"parse\":[]}}"
}

func Interaction.reply(self:Interaction,content:string,ephemeral=false)->string {
 return "{\"type\":4,\"data\":"+interaction_message(content,ephemeral)+"}"
}

func Interaction.reply(self:Interaction,embed:Embed,ephemeral=false)->string {
 batch=embeds()
 batch.add(embed)
 return self.reply_embeds(batch,ephemeral)
}

func Interaction.reply(self:Interaction,batch:Embeds,ephemeral=false)->string {
 return self.reply_embeds(batch,ephemeral)
}

func Interaction.reply(self:Interaction,layout:Components,ephemeral=false)->string {
 return self.reply_components(layout,ephemeral)
}

// Immediately acknowledge an interaction and stream local attachments.
func Interaction.reply_files(self:Interaction,content:string,paths:string_list,ephemeral=false)->bool {
 return self.__respond_files(self.reply(content,ephemeral),paths)
}

func Interaction.reply_files(self:Interaction,embed:Embed,paths:string_list,ephemeral=false)->bool {
 return self.__respond_files(self.reply(embed,ephemeral),paths)
}

func Interaction.reply_files(self:Interaction,batch:Embeds,paths:string_list,ephemeral=false)->bool {
 return self.__respond_files(self.reply(batch,ephemeral),paths)
}

func Interaction.reply_files(self:Interaction,layout:Components,paths:string_list,ephemeral=false)->bool {
 return self.__respond_files(self.reply(layout,ephemeral),paths)
}

func Interaction.__respond_files(self:Interaction,body:string,paths:string_list)->bool {
 if self.__interaction_token=="" or self.id=="" or self.kind==4 or self.__response_state!=0 {return false}
 if not gw_host_available() {return false}
 path="/api/v10/interactions/"+self.id+"/"+self.__interaction_token+"/callback"
 envelope=upload_envelope(body,paths)
 self.__response_state=1
 ok=false
 scratch {ok=len(discord_rest(7,path,"",envelope))>0}
 if ok {self.__response_state=2}
 return ok
}

func Interaction.defer_http(self:Interaction,request:http.Request,event:string,ephemeral=true)->bool {
 return self.defer_http_task(request,event,ephemeral)>0
}

func Interaction.defer_http_task(self:Interaction,request:http.Request,event:string,ephemeral=true)->int {
 return self.__defer_http(request,event,ephemeral,false)
}

func Interaction.defer_http_update(self:Interaction,request:http.Request,event:string)->int {
 if not self.has_message or (self.kind!=3 and self.kind!=5) {return 0}
 return self.__defer_http(request,event,false,true)
}

func Interaction.__defer_http(self:Interaction,request:http.Request,event:string,ephemeral:bool,update:bool)->int {
 assert slash_name(event),"Use a registered lowercase HTTP event name"
 if not gw_host_available() or self.application_id=="" or self.kind!=2 and self.kind!=3 and self.kind!=5 {return 0}
 acknowledgement=self.defer(ephemeral)
 if update {acknowledgement=self.ack()}
 if not self.respond(acknowledgement) {return 0}
 task=request.start()
 if task.id()<=0 {self.edit_reply("No se pudo iniciar la petición HTTP.");return 0}
 path="/api/v10/webhooks/"+self.application_id+"/"+self.__interaction_token+"/messages/@original"
 body="{\"id\":"+text(task.id())+",\"name\":"+json.quote(event)+",\"path\":"+json.quote(path)+"}"
 if http_exchange("route",body)=="1" {return task.id()}
 http_exchange("abandon",text(task.id()))
 self.edit_reply("No se pudo registrar la respuesta HTTP.")
 return 0
}

func cancel_http(receipt:int)->bool {
 return receipt>0 and gw_host_available() and http_exchange("cancelcb",text(receipt))=="1"
}

func GatewayEvent.http_response(self:GatewayEvent)->http.Response {
 if not has_prefix(self.name,"TRIPOL_HTTP:") {return http.parse_response("{\"status\":0,\"error\":\"not_http_event\"}")}
 return http.parse_response(json.get_raw_large(self.data_json,"result"))
}

func GatewayEvent.http_receipt(self:GatewayEvent)->int {
 if not has_prefix(self.name,"TRIPOL_HTTP:") and not has_prefix(self.name,"TRIPOL_HTTP_DELIVERY:") {return 0}
 return errors.int_or(json.get_raw_large(self.data_json,"receipt"),0)
}

func GatewayEvent.__complete_http(self:GatewayEvent,body:string,action="complete")->bool {
 if not gw_host_available() or not has_prefix(self.name,"TRIPOL_HTTP:") {return false}
 receipt=self.http_receipt()
 if receipt<=0 {return false}
 return http_exchange(action,"{\"id\":"+text(receipt)+",\"body\":"+body+"}")=="1"
}

func GatewayEvent.complete_http(self:GatewayEvent,message:string)->bool {
 return self.__complete_http(interaction_message(message))
}

func GatewayEvent.complete_http(self:GatewayEvent,embed:Embed)->bool {
 return self.__complete_http(embed.payload())
}

func GatewayEvent.complete_http(self:GatewayEvent,batch:Embeds)->bool {
 return self.__complete_http(batch.payload())
}

func GatewayEvent.complete_http(self:GatewayEvent,layout:Components)->bool {
 return self.__complete_http(layout.payload())
}

func GatewayEvent.queue_http(self:GatewayEvent,message:string)->bool {
 return self.__complete_http(interaction_message(message),"queue")
}

func GatewayEvent.queue_http(self:GatewayEvent,embed:Embed)->bool {
 return self.__complete_http(embed.payload(),"queue")
}

func GatewayEvent.queue_http(self:GatewayEvent,layout:Components)->bool {
 return self.__complete_http(layout.payload(),"queue")
}

func GatewayEvent.http_delivered(self:GatewayEvent)->bool {
 return has_prefix(self.name,"TRIPOL_HTTP_DELIVERY:") and json.get_raw_large(self.data_json,"ok")=="true"
}

func Interaction.defer(self:Interaction,ephemeral=false)->string {
 if ephemeral {return "{\"type\":5,\"data\":{\"flags\":64}}"}
 return "{\"type\":5}"
}

func Interaction.ack(self:Interaction)->string {
 assert self.has_message and (self.kind==3 or self.kind==5),"Discord message update requires a message interaction"
 return "{\"type\":6}"
}

func Interaction.reply_components(self:Interaction,layout:Components,ephemeral=false)->string {
 body=layout.payload()
 if ephemeral {
  // Keep both flags in the single flags field.
  prefix="{\"flags\":32768"
  assert has_prefix(body,prefix),"Invalid Components V2 payload"
  body="{\"flags\":32832"+slice(body,len(prefix),len(body))
 }
 assert len(body)+18<=65535,"Discord callback exceeds the TRIPOL string capacity"
 return "{\"type\":4,\"data\":"+body+"}"
}

func Interaction.update_components(self:Interaction,layout:Components)->string {
 assert self.has_message and (self.kind==3 or self.kind==5),"Discord message update requires a message interaction"
 body=layout.payload()
 assert len(body)+18<=65535,"Discord callback exceeds the TRIPOL string capacity"
 return "{\"type\":7,\"data\":"+body+"}"
}

func interaction_option(data:string,name:string,focused=false)->string {
 options=json.get_raw_large(data,"options")
 // Read values from the protocol without lossy conversion of numbers or IDs.
 while len(options)>2 and byte_at(options,0)==91 {
  n=len(options)
  at=json.ws(options,1,n)
  next=""
  while at<n and byte_at(options,at)==123 {
   end=json.value(options,at,n,0)
   if end<0 {return ""}
   item=slice(options,at,end)
   if focused {
    if json.get_raw_large(item,"focused")=="true" {return item}
   } else if json.string_equals(json.get_raw_large(item,"name"),name) {
    return item
   }
   nested=json.get_raw_large(item,"options")
   if len(nested)>2 {next=nested}
   at=json.ws(options,end,n)
   if at>=n or byte_at(options,at)!=44 {break}
   at=json.ws(options,at+1,n)
  }
  options=next
 }
 return ""
}

func Interaction.option(self:Interaction,name:string)->string {
 return json.get_raw_large(interaction_option(self.data_json,name),"value")
}

func first_command_option(data:string)->string {
 options=json.get_raw_large(data,"options")
 n=len(options)
 if n<3 or byte_at(options,0)!=91 {return ""}
 start=json.ws(options,1,n)
 if start>=n or byte_at(options,start)!=123 {return ""}
 end=json.value(options,start,n,0)
 if end<0 {return ""}
 return slice(options,start,end)
}

func Interaction.command_group(self:Interaction)->string {
 item=first_command_option(self.data_json)
 if json.get_raw_large(item,"type")!="2" {return ""}
 return json.unquote(json.get_raw_large(item,"name"))
}

func Interaction.subcommand(self:Interaction)->string {
 item=first_command_option(self.data_json)
 if json.get_raw_large(item,"type")=="2" {item=first_command_option(item)}
 if json.get_raw_large(item,"type")!="1" {return ""}
 return json.unquote(json.get_raw_large(item,"name"))
}

func Interaction.focused(self:Interaction)->string {
 return json.unquote(json.get_raw_large(interaction_option(self.data_json,"",true),"name"))
}

func ignore_interaction(context:Interaction)->string {return ""}

func empty_interactions()->list[func(Interaction)->string] {
 handlers=list([&ignore_interaction])
 handlers.clear()
 return handlers
}

// The prefix selects a protocol kind. The suffix retains Discord's JSON spelling
// so escaped identifiers can be matched without decoding arbitrary input.
func interaction_selector(event:string)->string {
 if json.get_raw_large(event,"op")!="0" or json.get_raw_large(event,"t")!="\"INTERACTION_CREATE\"" {return ""}
 payload=json.get_raw_large(event,"d")
 kind=json.get_raw_large(payload,"type")
 data=json.get_raw_large(payload,"data")
 if kind=="2" {
  command_type=json.get_raw_large(data,"type")
  route=""
  if command_type=="1" {route="s"}
  if command_type=="2" {route="u"}
  if command_type=="3" {route="p"}
  if route!="" {
   scope=event_id(json.get_raw_large(data,"guild_id"))
   return route+json.get_raw_large(data,"name")+"/"+scope
  }
 }
 if kind=="4" {
  scope=event_id(json.get_raw_large(data,"guild_id"))
  return "a"+json.get_raw_large(data,"name")+"/"+scope
 }
 if kind=="3" {
  component=json.get_raw_large(data,"component_type")
  id=json.get_raw_large(data,"custom_id")
  if component=="2" {return "b"+id}
  if component=="3" or component=="5" or component=="6" or component=="7" or component=="8" {return "c"+id}
 }
 if kind=="5" {return "m"+json.get_raw_large(data,"custom_id")}
 return ""
}

// Generated command routes end in /guild. The registration name may itself
// contain slash characters in a context menu.
func interaction_key_end(key:string)->int {
 end=len(key)
 if end==0 {return 0}
 kind=byte_at(key,0)
 if kind!=115 and kind!=97 and kind!=117 and kind!=112 {return end}
 at=end-1
 while at>0 {
  if byte_at(key,at)==47 {return at}
  at-=1
 }
 return end
}

func interaction_matches(key:string,selector:string)->bool {
 if len(key)<2 or len(selector)<3 or byte_at(key,0)!=byte_at(selector,0) {return false}
 key_end=interaction_key_end(key)
 selector_end=interaction_key_end(selector)
 key_scope=""
 selector_scope=""
 if key_end<len(key) {key_scope=slice(key,key_end+1,len(key))}
 if selector_end<len(selector) {selector_scope=slice(selector,selector_end+1,len(selector))}
 if key_scope!=selector_scope {return false}
 return json.string_equals(slice(selector,1,selector_end),slice(key,1,key_end))
}

func interaction_context(payload:string,key:string)->Interaction {
 assert len(key)>=2,"Invalid Discord interaction key"
 data=json.get_raw_large(payload,"data")
 kind=errors.int_or(json.get_raw_large(payload,"type"),0)
 member=json.get_raw_large(payload,"member")
 author=json.get_raw_large(payload,"user")
 if len(author)==0 {author=json.get_raw_large(member,"user")}
 name=slice(key,1,interaction_key_end(key))
 id=event_id(json.get_raw_large(payload,"id"))
 app=event_id(json.get_raw_large(payload,"application_id"))
 guild=event_id(json.get_raw_large(payload,"guild_id"))
 channel_id=event_id(json.get_raw_large(payload,"channel_id"))
 if channel_id=="" {channel_id=event_id(json.get_raw_large(json.get_raw_large(payload,"channel"),"id"))}
 user=event_id(json.get_raw_large(author,"id"))
 has_message=len(json.get_raw_large(payload,"message"))>0
 ctx=Interaction(kind,name,id,app,guild,channel_id,user,data,has_message)
 ctx.__member_permissions=json.unquote(json.get_raw_large(member,"permissions"))
 ctx.__member_roles=json.get_raw_large(member,"roles")
 ctx.__app_permissions=json.unquote(json.get_raw_large(payload,"app_permissions"))
 return ctx
}

func dispatch_interaction(event:string,key:string,handler:func(Interaction)->string)->string {
 if not interaction_matches(key,interaction_selector(event)) {return ""}
 return handler(interaction_context(json.get_raw_large(event,"d"),key))
}

func Interaction.__invoke(self:Interaction,handler:func(Interaction)->string)->string {
 return handler(self)
}

func deliver_interaction(event:string,key:string,handler:func(Interaction)->string,policy="")->bool {
 if not interaction_matches(key,interaction_selector(event)) {return false}
 payload=json.get_raw_large(event,"d")
 raw=json.get_raw_large(payload,"token")
 if len(raw)<3 or len(raw)>514 or byte_at(raw,0)!=34 or byte_at(raw,len(raw)-1)!=34 {return false}
 for i in range(1,len(raw)-1) {
  b=byte_at(raw,i)
  if not ((b>=48 and b<=57) or (b>=65 and b<=90) or (b>=97 and b<=122) or b==45 or b==46 or b==95) {return false}
 }
 secret=slice(raw,1,len(raw)-1)
 if secret=="." or secret==".." {return false}
 context=interaction_context(payload,key)
 if context.id=="" {return false}
 context.__interaction_token=secret
 if policy!="" {
  denied=context.__apply_policy(key,policy)
  if denied!="" {return context.respond(denied)}
 }
 body=handler(context)
 // A failed attempt can still be ambiguous. Never replay it automatically.
 if context.__response_state!=0 {return context.__response_state==2}
 if len(body)==0 {return false}
 return context.respond(body)
}

func slash_name(name:string)->bool {
 if len(name)==0 or len(name)>32 {return false}
 for i in range(len(name)) {
  b=byte_at(name,i)
  if not ((b>=97 and b<=122) or (b>=48 and b<=57) or b==45 or b==95) {return false}
 }
 return true
}

func Bot.bind_interaction(self:Bot,key:string,handler:func(Interaction)->string,definition="",guild_id="")->bool {
 if len(key)>1 and (byte_at(key,0)==115 or byte_at(key,0)==97) and find_bytes(key,"/")<0 {key+="/"+guild_id}
 keys=self.interaction_keys
 handlers=self.interaction_handlers
 specs=self.slash_definitions
 guilds=self.slash_guilds
 assert keys.size()==handlers.size() and keys.size()==specs.size() and keys.size()==guilds.size(),"Invalid Discord interaction registry"
 for i in range(keys.size()) {
  if keys[i]==key {
   handlers.set(i,handler)
   policy=self.__policy_at(specs.get(i))
   permission=json.unquote(json.get_raw_large(policy,"permission"))
   if permission!="" and definition!="" {definition=self.__with_default_permission(definition,permission)}
   if policy!="" and definition!="" {definition=self.__with_policy(definition,policy)}
   specs.set(i,definition)
   guilds.set(i,guild_id)
   return true
  }
 }
 keys.add(key)
 handlers.add(handler)
 specs.add(definition)
 guilds.add(guild_id)
 return true
}

func permissions_bitset_valid(value:string)->bool {
 if value=="" or (value!="0" and byte_at(value,0)==48) {return false}
 for i in range(len(value)) {if not json.digit(byte_at(value,i)) {return false}}
 return true
}

func permission_index(name:string)->int {
 lowered=""
 for i in range(len(name)) {
  b=byte_at(name,i)
  if b>=65 and b<=90 {b+=32}
  lowered+=utf8_char(b)
 }
 if lowered=="create_instant_invite" {return 0}
 if lowered=="kick_members" {return 1}
 if lowered=="ban_members" {return 2}
 if lowered=="administrator" {return 3}
 if lowered=="manage_channels" {return 4}
 if lowered=="manage_guild" {return 5}
 if lowered=="add_reactions" {return 6}
 if lowered=="view_audit_log" {return 7}
 if lowered=="priority_speaker" {return 8}
 if lowered=="stream" {return 9}
 if lowered=="view_channel" {return 10}
 if lowered=="send_messages" {return 11}
 if lowered=="send_tts_messages" {return 12}
 if lowered=="manage_messages" {return 13}
 if lowered=="embed_links" {return 14}
 if lowered=="attach_files" {return 15}
 if lowered=="read_message_history" {return 16}
 if lowered=="mention_everyone" {return 17}
 if lowered=="use_external_emojis" {return 18}
 if lowered=="view_guild_insights" {return 19}
 if lowered=="connect" {return 20}
 if lowered=="speak" {return 21}
 if lowered=="mute_members" {return 22}
 if lowered=="deafen_members" {return 23}
 if lowered=="move_members" {return 24}
 if lowered=="use_vad" {return 25}
 if lowered=="change_nickname" {return 26}
 if lowered=="manage_nicknames" {return 27}
 if lowered=="manage_roles" {return 28}
 if lowered=="manage_webhooks" {return 29}
 if lowered=="manage_guild_expressions" {return 30}
 if lowered=="use_application_commands" {return 31}
 if lowered=="request_to_speak" {return 32}
 if lowered=="manage_events" {return 33}
 if lowered=="manage_threads" {return 34}
 if lowered=="create_public_threads" {return 35}
 if lowered=="create_private_threads" {return 36}
 if lowered=="use_external_stickers" {return 37}
 if lowered=="send_messages_in_threads" {return 38}
 if lowered=="use_embedded_activities" {return 39}
 if lowered=="moderate_members" {return 40}
 if lowered=="view_creator_monetization_analytics" {return 41}
 if lowered=="use_soundboard" {return 42}
 if lowered=="create_guild_expressions" {return 43}
 if lowered=="create_events" {return 44}
 if lowered=="use_external_sounds" {return 45}
 if lowered=="send_voice_messages" {return 46}
 if lowered=="set_voice_channel_status" {return 48}
 if lowered=="send_polls" {return 49}
 if lowered=="use_external_apps" {return 50}
 if lowered=="pin_messages" {return 51}
 if lowered=="bypass_slowmode" {return 52}
 return -1
}

func Interaction.can(self:Interaction,permission:string)->bool {
 return self.__has_permission(self.__member_permissions,permission)
}

func Interaction.bot_can(self:Interaction,permission:string)->bool {
 return self.__has_permission(self.__app_permissions,permission)
}

func Interaction.__has_permission(self:Interaction,raw:string,permission:string)->bool {
 index=permission_index(permission)
 if self.guild_id=="" or index<0 or not permissions_bitset_valid(raw) {return false}
 // Discord's bitfields are decimal strings. Long division is unnecessary:
 // each step can keep just the low 53 bits used by these named permissions.
 mask=9007199254740992
 value=0
 for i in range(len(raw)) {
  value=(value*10+byte_at(raw,i)-48)%mask
 }
 return bits.test(value,3) or bits.test(value,index)
}

func command_permission_payload(default_permissions:string)->string {
 if default_permissions=="" {return ""}
 if default_permissions=="everyone" {return ",\"default_member_permissions\":null"}
 index=permission_index(default_permissions)
 if index>=0 {return ",\"default_member_permissions\":"+json.quote(text(bits.mask(index)))}
 assert permissions_bitset_valid(default_permissions),"Use a Discord permission name, a canonical decimal bitset or everyone"
 return ",\"default_member_permissions\":"+json.quote(default_permissions)
}

func Bot.__slash_index(self:Bot,name:string,guild_id:string)->int {
 assert slash_name(name),"Use the name of a registered slash command"
 keys=self.interaction_keys
 target="s"+name+"/"+guild_id
 for i in range(keys.size()) {
  if keys.get(i)==target {return i}
 }
 assert false,"Register this slash command before configuring permissions or cooldown"
 return -1
}

func Bot.__policy_at(self:Bot,spec:string)->string {
 return json.get_raw_large(spec,"__tripol_policy")
}

func Bot.__with_policy(self:Bot,spec:string,policy:string)->string {
 at=find_bytes(spec,",\"__tripol_policy\":")
 if at<0 {at=len(spec)-1}
 return slice(spec,0,at)+",\"__tripol_policy\":"+policy+"}"
}

func Bot.__policy(self:Bot,i:int,permission:string,target:string,seconds:int,scope:string,message:string,filters:string)->bool {
 specs=self.slash_definitions
 if filters=="" {filters="{}"}
 policy="{\"permission\":"+json.quote(permission)+",\"target\":"+json.quote(target)+",\"seconds\":"+text(seconds)+",\"scope\":"+json.quote(scope)+",\"message\":"+json.quote(message)+",\"filters\":"+filters+"}"
 specs.set(i,self.__with_policy(specs.get(i),policy))
 return true
}

func Bot.__with_default_permission(self:Bot,definition:string,permission:string)->string {
 policy=find_bytes(definition,",\"__tripol_policy\":")
 if policy>=0 {definition=slice(definition,0,policy)+"}"}
 at=find_bytes(definition,",\"default_member_permissions\":")
 if at<0 {at=len(definition)-1}
 return slice(definition,0,at)+command_permission_payload(permission)+"}"
}

func Bot.__user_option(self:Bot,definition:string)->string {
 items=json.get_raw_large(definition,"options")
 n=len(items)
 at=json.ws(items,1,n)
 name=""
 while at<n and byte_at(items,at)==123 {
  end=json.value(items,at,n,0)
  if end<0 {return ""}
  item=slice(items,at,end)
  if json.get_raw_large(item,"type")=="6" {
   assert name=="","Specify the target option for this command's hierarchy check"
   name=json.unquote(json.get_raw_large(item,"name"))
  }
  at=json.ws(items,end,n)
  if at>=n or byte_at(items,at)!=44 {return name}
  at=json.ws(items,at+1,n)
 }
 return name
}

func Bot.permission(self:Bot,name:string,permission:string,target_option="",guild_id="")->bool {
 assert permission_index(permission)>=0,"Use a Discord permission name, such as BAN_MEMBERS"
 assert target_option=="" or slash_name(target_option),"Use the name of a user option for the hierarchy check"
 index=permission_index(permission)
 assert target_option=="" or index==1 or index==2 or index==28 or index==40,"Hierarchy checks support kick, ban, role management and timeout"
 i=self.__slash_index(name,guild_id)
 specs=self.slash_definitions
 definition=specs.get(i)
 if target_option=="" and (index==1 or index==2 or index==40) {target_option=self.__user_option(definition)}
 old=self.__policy_at(definition)
 specs.set(i,self.__with_default_permission(definition,permission))
 return self.__policy(i,permission,target_option,errors.int_or(json.get_raw_large(old,"seconds"),0),json.unquote(json.get_raw_large(old,"scope")),json.unquote(json.get_raw_large(old,"message")),json.get_raw_large(old,"filters"))
}

func Bot.cooldown(self:Bot,name:string,seconds:int,scope="user",message="",guild_id="")->bool {
 assert seconds>=0 and seconds<=31536000,"Discord cooldown must be 0 to 31536000 seconds"
 assert scope=="user" or scope=="channel" or scope=="guild" or scope=="global","Choose user, channel, guild or global for the Discord cooldown"
 assert utf8.valid(message) and utf8.count(message)<=1960,"Discord cooldown message must fit in 1960 characters"
 i=self.__slash_index(name,guild_id)
 specs=self.slash_definitions
 old=self.__policy_at(specs.get(i))
 return self.__policy(i,json.unquote(json.get_raw_large(old,"permission")),json.unquote(json.get_raw_large(old,"target")),seconds,scope,message,json.get_raw_large(old,"filters"))
}

func Bot.restrict(self:Bot,name:string,scope:string,id:string,guild_id="")->bool {
 assert scope=="user" or scope=="channel" or scope=="guild" or scope=="role","Choose user, channel, guild or role for the slash restriction"
 assert id!="" and id!="0" and event_id(json.quote(id))==id,"Provide a valid Discord ID for the slash restriction"
 i=self.__slash_index(name,guild_id)
 specs=self.slash_definitions
 old=self.__policy_at(specs.get(i))
 filters=json.get_raw_large(old,"filters")
 scopes=list(["user","channel","guild","role"])
 updated="{"
 for j in range(scopes.size()) {
  key=scopes.get(j)
  raw=json.get_raw_large(filters,key)
  if raw=="" {raw="[]"}
  if key==scope {
   values=interaction_values(raw)
   if not values.contains(id) {
    values_json=slice(raw,0,len(raw)-1)
    if values.size()>0 {values_json+=","}
    raw=values_json+json.quote(id)+"]"
   }
  }
  if j>0 {updated+=","}
  updated+=json.quote(key)+":"+raw
 }
 return self.__policy(i,json.unquote(json.get_raw_large(old,"permission")),json.unquote(json.get_raw_large(old,"target")),errors.int_or(json.get_raw_large(old,"seconds"),0),json.unquote(json.get_raw_large(old,"scope")),json.unquote(json.get_raw_large(old,"message")),updated+"}")
}

func Interaction.has_role(self:Interaction,id:string)->bool {
 if id=="" or self.guild_id=="" {return false}
 if id==self.guild_id and self.__member_roles!="" {return true}
 roles=interaction_values(self.__member_roles)
 return roles.contains(id)
}

func Interaction.__allows(self:Interaction,filters:string)->bool {
 if filters=="" or filters=="{}" {return true}
 for i in range(3) {
  key="user";value=self.user_id
  if i==1 {key="channel";value=self.channel_id}
  if i==2 {key="guild";value=self.guild_id}
  group=interaction_values(json.get_raw_large(filters,key))
  if group.size()>0 and not group.contains(value) {return false}
 }
 roles=interaction_values(json.get_raw_large(filters,"role"))
 if roles.size()==0 {return true}
 for i in range(roles.size()) {
  if self.has_role(roles.get(i)) {return true}
 }
 return false
}

func Bot.persist_cooldowns(self:Bot,path:string)->bool {
 assert len(path)<=4096 and utf8.valid(path),"Provide a local cooldown store path"
 self.__cooldowns_path=path
 return true
}

func Interaction.__apply_policy(self:Interaction,key:string,policy:string)->string {
 if not self.__allows(json.get_raw_large(policy,"filters")) {return self.reply("Este comando está restringido para este usuario, rol o canal.",true)}
 permission=json.unquote(json.get_raw_large(policy,"permission"))
 if permission!="" and not self.can(permission) {return self.reply("Te falta el permiso efectivo requerido.",true)}
 if permission!="" and not self.bot_can(permission) {return self.reply("El bot necesita el permiso requerido en este canal.",true)}
 target=json.unquote(json.get_raw_large(policy,"target"))
 if target!="" {
  denied=self.__moderation_error(self.option_text(target),permission)
  if denied!="" {return self.reply(denied,true)}
 }
 seconds=errors.int_or(json.get_raw_large(policy,"seconds"),0)
 if seconds==0 {return ""}
 scope=json.unquote(json.get_raw_large(policy,"scope"))
 subject=""
 if scope=="user" {subject=self.user_id}
 if scope=="guild" {subject=self.guild_id}
 if scope=="channel" {subject=self.channel_id}
 if scope!="global" and (subject=="" or subject=="0") {return self.reply("Este comando requiere un contexto válido para el cooldown.",true)}
 self.__cooldown_request="{\"command\":"+json.quote(key)+",\"scope\":"+json.quote(scope)+",\"subject\":"+json.quote(subject)+",\"seconds\":"+text(seconds)+"}"
 left=self.__cooldown_exchange("use")
 if left<0 {return self.reply("El cooldown no está disponible.",true)}
 if left==0 {return ""}
 message=json.unquote(json.get_raw_large(policy,"message"))
 if message=="" {message="Vuelve a intentarlo en"}
 return self.reply(message+" "+text(left)+" s.",true)
}

func Interaction.__moderation_error(self:Interaction,target:string,permission:string)->string {
 if target=="" or event_id(json.quote(target))!=target {return "Selecciona un miembro válido."}
 if not gw_host_available() {return "La comprobación de jerarquía requiere el lanzador de TRIPOL."}
 request="{\"guild\":"+json.quote(self.guild_id)+",\"actor\":"+json.quote(self.user_id)+",\"target\":"+json.quote(target)+",\"permission\":"+text(permission_index(permission))+"}"
 result=discord_rest(9,"",token(),request)
 if result=="1" {return ""}
 if result=="owner" {return "Esta operación está bloqueada para el propietario del servidor."}
 if result=="self" {return "Esta operación no se puede aplicar al operador ni al bot."}
 if result=="actor_role" {return "Tu rol debe estar por encima del rol del miembro."}
 if result=="bot_role" {return "El rol del bot debe estar por encima del rol del miembro."}
 if result=="actor_permission" {return "Te falta el permiso de moderación en el servidor."}
 if result=="bot_permission" {return "Al bot le falta el permiso de moderación en el servidor."}
 if result=="target_admin" {return "Discord no permite aislar a un administrador."}
 return "No se pudo verificar la jerarquía de roles."
}

func Interaction.can_moderate(self:Interaction,target:string,permission:string)->bool {
 if self.__interaction_token=="" or not self.can(permission) or not self.bot_can(permission) {return false}
 return self.__moderation_error(target,permission)==""
}

struct CooldownBucket {
 __request:string
}

func cooldown_bucket(command:string,scope:string,subject="",guild_id="")->CooldownBucket {
 assert slash_name(command),"Use the registered slash command name"
 assert guild_id=="" or event_id(json.quote(guild_id))==guild_id,"Invalid slash registration guild ID"
 assert scope=="user" or scope=="channel" or scope=="guild" or scope=="global","Choose user, channel, guild or global"
 assert (scope=="global" and subject=="") or (scope!="global" and subject!="" and subject!="0" and event_id(json.quote(subject))==subject),"Provide the ID for this cooldown scope"
 request="{\"command\":"+json.quote("s"+command+"/"+guild_id)+",\"scope\":"+json.quote(scope)+",\"subject\":"+json.quote(subject)+"}"
 return CooldownBucket(request)
}

func CooldownBucket.__exchange(self:CooldownBucket,action:string)->int {
 if self.__request=="" or not gw_host_available() {return -1}
 return errors.int_or(discord_rest(8,action,"",self.__request),-1)
}

func CooldownBucket.remaining(self:CooldownBucket)->int {
 return self.__exchange("remaining")
}

func CooldownBucket.reset(self:CooldownBucket)->bool {
 return self.__exchange("reset")==0
}

func Interaction.__cooldown_exchange(self:Interaction,action:string)->int {
 return CooldownBucket(self.__cooldown_request).__exchange(action)
}

func Interaction.cooldown_remaining(self:Interaction)->int {
 return self.__cooldown_exchange("remaining")
}

func Interaction.reset_cooldown(self:Interaction)->bool {
 return self.__cooldown_exchange("reset")==0
}

func Bot.slash(self:Bot,name:string,description:string,handler:func(Interaction)->string,guild_id="",default_permissions="")->bool {
 return self.slash_with_options(name,description,handler,slash_options(),guild_id,default_permissions)
}

func Bot.slash_with_options(self:Bot,name:string,description:string,handler:func(Interaction)->string,options:SlashOptions,guild_id="",default_permissions="")->bool {
 assert slash_name(name),"Discord slash command names require 1 to 32 lowercase letters, digits or -_"
 assert utf8.valid(description) and utf8.count(description)>=1 and utf8.count(description)<=100,"Discord slash descriptions require 1 to 100 characters"
 assert guild_id=="" or event_id(json.quote(guild_id))==guild_id,"Invalid Discord command guild ID"
 definition="{\"name\":"+json.quote(name)+",\"description\":"+json.quote(description)+",\"type\":1"
 body=options.payload()
 if body!="[]" {definition+=",\"options\":"+body}
 return self.bind_interaction("s"+name,handler,definition+command_permission_payload(default_permissions)+"}",guild_id)
}

func Bot.__context_menu(self:Bot,name:string,handler:func(Interaction)->string,guild_id:string,default_permissions:string,kind:int,route:string)->bool {
 assert utf8.valid(name) and utf8.count(name)>=1 and utf8.count(name)<=32,"Discord context menu names require 1 to 32 characters"
 assert guild_id=="" or event_id(json.quote(guild_id))==guild_id,"Invalid Discord command guild ID"
 for i in range(len(name)) {b=byte_at(name,i);assert b>=32 and b!=127,"Discord context menu names cannot contain control characters"}
 definition="{\"name\":"+json.quote(name)+",\"type\":"+text(kind)+command_permission_payload(default_permissions)+"}"
 return self.bind_interaction(route+name+"/"+guild_id,handler,definition,guild_id)
}

func Bot.user_menu(self:Bot,name:string,handler:func(Interaction)->string,guild_id="",default_permissions="")->bool {
 return self.__context_menu(name,handler,guild_id,default_permissions,2,"u")
}

func Bot.message_menu(self:Bot,name:string,handler:func(Interaction)->string,guild_id="",default_permissions="")->bool {
 return self.__context_menu(name,handler,guild_id,default_permissions,3,"p")
}

func Interaction.target_id(self:Interaction)->string {
 return event_id(json.get_raw_large(self.data_json,"target_id"))
}

func Interaction.target(self:Interaction)->string {
 id=self.target_id()
 if id=="" {return ""}
 kind=json.get_raw_large(self.data_json,"type")
 collection=""
 if kind=="2" {collection="users"}
 if kind=="3" {collection="messages"}
 if collection=="" {return ""}
 resolved=json.get_raw_large(self.data_json,"resolved")
 return json.get_raw_large(json.get_raw_large(resolved,collection),id)
}

func Interaction.target_username(self:Interaction)->string {
 if json.get_raw_large(self.data_json,"type")!="2" {return ""}
 return json.unquote(json.get_raw_large(self.target(),"username"))
}

func Interaction.target_content(self:Interaction)->string {
 if json.get_raw_large(self.data_json,"type")!="3" {return ""}
 return json.unquote(json.get_raw_large(self.target(),"content"))
}

func Bot.on_button(self:Bot,id:string,handler:func(Interaction)->string)->bool {
 assert len(id)>0 and utf8.valid(id) and utf8.count(id)<=100,"Discord custom IDs require 1 to 100 characters"
 return self.bind_interaction("b"+id,handler)
}

func Bot.on_select(self:Bot,id:string,handler:func(Interaction)->string)->bool {
 assert len(id)>0 and utf8.valid(id) and utf8.count(id)<=100,"Discord custom IDs require 1 to 100 characters"
 return self.bind_interaction("c"+id,handler)
}

func Bot.on_modal(self:Bot,id:string,handler:func(Interaction)->string)->bool {
 assert len(id)>0 and utf8.valid(id) and utf8.count(id)<=100,"Discord custom IDs require 1 to 100 characters"
 return self.bind_interaction("m"+id,handler)
}

func Bot.on_autocomplete(self:Bot,name:string,handler:func(Interaction)->string,guild_id="")->bool {
 assert slash_name(name),"Invalid Discord slash command name"
 assert guild_id=="" or event_id(json.quote(guild_id))==guild_id,"Invalid Discord command guild ID"
 return self.bind_interaction("a"+name,handler,"",guild_id)
}

func Bot.preview_interaction(self:Bot,event:string)->string {
 selector=interaction_selector(event)
 if len(selector)==0 {return ""}
 keys=self.interaction_keys
 handlers=self.interaction_handlers
 for i in range(keys.size()) {
  key=keys[i]
  if interaction_matches(key,selector) {
   return interaction_context(json.get_raw_large(event,"d"),key).__invoke(handlers[i])
  }
 }
 return ""
}

func slash_is_current(remote:string,definition:string)->bool {
 if len(remote)<2 or byte_at(remote,0)!=91 {return false}
 n=len(remote)
 wanted_type=json.get_raw_large(definition,"type")
 wanted_name=json.unquote(json.get_raw_large(definition,"name"))
 wanted_desc=json.unquote(json.get_raw_large(definition,"description"))
 wanted_options=slash_option_signature(json.get_raw_large(definition,"options"))
 wanted_permissions=json.get_raw_large(definition,"default_member_permissions")
 at=json.ws(remote,1,n)
 while at<n and byte_at(remote,at)==123 {
  end=json.value(remote,at,n,0)
  if end<0 {return false}
  entry=slice(remote,at,end)
  if json.get_raw_large(entry,"type")==wanted_type and json.string_equals(json.get_raw_large(entry,"name"),wanted_name) {
   if wanted_permissions!="" {
    existing=json.get_raw_large(entry,"default_member_permissions")
    if existing=="" {existing="null"}
    if existing!=wanted_permissions {return false}
   }
   if wanted_type!="1" {return true}
   options=json.get_raw_large(entry,"options")
   option_signature=slash_option_signature(options)
   return json.string_equals(json.get_raw_large(entry,"description"),wanted_desc) and option_signature!="!" and option_signature==wanted_options
  }
  at=json.ws(remote,end,n)
  if at>=n or byte_at(remote,at)!=44 {return false}
  at=json.ws(remote,at+1,n)
 }
 return false
}

func sync_slash_commands(specs:string_list,guilds:string_list)->bool {
 if specs.size()==0 {return true}
 scratch {
  secret=bot_slot_get(0)
  app=""
  visited=string_list()
  for i in range(specs.size()) {
   first=specs.get(i)
   if len(first)>0 {
    if len(app)==0 {
     app=event_id(json.get_raw_large(discord_request("/api/v10/oauth2/applications/@me",secret,""),"id"))
     assert len(app)>0,"Could not identify the Discord bot application"
    }
    guild=guilds.get(i)
    if not visited.contains(guild) {
     visited.add(guild)
     scope="/api/v10/applications/"+app
     if len(guild)>0 {scope+="/guilds/"+guild}
     scope+="/commands"
     current=discord_request(scope,secret,"")
     assert len(current)>=2 and byte_at(current,0)==91,"Invalid Discord application command response"
     for j in range(i,specs.size()) {
      spec=specs.get(j)
      if len(spec)>0 and guilds.get(j)==guild {
       scratch {
        policy=find_bytes(spec,",\"__tripol_policy\":")
        definition=spec
        if policy>=0 {definition=slice(definition,0,policy)+"}"}
        if not slash_is_current(current,definition) {discord_request(scope,secret,definition)}
       }
      }
     }
    }
   }
  }
 }
 return true
}

func Interaction.option_text(self:Interaction,name:string)->string {
 return json.unquote(self.option(name))
}

func Interaction.values(self:Interaction)->string_list {
 return interaction_values(json.get_raw_large(self.data_json,"values"))
}

func interaction_values(values:string)->string_list {
 result=string_list()
 if len(values)<2 or byte_at(values,0)!=91 {return result}
 n=len(values)
 at=json.ws(values,1,n)
 while at<n and byte_at(values,at)==34 {
  end=json.quoted(values,at,n)
  if end<0 {return result}
  result.add(json.unquote(slice(values,at,end)))
  at=json.ws(values,end,n)
  if at>=n or byte_at(values,at)!=44 {return result}
  at=json.ws(values,at+1,n)
 }
 return result
}

func modal_field_value(node:string,id:string,property:string,depth:int)->string {
 if depth>32 or len(node)==0 {return ""}
 if json.string_equals(json.get_raw_large(node,"custom_id"),id) {
  return json.get_raw_large(node,property)
 }
 result=modal_field_value(json.get_raw_large(node,"component"),id,property,depth+1)
 if len(result)>0 {return result}
 items=json.get_raw_large(node,"components")
 if len(items)<2 or byte_at(items,0)!=91 {return ""}
 n=len(items)
 at=json.ws(items,1,n)
 while at<n and byte_at(items,at)==123 {
  end=json.value(items,at,n,0)
  if end<0 {return ""}
  result=modal_field_value(slice(items,at,end),id,property,depth+1)
  if len(result)>0 {return result}
  at=json.ws(items,end,n)
  if at>=n or byte_at(items,at)!=44 {return ""}
  at=json.ws(items,at+1,n)
 }
 return ""
}

func Interaction.field(self:Interaction,id:string)->string {
 return json.unquote(modal_field_value(self.data_json,id,"value",0))
}

struct Modal {
 custom_id:string
 title_text:string
 entries:string_list
 ids:string_list
 text_chars:int
}

func modal(id:string,title:string)->Modal {
 assert utf8.valid(id) and utf8.count(id)>=1 and utf8.count(id)<=100,"Discord modal IDs require 1 to 100 characters"
 assert utf8.valid(title) and utf8.count(title)>=1 and utf8.count(title)<=45,"Discord modal titles require 1 to 45 characters"
 return Modal(id,title,string_list(),string_list(),0)
}

func Modal.add_label(self:Modal,id:string,label:string,component:string,description="")->bool {
 assert utf8.valid(id) and utf8.count(id)>=1 and utf8.count(id)<=100,"Discord modal field IDs require 1 to 100 characters"
 assert utf8.valid(label) and utf8.count(label)>=1 and utf8.count(label)<=45,"Discord modal labels require 1 to 45 characters"
 entries=self.entries
 ids=self.ids
 assert entries.size()<5,"Discord modals accept up to five top-level components"
 assert not ids.contains(id),"Duplicate Discord modal field ID"
 assert utf8.valid(description) and utf8.count(description)<=100,"Discord label descriptions allow up to 100 characters"
 body="{\"type\":18,\"label\":"+json.quote(label)
 if len(description)>0 {body+=",\"description\":"+json.quote(description)}
 entries.add(body+",\"component\":"+component+"}")
 ids.add(id)
 return true
}

func Modal.text(self:Modal,id:string,label:string,style=1,required=true,min_length=0,max_length=4000,placeholder="",value="",description="")->bool {
 assert style==1 or style==2,"Discord text input style must be 1 or 2"
 assert min_length>=0 and min_length<=max_length and max_length>=1 and max_length<=4000,"Invalid Discord text input length limits"
 component="{\"type\":4,\"custom_id\":"+json.quote(id)+",\"style\":"+text(style)+",\"required\":"+json.boolean(required)
 assert utf8.valid(placeholder) and utf8.count(placeholder)<=100,"Discord text input placeholders allow up to 100 characters"
 assert utf8.valid(value) and utf8.count(value)<=max_length,"Discord text input value exceeds max_length"
 component+=",\"min_length\":"+text(min_length)+",\"max_length\":"+text(max_length)
 if placeholder!="" {component+=",\"placeholder\":"+json.quote(placeholder)}
 if value!="" {component+=",\"value\":"+json.quote(value)}
 return self.add_label(id,label,component+"}",description)
}

func Modal.payload(self:Modal)->string {
 entries=self.entries
 assert entries.size()>=1 and entries.size()<=5,"Discord modals require one to five top-level components"
 body="{\"custom_id\":"+json.quote(self.custom_id)+",\"title\":"+json.quote(self.title_text)+",\"components\":["
 for i in range(entries.size()) {
  if i>0 {body+=","}
  body+=entries[i]
 }
 return body+"]}"
}

func Interaction.open_modal(self:Interaction,form:Modal)->string {
 assert self.kind==2 or self.kind==3,"Discord can open modals from command or component interactions"
 return "{\"type\":9,\"data\":"+form.payload()+"}"
}

struct Select {
 custom_id:string
 kind:int
 minimum:int
 maximum:int
 placeholder_text:string
 choices:string_list
 value_ids:string_list
 defaults_json:string_list
 channel_types:string
 __disabled:bool=false
}

func select(id:string,kind="string",minimum=1,maximum=1)->Select {
 assert utf8.valid(id) and utf8.count(id)>=1 and utf8.count(id)<=100,"Discord select IDs require 1 to 100 characters"
 assert minimum>=0 and minimum<=maximum and maximum>=1 and maximum<=25,"Invalid Discord select value bounds"
 code=0
 if kind=="string" {code=3}
 else if kind=="user" {code=5}
 else if kind=="role" {code=6}
 else if kind=="mentionable" {code=7}
 else if kind=="channel" {code=8}
 assert code>0,"Discord select kind must be string, user, role, mentionable or channel"
 return Select(id,code,minimum,maximum,"",string_list(),string_list(),string_list(),"")
}

func Select.placeholder(self:Select,value:string)->bool {
 assert utf8.valid(value) and utf8.count(value)<=150,"Discord select placeholders allow up to 150 characters"
 self.placeholder_text=value
 return true
}

func Select.option(self:Select,label:string,value:string,description="",selected=false,emoji="")->bool {
 assert self.kind==3,"Manual options require a Discord String Select"
 assert utf8.valid(label) and utf8.count(label)>=1 and utf8.count(label)<=100,"Discord option labels require 1 to 100 characters"
 assert utf8.valid(value) and utf8.count(value)>=1 and utf8.count(value)<=100,"Discord option values require 1 to 100 characters"
 assert utf8.valid(description) and utf8.count(description)<=100,"Discord option descriptions allow up to 100 characters"
 items=self.choices
 ids=self.value_ids
 assert items.size()<25,"Discord String Select allows up to 25 options"
 assert not ids.contains(value),"Duplicate Discord select option"
 body="{\"label\":"+json.quote(label)+",\"value\":"+json.quote(value)+",\"default\":"+json.boolean(selected)
 if len(description)>0 {body+=",\"description\":"+json.quote(description)}
 if emoji!="" {body+=",\"emoji\":"+emoji_payload(emoji)}
 items.add(body+"}")
 ids.add(value)
 return true
}

func Select.disable(self:Select,disabled=true)->bool {
 self.__disabled=disabled
 return true
}

func Select.default_id(self:Select,id:string,kind:string)->bool {
 compatible=(self.kind==5 and kind=="user") or (self.kind==6 and kind=="role") or (self.kind==7 and (kind=="user" or kind=="role")) or (self.kind==8 and kind=="channel")
 assert compatible,"Discord default entity type does not match the select menu"
 assert event_id(json.quote(id))==id,"Invalid Discord default entity ID"
 ids=self.value_ids
 defaults=self.defaults_json
 assert defaults.size()<self.maximum,"Discord select default values exceed max_values"
 assert not ids.contains(id),"Duplicate Discord select default ID"
 defaults.add("{\"id\":"+json.quote(id)+",\"type\":"+json.quote(kind)+"}")
 ids.add(id)
 return true
}

func Select.channels(self:Select,kinds:ints)->bool {
 assert self.kind==8,"Channel-type filters require a Discord Channel Select"
 for i in range(len(kinds)) {
  k=kinds[i]
  assert k==0 or k==2 or k==4 or k==5 or k==10 or k==11 or k==12 or k==13 or k==14 or k==15 or k==16,"Unsupported Discord channel type"
 }
 self.channel_types=json.integers(kinds)
 return true
}

func Select.payload(self:Select)->string {
 body="{\"type\":"+text(self.kind)+",\"custom_id\":"+json.quote(self.custom_id)
 body+=",\"min_values\":"+text(self.minimum)+",\"max_values\":"+text(self.maximum)
 if len(self.placeholder_text)>0 {body+=",\"placeholder\":"+json.quote(self.placeholder_text)}
 if self.kind==3 {
  items=self.choices
  assert items.size()>=self.maximum and items.size()<=25,"Discord String Select needs at least max_values options"
  selected=0
  body+=",\"options\":["
  for i in range(items.size()) {
   if i>0 {body+=","}
   if json.get_raw_large(items[i],"default")=="true" {selected+=1}
   body+=items[i]
  }
  assert selected<=self.maximum,"Discord select default options exceed max_values"
  body+="]"
 } else {
  defaults=self.defaults_json
  if defaults.size()>0 {
   assert defaults.size()>=self.minimum and defaults.size()<=self.maximum,"Discord select defaults must meet the value bounds"
   body+=",\"default_values\":["
   for i in range(defaults.size()) {
    if i>0 {body+=","}
    body+=defaults[i]
   }
   body+="]"
  }
 }
 if len(self.channel_types)>0 {body+=",\"channel_types\":"+self.channel_types}
 if self.__disabled {body+=",\"disabled\":true"}
 return body+"}"
}

func Components.select(self:Components,menu:Select)->bool {
 ids=self.custom_ids
 assert not ids.contains(menu.custom_id),"Duplicate Discord component ID"
 self.append_entry("{\"type\":1,\"components\":["+menu.payload()+"]}",2)
 ids.add(menu.custom_id)
 return true
}

func Modal.select(self:Modal,label:string,menu:Select,required=true,description="")->bool {
 assert not menu.__disabled,"Discord does not accept disabled components in modals"
 assert not required or menu.minimum>=1,"Required Discord selects must allow at least one selection"
 body=menu.payload()
 body=slice(body,0,len(body)-1)+",\"required\":"+json.boolean(required)+"}"
 return self.add_label(menu.custom_id,label,body,description)
}

func Modal.help_text(self:Modal,content:string)->bool {
 assert len(content)>0 and utf8.valid(content),"Discord help text requires nonempty UTF-8"
 count=utf8.count(content)
 assert count+self.text_chars<=4000,"Discord Text Display content may total up to 4000 characters"
 entries=self.entries
 assert entries.size()<5,"Discord modals accept up to five top-level components"
 entries.add("{\"type\":10,\"content\":"+json.quote(content)+"}")
 self.text_chars+=count
 return true
}

func Embed.author(self:Embed,name:string,url="",icon_url="")->bool {
 assert utf8.valid(name) and utf8.count(name)<=256,"Embed authors allow up to 256 characters"
 assert url=="" or (name!="" and media_url(url)),"Invalid Discord author URL"
 assert icon_url=="" or (name!="" and attachment_media_url(icon_url)),"Invalid Discord author icon"
 self.author_text=name
 self.author_url=url
 self.author_icon_url=icon_url
 return true
}

func timestamp_valid(value:string)->bool {
 n=len(value)
 if n<20 or byte_at(value,4)!=45 or byte_at(value,7)!=45 or byte_at(value,10)!=84 or byte_at(value,13)!=58 or byte_at(value,16)!=58 {return false}
 for i in range(19) {
  if i!=4 and i!=7 and i!=10 and i!=13 and i!=16 and not json.digit(byte_at(value,i)) {return false}
 }
 y=errors.int_or(slice(value,0,4),0)
 m=errors.int_or(slice(value,5,7),0)
 d=errors.int_or(slice(value,8,10),0)
 h=errors.int_or(slice(value,11,13),99)
 min=errors.int_or(slice(value,14,16),99)
 sec=errors.int_or(slice(value,17,19),99)
 if not datetime.valid(y,m,d) or h>23 or min>59 or sec>59 {return false}
 at=19
 if byte_at(value,at)==46 {
  at+=1
  start=at
  while at<n and json.digit(byte_at(value,at)) {at+=1}
  if at==start or at==n {return false}
 }
 zone=byte_at(value,at)
 if zone==90 {return at+1==n}
 if (zone!=43 and zone!=45) or at+6!=n or byte_at(value,at+3)!=58 {return false}
 if not json.digit(byte_at(value,at+1)) or not json.digit(byte_at(value,at+2)) or not json.digit(byte_at(value,at+4)) or not json.digit(byte_at(value,at+5)) {return false}
 return errors.int_or(slice(value,at+1,at+3),99)<=23 and errors.int_or(slice(value,at+4,n),99)<=59
}

func Embed.timestamp(self:Embed,value:string)->bool {
 assert value=="" or timestamp_valid(value),"Invalid Discord embed timestamp"
 self.timestamp_text=value
 return true
}

struct Embeds {
 entries:string_list
 characters:int
}

func embeds()->Embeds {
 return Embeds(string_list(),0)
}

func Embeds.add(self:Embeds,embed:Embed)->bool {
 entries=self.entries
 assert entries.size()<10,"Discord messages allow up to 10 embeds"
 count=embed.text_size()
 assert self.characters+count<=6000,"Discord embeds may total up to 6000 characters"
 entries.add(embed.entry())
 self.characters+=count
 return true
}

func Embeds.payload(self:Embeds)->string {
 entries=self.entries
 assert entries.size()>=1 and entries.size()<=10 and self.characters<=6000,"Invalid Discord embed batch"
 body="{\"embeds\":["
 suffix="],\"allowed_mentions\":{\"parse\":[]}}"
 for i in range(entries.size()) {
  if i>0 {body+=","}
  assert len(body)+len(entries[i])+len(suffix)<=65535,"Discord payload exceeds the TRIPOL string capacity"
  body+=entries[i]
 }
 return body+suffix
}

func Embeds.send(self:Embeds,channel_id:string)->bool {
 body=self.payload()
 sent=false
 scratch {sent=len(discord_request(channel_path(channel_id),token(),body))>0}
 return sent
}

func Embeds.send_files(self:Embeds,channel_id:string,paths:string_list)->string {
 return send_attachments(channel_id,self.payload(),paths)
}

func Interaction.reply_embeds(self:Interaction,batch:Embeds,ephemeral=false)->string {
 body=batch.payload()
 flags=""
 if ephemeral {flags=",\"flags\":64"}
 assert len(body)+len(flags)+18<=65535,"Discord callback exceeds the TRIPOL string capacity"
 return "{\"type\":4,\"data\":"+slice(body,0,len(body)-1)+flags+"}}"
}

struct SlashOptions {
 entries:string_list
 names:string_list
 optional:bool
 // 0 empty, 1 arguments, 2 subcommands, 3 subcommands and groups.
 __shape:int=0
}

func slash_options()->SlashOptions {
 return SlashOptions(string_list(),string_list(),false)
}

func SlashOptions.__append(self:SlashOptions,name:string,description:string,option_type:int,extra:string)->bool {
 assert slash_name(name),"Invalid Discord slash option name"
 assert utf8.valid(description) and utf8.count(description)>=1 and utf8.count(description)<=100,"Discord option descriptions require 1 to 100 characters"
 entries=self.entries
 names=self.names
 assert entries.size()<25,"Discord slash commands allow up to 25 options"
 assert not names.contains(name),"Duplicate Discord slash option"
 entries.add("{\"name\":"+json.quote(name)+",\"description\":"+json.quote(description)+",\"type\":"+text(option_type)+extra+"}")
 names.add(name)
 return true
}

func SlashOptions.add(self:SlashOptions,name:string,description:string,kind="string",required=false,autocomplete=false)->bool {
 assert self.__shape<=1,"Discord commands cannot mix ordinary options with subcommands"
 assert not required or not self.optional,"Required Discord options must precede optional options"
 option_type=0
 if kind=="string" {option_type=3}
 else if kind=="integer" {option_type=4}
 else if kind=="boolean" {option_type=5}
 else if kind=="user" {option_type=6}
 else if kind=="channel" {option_type=7}
 else if kind=="role" {option_type=8}
 else if kind=="mentionable" {option_type=9}
 else if kind=="number" {option_type=10}
 else if kind=="attachment" {option_type=11}
 assert option_type>0,"Unsupported Discord slash option type"
 extra=",\"required\":"+json.boolean(required)
 if autocomplete {
  assert option_type==3 or option_type==4 or option_type==10,"Discord autocomplete requires a string, integer or number option"
  extra+=",\"autocomplete\":true"
 }
 self.__append(name,description,option_type,extra)
 self.__shape=1
 if not required {self.optional=true}
 return true
}

func SlashOptions.subcommand(self:SlashOptions,name:string,description:string,options:SlashOptions)->bool {
 assert self.__shape!=1 and options.__shape<=1,"A Discord subcommand can contain ordinary options only"
 self.__append(name,description,1,",\"options\":"+options.payload())
 if self.__shape==0 {self.__shape=2}
 return true
}

func SlashOptions.group(self:SlashOptions,name:string,description:string,subcommands:SlashOptions)->bool {
 assert self.__shape!=1 and subcommands.__shape==2,"A Discord subcommand group must contain one or more subcommands only"
 self.__append(name,description,2,",\"options\":"+subcommands.payload())
 self.__shape=3
 return true
}

func SlashOptions.choose(self:SlashOptions,name:string,description:string,choices:CommandChoices,required=false)->bool {
 assert self.__shape<=1,"Discord commands cannot mix ordinary options with subcommands"
 assert not required or not self.optional,"Required Discord options must precede optional options"
 assert choices.__kind!=0,"Discord command choices cannot be empty"
 extra=",\"required\":"+json.boolean(required)+",\"choices\":"+choices.payload()
 self.__append(name,description,choices.__kind,extra)
 self.__shape=1
 if not required {self.optional=true}
 return true
}

func SlashOptions.payload(self:SlashOptions)->string {
 body="["
 entries=self.entries
 for i in range(entries.size()) {
  if i>0 {body+=","}
  body+=entries[i]
 }
 return body+"]"
}

struct CommandChoices {
 __entries:string_list
 __kind:int
}

func command_choices()->CommandChoices {
 return CommandChoices(string_list(),0)
}

func CommandChoices.__append(self:CommandChoices,label:string,value:string,kind:int)->bool {
 assert utf8.valid(label) and utf8.count(label)>=1 and utf8.count(label)<=100,"Discord choice names require 1 to 100 characters"
 assert self.__kind==0 or self.__kind==kind,"Discord choices must have a consistent type"
 choices=self.__entries
 assert choices.size()<25,"Discord accepts up to 25 command choices"
 choices.add("{\"name\":"+json.quote(label)+",\"value\":"+value+"}")
 self.__kind=kind
 return true
}

func CommandChoices.add(self:CommandChoices,label:string,value:string)->bool {
 assert utf8.valid(value) and utf8.count(value)<=100,"Discord string choice values accept up to 100 characters"
 return self.__append(label,json.quote(value),3)
}

func CommandChoices.integer(self:CommandChoices,label:string,value:int)->bool {
 assert value>=-9007199254740991 and value<=9007199254740991,"Discord integer choice is outside its safe range"
 return self.__append(label,text(value),4)
}

// Accept decimal text so that the definition and comparison preserve the
// submitted digits on every target, including the Web Engine.
func CommandChoices.number(self:CommandChoices,label:string,value:string)->bool {
 assert slash_number_signature(value)!="","Provide a Discord number between -9007199254740992 and 9007199254740992"
 return self.__append(label,value,10)
}

// Normalize the significand and exponent without converting to machine floats.
func slash_number_signature(value:string)->string {
 n=len(value)
 if n==0 or json.number(value,0,n)!=n {return ""}
 start=0
 if byte_at(value,0)==45 {start=1}
 point=n
 end=n
 for i in range(start,n) {
  b=byte_at(value,i)
  if b==46 {point=i}
  if b==101 or b==69 {end=i;break}
 }
 exponent=0
 if end<n {
  at=end+1
  negative=byte_at(value,at)==45
  if negative or byte_at(value,at)==43 {at+=1}
  while at<n {
   exponent=exponent*10+byte_at(value,at)-48
   if exponent>100000 {break}
   at+=1
  }
  if negative {exponent=-exponent}
 }
 if point>end {point=end}
 digits=slice(value,start,point)
 if point<end {digits+=slice(value,point+1,end)}
 first=0
 last=len(digits)
 while first<last and byte_at(digits,first)==48 {first+=1}
 if first==last {return "0"}
 while last>first and byte_at(digits,last-1)==48 {last-=1}
 order=exponent+point-start-first-1
 if order>15 or order< -324 {return ""}
 if order==15 {
  bound="9007199254740992"
  equal=true
  for i in range(16) {
   digit=48
   if first+i<last {digit=byte_at(digits,first+i)}
   if digit>byte_at(bound,i) {return ""}
   if digit<byte_at(bound,i) {equal=false;break}
  }
  if equal and last-first>16 {return ""}
 }
 if order== -324 and byte_at(digits,first)<51 {return ""}
 return slice(value,0,start)+slice(digits,first,last)+"e"+text(order)
}

func CommandChoices.payload(self:CommandChoices)->string {
 body="["
 entries=self.__entries
 for i in range(entries.size()) {
  if i>0 {body+=","}
  body+=entries[i]
 }
 return body+"]"
}

func Interaction.autocomplete(self:Interaction,choices:CommandChoices)->string {
 assert self.kind==4,"Discord autocomplete requires an autocomplete interaction"
 option=interaction_option(self.data_json,"",true)
 kind=json.get_raw_large(option,"type")
 assert choices.__kind==0 or (kind=="3" and choices.__kind==3) or (kind=="4" and choices.__kind==4) or (kind=="10" and (choices.__kind==4 or choices.__kind==10)),"Discord choices must match the focused option type"
 return "{\"type\":8,\"data\":{\"choices\":"+choices.payload()+"}}"
}

func slash_choice_signature(choices:string)->string {
 if len(choices)==0 {return ""}
 n=len(choices)
 if n<2 or byte_at(choices,0)!=91 {return "!"}
 at=json.ws(choices,1,n)
 result=""
 while at<n and byte_at(choices,at)==123 {
  end=json.value(choices,at,n,0)
  if end<0 {return "!"}
  entry=slice(choices,at,end)
  label=json.get_raw_large(entry,"name")
  value=json.get_raw_large(entry,"value")
  if len(label)<2 or len(value)==0 {return "!"}
  if byte_at(value,0)==34 {value=json.quote(json.unquote(value))}
  else {value=slash_number_signature(value);if value=="" {return "!"}}
  result+=json.quote(json.unquote(label))+":"+value+";"
  at=json.ws(choices,end,n)
  if at>=n {return "!"}
  if byte_at(choices,at)==93 {return result}
  if byte_at(choices,at)!=44 {return "!"}
  at=json.ws(choices,at+1,n)
 }
 if at<n and byte_at(choices,at)==93 {return result}
 return "!"
}

// Normalize the supported fields for comparison with Discord's representation.
// Extra server-side option shapes are changed only on a locally registered name.
func slash_option_signature(options:string,depth=0)->string {
 if options=="" {return ""}
 if depth>2 {return "!"}
 n=len(options)
 if n<2 or byte_at(options,0)!=91 {return "!"}
 at=json.ws(options,1,n)
 result=""
 while at<n and byte_at(options,at)==123 {
  end=json.value(options,at,n,0)
  if end<0 {return "!"}
  entry=slice(options,at,end)
  if len(json.get_raw_large(entry,"min_value"))>0 or len(json.get_raw_large(entry,"max_value"))>0 or len(json.get_raw_large(entry,"min_length"))>0 or len(json.get_raw_large(entry,"max_length"))>0 or len(json.get_raw_large(entry,"channel_types"))>2 {return "!"}
  children=json.get_raw_large(entry,"options")
  nested=""
  if len(children)>2 {nested=slash_option_signature(children,depth+1)}
  choices=slash_choice_signature(json.get_raw_large(entry,"choices"))
  if nested=="!" or choices=="!" {return "!"}
  result+=json.get_raw_large(entry,"type")+":"+json.quote(json.unquote(json.get_raw_large(entry,"name")))+":"+json.quote(json.unquote(json.get_raw_large(entry,"description")))
  result+=":"+json.boolean(json.get_raw_large(entry,"required")=="true")+":"+json.boolean(json.get_raw_large(entry,"autocomplete")=="true")+"["+nested+"]["+choices+"];"
  at=json.ws(options,end,n)
  if at>=n {return "!"}
  if byte_at(options,at)==93 {return result}
  if byte_at(options,at)!=44 {return "!"}
  at=json.ws(options,at+1,n)
 }
 if at<n and byte_at(options,at)==93 {return result}
 return "!"
}

func Interaction.field_data(self:Interaction,id:string)->string {
 return modal_field_value(self.data_json,id,"values",0)
}

func Interaction.has_field(self:Interaction,id:string)->bool {
 return self.kind==5 and modal_field_value(self.data_json,id,"type",0)!=""
}

func Interaction.field_values(self:Interaction,id:string)->string_list {
 return interaction_values(self.field_data(id))
}

struct UploadedFile {
 id:string
 filename:string
 url:string
 size:int
 content_type:string
}

func Interaction.field_attachment(self:Interaction,id:string,index=0)->UploadedFile {
 empty=UploadedFile("","","",0,"")
 if self.kind!=5 or index<0 or modal_field_value(self.data_json,id,"type",0)!="19" {return empty}
 values=self.field_values(id)
 if index>=values.size() {return empty}
 attachment_id=values[index]
 if event_id(json.quote(attachment_id))!=attachment_id or attachment_id=="" {return empty}
 resolved=json.get_raw_large(self.data_json,"resolved")
 file=json.get_raw_large(json.get_raw_large(resolved,"attachments"),attachment_id)
 if event_id(json.get_raw_large(file,"id"))!=attachment_id {return empty}
 return UploadedFile(attachment_id,json.unquote(json.get_raw_large(file,"filename")),json.unquote(json.get_raw_large(file,"url")),errors.int_or(json.get_raw_large(file,"size"),0),json.unquote(json.get_raw_large(file,"content_type")))
}

func Modal.file(self:Modal,id:string,label:string,minimum=1,maximum=1,required=true,description="")->bool {
 return self.file(id,label,string_list(),minimum,maximum,required,description)
}

func Modal.file(self:Modal,id:string,label:string,types:string_list,minimum=1,maximum=1,required=true,description="")->bool {
 assert minimum>=0 and minimum<=maximum and maximum>=1 and maximum<=10 and (not required or minimum>=1),"Invalid Discord File Upload value bounds"
 body="{\"type\":19,\"custom_id\":"+json.quote(id)+",\"min_values\":"+text(minimum)+",\"max_values\":"+text(maximum)+",\"required\":"+json.boolean(required)
 if types.size()>0 {body+=",\"file_types\":"+file_types_payload(types)}
 return self.add_label(id,label,body+"}",description)
}

func file_types_payload(types:string_list)->string {
 assert types.size()<=10,"Discord accepts up to ten file type filters"
 result="["
 for i in range(types.size()) {
  value=types[i]
  if value!="image" and value!="video" and value!="audio" {
   assert len(value)>1 and byte_at(value,0)==46,"Use image, video, audio or a dot-prefixed extension"
   for j in range(1,len(value)) {
    b=byte_at(value,j)
    assert b>32 and b!=47 and b!=92 and b!=127,"Invalid Discord file type extension"
   }
   assert utf8.valid(value),"Invalid Discord file type extension"
  }
  if i>0 {result+=","}
  result+=json.quote(value)
 }
 return result+"]"
}

// Accept Unicode or Discord's custom emoji notation, including animated names.
func emoji_payload(emoji:string)->string {
 assert len(emoji)>0 and utf8.valid(emoji),"Discord emoji requires nonempty UTF-8"
 if event_id(json.quote(emoji))==emoji {return "{\"id\":"+json.quote(emoji)+"}"}
 animated=has_prefix(emoji,"<a:")
 if animated or has_prefix(emoji,"<:") {
  start=2
  if animated {start=3}
  assert has_suffix(emoji,">"),"Use <:name:id> or <a:name:id> for custom emoji"
  value=slice(emoji,start,len(emoji)-1)
  colon=find_bytes(value,":")
  assert colon>=1,"Use <:name:id> or <a:name:id> for custom emoji"
  label=slice(value,0,colon)
  for i in range(len(label)) {
   b=byte_at(label,i)
   assert (b>=48 and b<=57) or (b>=65 and b<=90) or (b>=97 and b<=122) or b==95,"Invalid Discord custom emoji name"
  }
  id=slice(value,colon+1,len(value))
  assert id!="" and event_id(json.quote(id))==id,"Invalid Discord custom emoji ID"
  return "{\"id\":"+json.quote(id)+",\"name\":"+json.quote(label)+",\"animated\":"+json.boolean(animated)+"}"
 }
 assert utf8.count(emoji)<len(emoji),"Use a Unicode emoji or provide a custom emoji ID"
 return "{\"name\":"+json.quote(emoji)+"}"
}

struct Buttons {
 entries:string_list
 ids:string_list
}

func button_row()->Buttons {
 return Buttons(string_list(5),string_list(5))
}

func Buttons.button(self:Buttons,label:string,id:string,style=1,disabled=false,emoji="")->bool {
 assert (label!="" or emoji!="") and utf8.count(label)<=80,"Discord buttons require text up to 80 characters or an emoji"
 assert len(id)>0 and utf8.count(id)<=100,"Discord custom IDs require 1 to 100 characters"
 assert style>=1 and style<=4,"Discord custom button style must be 1 to 4"
 entries=self.entries
 ids=self.ids
 assert entries.size()<5,"Discord button rows accept up to five buttons"
 assert not ids.contains(id),"Duplicate Discord component ID"
 body="{\"type\":2,\"style\":"+text(style)
 if label!="" {body+=",\"label\":"+json.quote(label)}
 body+=",\"custom_id\":"+json.quote(id)
 if emoji!="" {body+=",\"emoji\":"+emoji_payload(emoji)}
 if disabled {body+=",\"disabled\":true"}
 entries.add(body+"}")
 ids.add(id)
 return true
}

func button_style(name:string)->int {
 if name=="primary" {return 1}
 if name=="secondary" {return 2}
 if name=="success" {return 3}
 assert name=="danger","Discord button style must be primary, secondary, success or danger"
 return 4
}

func Buttons.button(self:Buttons,label:string,id:string,style:string,disabled=false,emoji="")->bool {
 return self.button(label,id,button_style(style),disabled,emoji)
}

func Buttons.link(self:Buttons,label:string,url:string,disabled=false,emoji="")->bool {
 assert (label!="" or emoji!="") and utf8.valid(label) and utf8.count(label)<=80,"Discord buttons require text up to 80 characters or an emoji"
 assert len(url)<=512 and media_url(url),"Invalid Discord button URL"
 entries=self.entries
 assert entries.size()<5,"Discord button rows accept up to five buttons"
 body="{\"type\":2,\"style\":5"
 if label!="" {body+=",\"label\":"+json.quote(label)}
 body+=",\"url\":"+json.quote(url)
 if emoji!="" {body+=",\"emoji\":"+emoji_payload(emoji)}
 if disabled {body+=",\"disabled\":true"}
 entries.add(body+"}")
 return true
}

func Buttons.premium(self:Buttons,sku_id:string,disabled=false)->bool {
 assert sku_id!="" and event_id(json.quote(sku_id))==sku_id,"Invalid Discord premium SKU ID"
 entries=self.entries
 assert entries.size()<5,"Discord button rows accept up to five buttons"
 body="{\"type\":2,\"style\":6,\"sku_id\":"+json.quote(sku_id)
 if disabled {body+=",\"disabled\":true"}
 entries.add(body+"}")
 return true
}

func Buttons.disable(self:Buttons,id:string,disabled=true)->bool {
 entries=self.entries
 suffix=",\"disabled\":true}"
 for i in range(entries.size()) {
  body=entries[i]
  if json.string_equals(json.get_raw_large(body,"custom_id"),id) {
   present=has_suffix(body,suffix)
   if present and not disabled {entries.set(i,slice(body,0,len(body)-len(suffix))+"}")}
   if not present and disabled {entries.set(i,slice(body,0,len(body)-1)+suffix)}
   return true
  }
 }
 return false
}

func Components.row(self:Components,buttons:Buttons)->bool {
 entries=buttons.entries
 ids=self.custom_ids
 child_ids=buttons.ids
 assert entries.size()>=1 and entries.size()<=5,"Discord button rows require one to five buttons"
 for i in range(child_ids.size()) {assert not ids.contains(child_ids[i]),"Duplicate Discord component ID"}
 body="{\"type\":1,\"components\":["
 for i in range(entries.size()) {
  if i>0 {body+=","}
  body+=entries[i]
 }
 self.append_entry(body+"]}",entries.size()+1)
 for i in range(child_ids.size()) {ids.add(child_ids[i])}
 return true
}

// Radio Group and Checkbox Group reuse the standard label/value/description
// options of a String Select.
func Modal.choice_group(self:Modal,label:string,menu:Select,radio:bool,required:bool,description="")->bool {
 assert menu.kind==3,"Modal choice groups require manually supplied options"
 items=menu.choices
 count=items.size()
 assert count>=1 and count<=10,"Discord modal choice groups accept up to ten options"
 if radio {assert count>=2,"Discord Radio Group requires at least two options"}
 if not radio {assert menu.maximum<=count and (not required or menu.minimum>=1),"Invalid Discord Checkbox Group value bounds"}
 selected=0
 code=22
 if radio {code=21}
 body="{\"type\":"+text(code)+",\"custom_id\":"+json.quote(menu.custom_id)+",\"required\":"+json.boolean(required)
 if not radio {body+=",\"min_values\":"+text(menu.minimum)+",\"max_values\":"+text(menu.maximum)}
 body+=",\"options\":["
 for i in range(count) {
  if i>0 {body+=","}
  assert json.get_raw_large(items[i],"emoji")=="","Discord radio and checkbox groups do not support emoji options"
  if json.get_raw_large(items[i],"default")=="true" {selected+=1}
  body+=items[i]
 }
 if radio {assert selected<=1,"Discord Radio Group accepts a single default"}
 else {assert selected<=menu.maximum,"Discord Checkbox Group default options exceed max_values"}
 return self.add_label(menu.custom_id,label,body+"]}",description)
}

func Modal.radio(self:Modal,label:string,menu:Select,required=true,description="")->bool {
 return self.choice_group(label,menu,true,required,description)
}

func Modal.checkbox_group(self:Modal,label:string,menu:Select,required=true,description="")->bool {
 return self.choice_group(label,menu,false,required,description)
}

func Modal.checkbox(self:Modal,id:string,label:string,checked=false,description="")->bool {
 body="{\"type\":23,\"custom_id\":"+json.quote(id)+",\"default\":"+json.boolean(checked)+"}"
 return self.add_label(id,label,body,description)
}

func Interaction.checked(self:Interaction,id:string)->bool {
 return modal_field_value(self.data_json,id,"value",0)=="true"
}

// Explicitly send the initial response before doing more work in the handler.
func Interaction.respond(self:Interaction,body:string)->bool {
 if self.__interaction_token=="" or self.id=="" or self.__response_state!=0 {return false}
 kind=json.get_raw_large(body,"type")
 if kind=="" or (self.kind==4 and kind!="8") or (self.kind!=4 and kind=="8") {return false}
 path="/api/v10/interactions/"+self.id+"/"+self.__interaction_token+"/callback"
 self.__response_state=1
 ok=false
 scratch {ok=len(discord_callback(path,body))>0}
 if ok {self.__response_state=2}
 return ok
}

func Interaction.edit_response(self:Interaction,body:string)->bool {
 if self.__response_state!=2 or self.__interaction_token=="" or self.application_id=="" {return false}
 if len(body)<2 or byte_at(body,0)!=123 {return false}
 path="/api/v10/webhooks/"+self.application_id+"/"+self.__interaction_token+"/messages/@original"
 ok=false
 scratch {ok=len(discord_edit(path,body))>0}
 return ok
}

func Interaction.edit_reply(self:Interaction,content:string)->bool {
 return self.edit_response(interaction_message(content))
}

func Interaction.followup(self:Interaction,content:string,ephemeral=false)->string {
 if self.__response_state!=2 or self.__interaction_token=="" or self.application_id=="" {return ""}
 path="/api/v10/webhooks/"+self.application_id+"/"+self.__interaction_token
 body=interaction_message(content,ephemeral)
 return event_id(json.get_raw_large(discord_callback(path,body),"id"))
}

func Interaction.__followup_path(self:Interaction,message_id:string)->string {
 if self.__response_state!=2 or self.__interaction_token=="" or self.application_id=="" {return ""}
 if message_id=="" or event_id(json.quote(message_id))!=message_id {return ""}
 return "/api/v10/webhooks/"+self.application_id+"/"+self.__interaction_token+"/messages/"+message_id
}

func Interaction.edit_followup_payload(self:Interaction,message_id:string,body:string)->bool {
 path=self.__followup_path(message_id)
 if path=="" or len(body)<2 or byte_at(body,0)!=123 {return false}
 ok=false
 scratch {ok=len(discord_edit(path,body))>0}
 return ok
}

func Interaction.edit_followup(self:Interaction,message_id:string,content:string)->bool {
 return self.edit_followup_payload(message_id,interaction_message(content))
}

func Interaction.delete_followup(self:Interaction,message_id:string)->bool {
 path=self.__followup_path(message_id)
 if path=="" {return false}
 ok=false
 scratch {ok=len(discord_edit(path,""))>0}
 return ok
}

struct Guild {
 id:string
}

struct Member {
 __guild:string
 __user:string
}

func guild(id:string)->Guild {
 assert id!="" and event_id(json.quote(id))==id,"Invalid Discord guild ID"
 return Guild(id)
}

func Guild.member(self:Guild,id:string)->Member {
 assert self.id!="" and event_id(json.quote(self.id))==self.id,"Invalid Discord guild ID"
 assert id!="" and event_id(json.quote(id))==id,"Invalid Discord member ID"
 return Member(self.id,id)
}

func Guild.__path(self:Guild,resource:string)->string {
 assert self.id!="" and event_id(json.quote(self.id))==self.id,"Invalid Discord guild ID"
 return "/api/v10/guilds/"+self.id+"/"+resource
}

func Guild.channels(self:Guild)->string {
 return discord_rest(1,self.__path("channels"),token(),"")
}

func Guild.create_channel(self:Guild,name:string,kind="text",parent_id="",topic="")->string {
 assert utf8.valid(name) and utf8.count(name)>=1 and utf8.count(name)<=100,"Discord channel names require 1 to 100 characters"
 code=0
 if kind=="voice" {code=2}
 else if kind=="category" {code=4}
 else if kind=="announcement" {code=5}
 else if kind=="forum" {code=15}
 else if kind=="media" {code=16}
 else {assert kind=="text","Choose text, voice, category, announcement, forum or media"}
 assert parent_id=="" or (code!=4 and event_id(json.quote(parent_id))==parent_id),"Invalid Discord category ID"
 assert topic=="" or ((code==0 or code==5 or code==15 or code==16) and utf8.valid(topic) and utf8.count(topic)<=1024),"Invalid topic for Discord channel type"
 body="{\"name\":"+json.quote(name)+",\"type\":"+text(code)
 if parent_id!="" {body+=",\"parent_id\":"+json.quote(parent_id)}
 if topic!="" {body+=",\"topic\":"+json.quote(topic)}
 reply=discord_rest(2,self.__path("channels"),token(),body+"}")
 return event_id(json.get_raw_large(reply,"id"))
}

func Guild.audit(self:Guild,limit=25,before="",action=0)->string {
 assert limit>=1 and limit<=100,"Discord audit log limit must be 1 to 100"
 assert before=="" or event_id(json.quote(before))==before,"Invalid Discord audit entry ID"
 assert action>=0,"Invalid Discord audit action type"
 path=self.__path("audit-logs")+"?limit="+text(limit)
 if before!="" {path+="&before="+before}
 if action>0 {path+="&action_type="+text(action)}
 return discord_rest(1,path,token(),"")
}

struct Role {
 __guild:string
 __id:string
}

func Guild.roles(self:Guild)->string {return discord_rest(1,self.__path("roles"),token(),"")}

func Guild.move_role(self:Guild,role_id:string,position:int)->bool {
 assert role_id!="" and role_id!=self.id and event_id(json.quote(role_id))==role_id,"Provide a role ID other than @everyone"
 assert position>=1,"Discord role positions start at 1 above @everyone"
 body="[{\"id\":"+json.quote(role_id)+",\"position\":"+text(position)+"}]"
 return len(discord_rest(4,self.__path("roles"),token(),body))>0
}

func Guild.role_ref(self:Guild,id:string)->Role {
 assert self.id!="" and event_id(json.quote(self.id))==self.id,"Invalid Discord guild ID"
 assert id!="" and event_id(json.quote(id))==id,"Invalid Discord role ID"
 return Role(self.id,id)
}

func role_payload(name:string,permissions:string,color:string)->string {
 assert utf8.valid(name) and utf8.count(name)<=100,"Discord role names allow up to 100 characters"
 assert permissions=="" or permissions_bitset_valid(permissions),"Use a canonical decimal permissions bitset"
 body="{"
 if name!="" {body+="\"name\":"+json.quote(name)}
 if permissions!="" {
  if len(body)>1 {body+=","}
  body+="\"permissions\":"+json.quote(permissions)
 }
 if color!="" {
  if len(body)>1 {body+=","}
  body+="\"colors\":{\"primary_color\":"+text(rgb_color(color))+"}"
 }
 return body+"}"
}

func Guild.create_role(self:Guild,name:string,permissions="0",color="")->string {
 assert name!="","Provide a name for the Discord role"
 body=role_payload(name,permissions,color)
 return event_id(json.get_raw_large(discord_rest(2,self.__path("roles"),token(),body),"id"))
}

