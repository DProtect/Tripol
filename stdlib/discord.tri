func Channel.overwrite(self:Channel,id:string,allow="0",deny="0",kind="role")->bool {
 assert id!="" and event_id(json.quote(id))==id,"Provide a role or user ID for the channel overwrite"
 assert permissions_bitset_valid(allow) and permissions_bitset_valid(deny),"Channel permission masks must be decimal strings"
 assert kind=="role" or kind=="user","Choose role or user for the channel overwrite"
 target=0
 if kind=="user" {target=1}
 body="{\"type\":"+text(target)+",\"allow\":"+json.quote(allow)+",\"deny\":"+json.quote(deny)+"}"
 return len(discord_rest(3,"/api/v10/channels/"+self.__id+"/permissions/"+id,token(),body))>0
}

