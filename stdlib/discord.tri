func Role.__path(self:Role)->string {return "/api/v10/guilds/"+self.__guild+"/roles/"+self.__id}

func Role.read(self:Role)->string {return discord_rest(1,self.__path(),token(),"")}

func Role.permissions(self:Role)->string {
 path="/api/v10/guilds/"+self.__guild+"/permissions/role/"+self.__id
 reply=discord_rest(1,path,token(),"")
 return json.unquote(json.get_raw_large(reply,"permissions"))
}

func Role.edit(self:Role,name="",permissions="",color="")->bool {
 body=role_payload(name,permissions,color)
 assert body!="{}","Provide at least one Discord role field to edit"
 return len(discord_rest(4,self.__path(),token(),body))>0
}

func Role.delete(self:Role)->bool {return len(discord_rest(5,self.__path(),token(),""))>0}

