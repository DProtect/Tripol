import tripol.colors
// Software framebuffer, one int64 packed RGB pixel per element, row-major.
func size(w:int,h:int)->int {
 assert w>0 and h>0 and w<=65535 and h<=65535,"Invalid canvas size"
 assert w*h<=65535,"Canvas exceeds 65535 pixels"
 return w*h
}
func create(w:int,h:int)->ints {return ints(size(w,h))}
// Mutating operations require a dynamic array. RGB24, no alpha.
func clear(pixels:ints,color:int)->int {
 assert colors.valid(color),"Invalid RGB"
 return array_fill(pixels,color)
}
func pixel(pixels:ints,w:int,h:int,x:int,y:int,color:int)->bool {
 assert len(pixels)==size(w,h) and colors.valid(color),"Invalid canvas or RGB"
 if x<0 or y<0 or x>=w or y>=h {return false}
 pixels[y*w+x]=color
 return true
}
func get(pixels:ints,w:int,h:int,x:int,y:int)->int {
 assert len(pixels)==size(w,h) and x>=0 and y>=0 and x<w and y<h,"Invalid canvas coordinate"
 return pixels[y*w+x]
}
// Clipped rectangle. Negative dimensions rejected. Bounds checked before drawing.
func rectangle(pixels:ints,w:int,h:int,x:int,y:int,rw:int,rh:int,color:int)->int {
 assert len(pixels)==size(w,h) and colors.valid(color),"Invalid canvas or RGB"
 assert rw>=0 and rh>=0,"Negative rectangle size"
 if rw==0 or rh==0 or x>=w or y>=h {return 0}
 x0=max(x,0);y0=max(y,0);x1=min(x+rw,w);y1=min(y+rh,h)
 if x0>=x1 or y0>=y1 {return 0}
 for row in range(y0,y1) {
  for col in range(x0,x1) {pixels[row*w+col]=color}
 }
 return (x1-x0)*(y1-y0)
}
