func celsius_to_fahrenheit(c:float) -> float {return c*1.8+32.0}
func fahrenheit_to_celsius(f:float) -> float {return (f-32.0)/1.8}
func km_to_miles(k:float) -> float {return k/1.609344}
func miles_to_km(m:float) -> float {return m*1.609344}
func kg_to_lb(k:float) -> float {return k/0.45359237}
func lb_to_kg(l:float) -> float {return l*0.45359237}
func celsius_to_kelvin(c:float) -> float {return c+273.15}
func kelvin_to_celsius(k:float) -> float {return k-273.15}
