// Byte arrays represented as ints, with explicit validation at public boundaries.
func is_byte(value:int)->bool {return value>=0 and value<=255}
func valid(data:ints)->bool {
 for value in data {if not is_byte(value) {return false}}
 return true
}
func read_u16_le(data:ints,offset:int)->int {
 assert offset>=0 and offset<=len(data)-2,"Binary offset out of range"
 a=data[offset];b=data[offset+1]
 assert is_byte(a) and is_byte(b),"Invalid byte"
 return a+b*256
}
func read_u32_le(data:ints,offset:int)->int {
 assert offset>=0 and offset<=len(data)-4,"Binary offset out of range"
 return read_u16_le(data,offset)+read_u16_le(data,offset+2)*65536
}
func u16_le(value:int)->ints {
 assert value>=0 and value<=65535,"Value outside u16"
 a=ints(2);a[0]=value%256;a[1]=value/256;return a
}
func u32_le(value:int)->ints {
 assert value>=0 and value<=4294967295,"Value outside u32"
 a=ints(4);a[0]=value%256;a[1]=value/256%256;a[2]=value/65536%256;a[3]=value/16777216;return a
}
func read_u16_be(data:ints,offset:int)->int {
 assert offset>=0 and offset<=len(data)-2,"Binary offset out of range"
 a=data[offset];b=data[offset+1]
 assert is_byte(a) and is_byte(b),"Invalid byte"
 return a*256+b
}
func u16_be(value:int)->ints {
 assert value>=0 and value<=65535,"Value outside u16"
 a=ints(2);a[0]=value/256;a[1]=value%256;return a
}
