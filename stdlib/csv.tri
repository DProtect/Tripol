// Single-field escaping and single-record validation (comma separator).
func escape(field:string)->string {
 result="\""
 for i in range(len(field)) {
  c=slice(field,i,i+1);result=result+c
  if c=="\"" {result=result+c}
 }
 return result+"\""
}
func fields(record:string)->int {
 n=len(record);i=0;count=1;state=0
 // state: 0 at field start, 1 bare, 2 quoted, 3 after closing quote.
 while i<n {
  b=byte_at(record,i)
  if state==2 {
   if b==34 {if i+1<n and byte_at(record,i+1)==34 {i+=1} else {state=3}}
  } else if b==44 {count+=1;state=0}
  else if b==34 and state==0 {state=2}
  else {if b==34 or b==10 or b==13 or state==3 {return -1};state=1}
  i+=1
 }
 if state==2 {return -1}
 return count
}
func valid(record:string)->bool {return fields(record)>0}
