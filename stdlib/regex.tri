// Bounded full-string matching: literal bytes, dot, star on previous atom.
// No captures, alternation, groups, escapes or Unicode codepoint semantics.
func valid(pattern:string)->bool {
 if len(pattern)>128 {return false}
 for i in range(len(pattern)) {
  b=byte_at(pattern,i)
  if b==42 {if i==0 {return false};if byte_at(pattern,i-1)==42 {return false}}
  else if b==40 or b==41 or b==91 or b==93 or b==123 or b==125 or b==43 or b==63 or b==124 or b==92 or b==94 or b==36 {return false}
 }
 return true
}
func matches(pattern:string,value:string)->bool {
 assert valid(pattern) and len(value)<=4096,"Unsupported or oversized regex"
 n=len(pattern);a=ints(n+1);b=ints(n+1);a[0]=1
 for j in range(2,n+1) {if byte_at(pattern,j-1)==42 {a[j]=a[j-2]}}
 for i in range(len(value)) {
  b[0]=0;v=byte_at(value,i)
  for j in range(1,n+1) {
   p=byte_at(pattern,j-1);b[j]=0
   if p==42 {
    atom=byte_at(pattern,j-2)
    if b[j-2]==1 or ((atom==46 or atom==v) and a[j]==1) {b[j]=1}
   } else if (p==46 or p==v) and a[j-1]==1 {b[j]=1}
  }
  swap=a;a=b;b=swap
 }
 return a[n]==1
}
