func clamp01(t:float)->float {if t<0.0 {return 0.0};if t>1.0 {return 1.0};return t}
func linear(a:float,b:float,t:float)->float {return a+(b-a)*clamp01(t)}
func ease_in(t:float)->float {u=clamp01(t);return u*u}
func ease_out(t:float)->float {u=1.0-clamp01(t);return 1.0-u*u}
func smoothstep(t:float)->float {u=clamp01(t);return u*u*(3.0-2.0*u)}
func frame(elapsed:int,frame_ms:int,count:int)->int {
 assert elapsed>=0 and frame_ms>0 and count>0,"Invalid animation timing"
 return elapsed/frame_ms%count
}
