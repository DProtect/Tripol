import "lexer.tri"
import tripol.validate
// Self-hosting R2 arithmetic parser/evaluator. Single line, checked int64.
// Supported: decimal literals, parentheses, unary +/-, binary +,-,*,/,%.
// Tokens are lexer triples; cursor[0] is the next triple offset.
func boot_peek(source:string,tokens:ints,cursor:ints)->string {
 i=cursor[0];if i>=len(tokens) {return ""}
 return slice(source,tokens[i+1],tokens[i+2])
}
func boot_factor(source:string,tokens:ints,cursor:ints,depth:int)->int {
 assert depth<=64,"Parser nesting limit"
 i=cursor[0];assert i<len(tokens),"Expected operand"
 tok=boot_peek(source,tokens,cursor);cursor[0]=i+3
 if tok=="(" {
  result=boot_expr(source,tokens,cursor,depth+1)
  assert boot_peek(source,tokens,cursor)==")","Expected closing parenthesis"
  cursor[0]=cursor[0]+3;return result
 }
 if tok=="+" {return boot_factor(source,tokens,cursor,depth+1)}
 if tok=="-" {return -boot_factor(source,tokens,cursor,depth+1)}
 assert tokens[i]==2 and validate.integer(tok),"Expected integer"
 return parse_int(tok)
}
func boot_term(source:string,tokens:ints,cursor:ints,depth:int)->int {
 result=boot_factor(source,tokens,cursor,depth)
 tok=boot_peek(source,tokens,cursor)
 while tok=="*" or tok=="/" or tok=="%" {
  cursor[0]=cursor[0]+3;right=boot_factor(source,tokens,cursor,depth)
  if tok=="*" {result*=right} else if tok=="/" {result/=right} else {result=result%right}
  tok=boot_peek(source,tokens,cursor)
 }
 return result
}
func boot_expr(source:string,tokens:ints,cursor:ints,depth:int)->int {
 result=boot_term(source,tokens,cursor,depth)
 tok=boot_peek(source,tokens,cursor)
 while tok=="+" or tok=="-" {
  cursor[0]=cursor[0]+3;right=boot_term(source,tokens,cursor,depth)
  if tok=="+" {result+=right} else {result-=right}
  tok=boot_peek(source,tokens,cursor)
 }
 return result
}
func boot_eval(source:string)->int {
 tokens=boot_lex(source);cursor=ints(1)
 result=boot_expr(source,tokens,cursor,0)
 assert cursor[0]==len(tokens),"Unexpected token after expression"
 return result
}
