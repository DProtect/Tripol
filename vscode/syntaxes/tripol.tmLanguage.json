{
  "name": "TRIPOL",
  "scopeName": "source.tripol",
  "patterns": [
    {
      "name": "comment.line.double-slash.tripol",
      "match": "//.*$"
    },
    {
      "name": "comment.line.number-sign.tripol",
      "match": "#.*$"
    },
    {
      "name": "support.class.tripol",
      "match": "\\btripol\\.(animation|arrays|atomic|binary|bits|bitset|buffer|camera|canvas|checksum|collections|colors|compression|console|convert|csv|datetime|dictionary|discord|encoding|env|errors|events|files|game|geometry|heap|http|https|image|io|json|math|matrix|memory|network|particles|path|physics|profiler|queue|random|regex|search|sequences|simd|sort|sprite|stack|stats|stream|system|testing|text|time|ui|utf8|validate|vector)\\b"
    },
    {
      "name": "string.quoted.double.tripol",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.tripol",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.tripol",
      "match": "\\b(import|if|else|while|repeat|for|in|break|continue|return|show|assert|try|catch|finally|throw|scratch)\\b"
    },
    {
      "name": "storage.type.tripol",
      "match": "\\b(func|struct|let|const|int|bool|string|float|ints|list)\\b"
    },
    {
      "name": "constant.language.tripol",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "support.function.tripol",
      "match": "\\b(len|range|input|input_int|parse_int|sum|min|max|abs|sqrt|read_text|write_text|append_text|text|slice|byte_at|monotonic_ms|sleep_ms|has_prefix|has_suffix|find_bytes|tcp_exchange)\\b"
    },
    {
      "name": "constant.numeric.tripol",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
    },
    {
      "name": "keyword.operator.tripol",
      "match": "[+*/%=<>!&|\\-]+"
    },
    {
      "name": "keyword.operator.word.tripol",
      "match": "\\b(and|or|not)\\b"
    }
  ]
}
