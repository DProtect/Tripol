{
  "Hello world": {
    "prefix": "hello",
    "body": [
      "show \"Hello, TRIPOL!\""
    ]
  },
  "Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:a}, ${3:b}) {",
      "    return ${4:a + b}",
      "}"
    ]
  },
  "Loop": {
    "prefix": "for",
    "body": [
      "for ${1:i} in range(0, ${2:10}) {",
      "    show ${1:i}",
      "}"
    ]
  },
  "Discord bot": {
    "prefix": "discord-bot",
    "body": [
      "import tripol.discord",
      "",
      "bot = discord.bot()",
      "bot.prefix(\"!\")",
      "bot.command(\"${1:ping}\", \"${2:Pong!}\")",
      "bot.start()"
    ]
  },
  "Discord embed": {
    "prefix": "discord-embed",
    "body": [
      "import tripol.discord",
      "",
      "embed = discord.embed()",
      "embed.title(\"${1:Welcome}\")",
      "embed.description(\"${2:Hello!}\")",
      "show embed.payload()"
    ]
  }
}
