{
  "Hello world": {
    "prefix": "hello",
    "body": [
      "show \"Hello, TRIPOL!\""
    ]
  },
  "Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:a}, ${3:b}) {",
      "    return ${4:a + b}",
      "}"
    ]
  },
  "Loop": {
    "prefix": "for",
    "body": [
      "for ${1:i} in range(0, ${2:10}) {",
      "    show ${1:i}",
      "}"
    ]
  },
  "Discord bot": {
    "prefix": "discord-bot",
    "body": [
      "import tripol.discord",
      "",
      "bot = discord.bot()",
      "bot.prefix(\"!\")",
      "bot.command(\"${1:ping}\", \"${2:Pong!}\")",
      "bot.start()"
    ]
  },
  "Discord embed": {
    "prefix": "discord-embed",
    "body": [
      "import tripol.discord",
      "",
      "embed = discord.embed()",
      "embed.title(\"${1:Welcome}\")",
      "embed.description(\"${2:Hello!}\")",
      "show embed.payload()"
    ]
  },
  "Discord message callback": {
    "prefix": "discord-message",
    "body": [
      "import tripol.discord",
      "",
      "func respond(message:discord.Message)->string {",
      "    if message.matches(\"${1:hola}\") {return message.reply(\"${2:Hola!}\")}",
      "    return \"\"",
      "}",
      "",
      "bot = discord.bot()",
      "bot.on_message(&respond)",
      "bot.start()"
    ]
  },
  "Discord Components V2": {
    "prefix": "discord-components",
    "body": [
      "import tripol.discord",
      "",
      "message = discord.components()",
      "message.text(\"${1:Bienvenido}\")",
      "message.separator()",
      "show message.payload()"
    ]
  },
  "Discord slash callback": {
    "prefix": "discord-slash",
    "body": [
      "import tripol.discord",
      "",
      "func respond(ctx) {",
      "    ctx.reply(\"${1:Hola}\", true)",
      "}",
      "",
      "bot=discord.bot()",
      "bot.slash(\"${2:hola}\", \"${3:Saluda}\", respond)",
      "bot.start()"
    ]
  },
  "Discord Gateway event callback": {
    "prefix": "discord-event",
    "body": [
      "func ${1:ready}(event:discord.GatewayEvent)->bool {",
      "    show event.name",
      "    return true",
      "}",
      "registry=discord.events()",
      "registry.on(\"${2:READY}\",&${1:ready})",
      "bot.start_with_events(registry)"
    ]
  },
  "Discord autocomplete callback": {
    "prefix": "discord-autocomplete",
    "body": [
      "func ${1:suggest}(ctx:discord.Interaction)->string {",
      "    choices=discord.command_choices()",
      "    if ctx.focused()==\"${2:query}\" {",
      "        choices.add(\"${3:Café}\",\"${4:cafe}\")",
      "    }",
      "    return ctx.autocomplete(choices)",
      "}"
    ]
  },
  "Discord deferred reply": {
    "prefix": "discord-defer",
    "body": [
      "if ctx.respond(ctx.defer(true)) {",
      "    ctx.edit_reply(\"${1:Listo}\")",
      "}",
      "return \"\""
    ]
  },
  "Discord modal": {
    "prefix": "discord-modal",
    "body": [
      "form=discord.modal(\"${1:feedback}\", \"${2:Comentarios}\")",
      "form.text(\"${3:topic}\", \"${4:Tema}\")",
      "return ctx.open_modal(form)"
    ]
  },
  "Discord emoji button": {
    "prefix": "discord-emoji-button",
    "body": [
      "panel=discord.container(\"#FFFFFF\")",
      "panel.button(\"${1:Aceptar}\",\"${2:accept}\",\"${3:success}\",\"${4:✅}\")",
      "show panel.payload()"
    ]
  },
  "Discord context menu": {
    "prefix": "discord-context-menu",
    "body": [
      "func ${1:inspect}(ctx) {",
      "    ctx.reply(\"ID: \" + ctx.target_id(), true)",
      "}",
      "bot.user_menu(\"${2:Ver perfil}\",${1:inspect})"
    ]
  }
}
