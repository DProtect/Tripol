{
  "name": "tripol-language",
  "displayName": "TRIPOL Language",
  "description": "Official TRIPOL syntax highlighting, snippets and editor configuration",
  "version": "0.24.0",
  "publisher": "tripol",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tripol",
        "aliases": [
          "TRIPOL",
          "tripol"
        ],
        "extensions": [
          ".tri"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tripol",
        "scopeName": "source.tripol",
        "path": "./syntaxes/tripol.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tripol",
        "path": "./snippets/tripol.json"
      }
    ]
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tripollas/Tripol.git",
    "directory": "vscode"
  },
  "homepage": "https://github.com/Tripollas/Tripol",
  "bugs": {
    "url": "https://github.com/Tripollas/Tripol/issues"
  }
}
