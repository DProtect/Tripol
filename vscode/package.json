{
  "name": "tripol-language",
  "displayName": "TRIPOL Language",
  "description": "Official TRIPOL highlighting, snippets, completion and compiler diagnostics",
  "version": "0.28.0",
  "publisher": "tripol",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tripol",
        "aliases": [
          "TRIPOL",
          "tripol"
        ],
        "extensions": [
          ".tri"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tripol",
        "scopeName": "source.tripol",
        "path": "./syntaxes/tripol.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tripol",
        "path": "./snippets/tripol.json"
      }
    ],
    "commands": [
      {
        "command": "tripol.check",
        "title": "TRIPOL: Check source"
      },
      {
        "command": "tripol.build",
        "title": "TRIPOL: Build source"
      },
      {
        "command": "tripol.run",
        "title": "TRIPOL: Run source"
      }
    ],
    "configuration": {
      "title": "TRIPOL",
      "properties": {
        "tripol.compilerPath": {
          "type": "string",
          "default": "tripol",
          "description": "Path to the installed compiler executable."
        },
        "tripol.checkOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Check saved TRIPOL files in trusted workspaces."
        }
      }
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tripollas/Tripol.git",
    "directory": "vscode"
  },
  "homepage": "https://github.com/Tripollas/Tripol",
  "bugs": {
    "url": "https://github.com/Tripollas/Tripol/issues"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:tripol",
    "onCommand:tripol.check",
    "onCommand:tripol.build",
    "onCommand:tripol.run"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax assistance works; compiler commands require workspace trust."
    }
  }
}
