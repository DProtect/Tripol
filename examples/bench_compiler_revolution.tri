// COMPILER REVOLUTION: exercise native fill, scalar join and PGO training.
func cold(x:int)->int {
    show x
    return x
}
func hot(x:int,flag:bool)->int {
    value=x
    if flag {
        value=x+1
    } else {
        value=x-1
    }
    return value
}
a=ints(9)
for i in range(9) {
    a[i]=7
}
show cold(a[0])
for i in range(6) {
    show hot(a[i],true)
}
