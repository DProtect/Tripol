import tripol.game
import tripol.canvas
import tripol.physics
import tripol.profiler
w=320;h=180
pixels=canvas.create(w,h)
x=20;y=80;cx=240;cy=90;score=0;frame=0
started=profiler.start()
game.window("TRIPOL QUANTUM X — Collect the light",960,540)
while game.running() {
 if game.key(27) {break}
 if game.key(37) or game.key(65) {x-=2}
 if game.key(39) or game.key(68) {x+=2}
 if game.key(38) or game.key(87) {y-=2}
 if game.key(40) or game.key(83) {y+=2}
 x=physics.clamp_position(x,12,w);y=physics.clamp_position(y,12,h)
 if x<cx+8 and x+12>cx and y<cy+8 and y+12>cy {
  score+=1;cx=20+(score*47)%280;cy=20+(score*31)%140
 }
 canvas.clear(pixels,1052688)
 for i in range(20) {canvas.line(pixels,w,h,i*16,0,i*16,h-1,1579032)}
 for i in range(12) {canvas.line(pixels,w,h,0,i*16,w-1,i*16,1579032)}
 canvas.rectangle(pixels,w,h,cx,cy,8,8,16766720)
 canvas.rectangle(pixels,w,h,x,y,12,12,65535)
 canvas.rectangle(pixels,w,h,x+2,y+2,3,3,16777215)
 if frame%20<10 {canvas.rectangle(pixels,w,h,cx-2,cy-2,2,2,16777215)}
 for i in range(min(score,30)) {canvas.rectangle(pixels,w,h,4+i*5,4,3,5,16766720)}
 game.present(pixels,w,h);frame+=1;game.wait(16)
}
game.close()
show "Score",score
show "Frames",frame
show "Elapsed ns",profiler.elapsed(started)
