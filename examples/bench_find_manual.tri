func contains_manual(s:string,needle:string)->bool {
 n=len(s)
 m=len(needle)
 if m==0 {return true}
 if m>n {return false}
 for i in range(n-m+1) {
  equal=true
  for j in range(m) {
   if byte_at(s,i+j)!=byte_at(needle,j) {equal=false;break}
  }
  if equal {return true}
 }
 return false
}
n=0
repeat 200000 {
 if contains_manual("abcdefghijklmnopqrstuvwxyz0123456789","xyz0") {n+=1}
}
show n
