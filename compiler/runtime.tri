import "parser.tri"
import "ast.tri"
import "elf64.tri"
import "pe64.tri"
import tripol.buffer
import tripol.dictionary
import tripol.validate
// GENESIS R3: checked integer statements, native functions and structured control flow.
// Code uses a fixed 256-byte stack frame, 32 checked integer slots.
func gen_nibble(b:int)->int {
 if b>=48 and b<=57 {return b-48}
 assert b>=97 and b<=102,"Invalid machine hex"
 return b-87
}
func gen_bytes(code:ints,bytes:string)->int {
 assert len(bytes)%2==0,"Invalid machine hex"
 for i in range(len(bytes)/2) {
  assert buffer.size(code)<buffer.capacity(code),"Code limit"
  buffer.push(code,gen_nibble(byte_at(bytes,i*2))*16+gen_nibble(byte_at(bytes,i*2+1)))
 }
 return 0
}
func gen_imm(code:ints,value:int,width:int)->int {
 for i in range(width) {assert buffer.size(code)<buffer.capacity(code),"Code limit";buffer.push(code,value%256);value/=256}
 return 0
}
func gen_trap(code:ints)->int {
 gen_bytes(code,"b80a000000")
 at=gen_jump(code,"e9");gen_patch(code,at,10);return 0
}
func gen_guard(code:ints)->int {
 ok=gen_jump(code,"0f81");gen_trap(code);gen_patch(code,ok,buffer.size(code));return 0
}
// RAX holds RHS; left operand is on stack. Preserve checked signed semantics.
func gen_binary(code:ints,kind:int)->int {
 if kind==4 {gen_bytes(code,"594801c8");gen_guard(code);return 0}
 if kind==5 {gen_bytes(code,"594829c14889c8");gen_guard(code);return 0}
 if kind==6 {gen_bytes(code,"59480fafc1");gen_guard(code);return 0}
 assert kind==7 or kind==8,"Invalid binary AST"
 gen_bytes(code,"4889c1584885c9")
 nonzero=gen_jump(code,"0f85");gen_trap(code);gen_patch(code,nonzero,buffer.size(code))
 gen_bytes(code,"4883f9ff");normal=gen_jump(code,"0f85")
 gen_bytes(code,"48ba00000000000000804839d0");nonmin=gen_jump(code,"0f85")
 gen_trap(code);gen_patch(code,normal,buffer.size(code));gen_patch(code,nonmin,buffer.size(code))
 gen_bytes(code,"489948f7f9")
 if kind==8 {gen_bytes(code,"4889d0")}
 return 0
}
// Separate AST traversal emits each expression once, in source order.
func gen_ast_emit(src:string,tok:ints,tree:ints,id:int,code:ints,syms:ints,funcs:ints,depth:int)->int {
 assert depth<=1024,"AST emission nesting limit"
 kind=ast_field(tree,id,0);left=ast_field(tree,id,1);right=ast_field(tree,id,2)
 if kind==1 {gen_bytes(code,"48b8");gen_imm(code,left,8);return 1}
 if kind==11 {gen_bytes(code,"48b8");gen_imm(code,left,8);return 2}
 if kind==2 {
  name=slice(src,tok[left+1],tok[left+2])
  assert dictionary.contains(syms,name),"Unknown variable"
  slot=dictionary.get(syms,name);gen_load(code,slot);return gen_slot_type(slot)
 }
 if kind==3 {
  assert gen_ast_emit(src,tok,tree,left,code,syms,funcs,depth+1)==1,"Integer operand required"
  gen_bytes(code,"48f7d8");gen_guard(code);return 1
 }
 if kind==9 {
  name=slice(src,tok[left+1],tok[left+2])
  assert dictionary.contains(funcs,name),"Unknown function"
  signature=dictionary.get(funcs,name);n=0;link=right;mask=signature/32%256
  while link!=0 {
   assert ast_field(tree,link,0)==10 and n<8,"Invalid argument chain"
   typ=gen_ast_emit(src,tok,tree,ast_field(tree,link,1),code,syms,funcs,depth+1)
   assert typ==1+mask%2,"Argument type mismatch";mask/=2
   gen_bytes(code,"50");n+=1;link=ast_field(tree,link,2)
  }
  assert n==signature%16,"Invalid arguments"
  at=gen_jump(code,"e8");gen_patch(code,at,15+signature/8192*5)
  if n>0 {gen_bytes(code,"4883c4");gen_imm(code,n*8,1)}
  return 1+signature/16%2
 }
 if kind==18 {
  assert gen_ast_emit(src,tok,tree,left,code,syms,funcs,depth+1)==2,"Boolean operand required"
  gen_bytes(code,"83f001");return 2
 }
 if kind==19 or kind==20 {
  assert gen_ast_emit(src,tok,tree,left,code,syms,funcs,depth+1)==2,"Boolean operand required"
  gen_bytes(code,"4885c0");skip=0
  if kind==19 {skip=gen_jump(code,"0f84")} else {skip=gen_jump(code,"0f85")}
  assert gen_ast_emit(src,tok,tree,right,code,syms,funcs,depth+1)==2,"Boolean operand required"
  gen_patch(code,skip,buffer.size(code));return 2
 }
 assert (kind>=4 and kind<=8) or (kind>=12 and kind<=17),"Invalid expression AST"
 lt=gen_ast_emit(src,tok,tree,left,code,syms,funcs,depth+1)
 gen_bytes(code,"50")
 rt=gen_ast_emit(src,tok,tree,right,code,syms,funcs,depth+1)
 if kind<=8 {
  assert lt==1 and rt==1,"Integer operands required"
  gen_binary(code,kind);return 1
 }
 assert lt==rt and (kind<=13 or lt==1),"Comparison type mismatch"
 gen_bytes(code,"4889c1584839c8")
 if kind==12 {gen_bytes(code,"0f94c0")}
 if kind==13 {gen_bytes(code,"0f95c0")}
 if kind==14 {gen_bytes(code,"0f9cc0")}
 if kind==15 {gen_bytes(code,"0f9ec0")}
 if kind==16 {gen_bytes(code,"0f9fc0")}
 if kind==17 {gen_bytes(code,"0f9dc0")}
 gen_bytes(code,"0fb6c0");return 2
}
func gen_expr(src:string,tok:ints,c:ints,code:ints,syms:ints,funcs:ints,depth:int)->int {
 tree=ast_create(tok)
 root=ast_expr(src,tok,c,tree,depth)
 return gen_ast_emit(src,tok,tree,root,code,syms,funcs,0)
}
// Branch offsets are relative to the instruction immediately after rel32.
func gen_patch(code:ints,at:int,target:int)->int {
 delta=target-at-4
 if delta<0 {delta+=4294967296}
 for i in range(4) {buffer.set(code,at+i,delta%256);delta/=256}
 return 0
}
func gen_jump(code:ints,opcode:string)->int {
 gen_bytes(code,opcode);at=buffer.size(code);gen_imm(code,0,4);return at
}
func gen_condition(src:string,tok:ints,c:ints,code:ints,syms:ints,funcs:ints)->int {
 assert gen_expr(src,tok,c,code,syms,funcs,0)==2,"Condition must be boolean"
 gen_bytes(code,"4885c0");return gen_jump(code,"0f84")
}
func gen_separators(src:string,tok:ints,c:ints)->int {
 while boot_peek(src,tok,c)==";" or boot_peek(src,tok,c)=="\n" {c[0]=c[0]+3}
 return 0
}
// Slots encode type in bit 6: 1..32 int, 65..96 bool; negative is immutable.
func gen_slot_type(slot:int)->int {if abs(slot)>64 {return 2};return 1}
func gen_load(code:ints,slot:int)->int {gen_bytes(code,"488b85");gen_imm(code,4294967296-(abs(slot)%64)*8,4);return 0}
func gen_store(code:ints,slot:int)->int {gen_bytes(code,"488985");gen_imm(code,4294967296-(abs(slot)%64)*8,4);return 0}
func gen_expect(src:string,tok:ints,c:ints,want:string)->int {
 assert boot_peek(src,tok,c)==want,"Unexpected token"
 c[0]+=3;return 0
}
func gen_name(src:string,tok:ints,c:ints)->string {
 assert c[0]<len(tok) and tok[c[0]]==1,"Expected identifier"
 name=boot_peek(src,tok,c);assert len(name)<=32 and validate.identifier(name),"Invalid identifier"
 assert name!="if" and name!="else" and name!="while" and name!="for" and name!="return" and name!="show" and name!="func" and name!="range" and name!="in" and name!="true" and name!="false" and name!="not" and name!="and" and name!="or" and name!="int" and name!="bool" and name!="break" and name!="continue","Reserved identifier"
 c[0]+=3;return name
}
func gen_statements(src:string,tok:ints,c:ints,code:ints,syms:ints,funcs:ints,depth:int,result_type:int,stop=-1,next=-1)->int {
 assert depth<=16,"Statement nesting limit"
 gen_separators(src,tok,c)
 while c[0]<len(tok) and boot_peek(src,tok,c)!="}" {
  name=boot_peek(src,tok,c)
  if name=="show" {
   c[0]+=3;assert gen_expr(src,tok,c,code,syms,funcs,0)==1,"Show requires integer in GENESIS R3"
   at=gen_jump(code,"e8");gen_patch(code,at,5)
  } else if name=="return" {
   assert result_type>0,"Return outside function"
   c[0]+=3;assert gen_expr(src,tok,c,code,syms,funcs,0)==result_type,"Return type mismatch";gen_bytes(code,"c9c3")
   gen_separators(src,tok,c);assert boot_peek(src,tok,c)=="}","Expected closing brace after return"
   return 1
  } else if name=="break" or name=="continue" {
   assert stop>=0 and next>=0,"Loop control outside loop"
   c[0]+=3;at=gen_jump(code,"e9")
   if name=="break" {gen_patch(code,at,stop)} else {gen_patch(code,at,next)}
  } else if name=="if" {
   gen_if(src,tok,c,code,syms,funcs,depth,result_type,stop,next)
  } else if name=="while" {
   c[0]+=3
   enter=gen_jump(code,"e9");stop_label=buffer.size(code);stop_fix=gen_jump(code,"e9")
   start=buffer.size(code);gen_patch(code,enter,start);skip=gen_condition(src,tok,c,code,syms,funcs)
   gen_expect(src,tok,c,"{")
   gen_statements(src,tok,c,code,syms,funcs,depth+1,result_type,stop_label,start)
   gen_expect(src,tok,c,"}")
   back=gen_jump(code,"e9");gen_patch(code,back,start)
   gen_patch(code,skip,buffer.size(code));gen_patch(code,stop_fix,buffer.size(code))
  } else if name=="for" {
   c[0]+=3;counter=gen_name(src,tok,c)
   assert not dictionary.contains(syms,counter),"Range variable already declared"
   gen_expect(src,tok,c,"in");gen_expect(src,tok,c,"range");gen_expect(src,tok,c,"(")
   assert gen_expr(src,tok,c,code,syms,funcs,0)==1,"Range requires integer"
   slot=dictionary.size(syms)+1;assert slot<=31,"Variable limit"
   if boot_peek(src,tok,c)=="," {
    gen_store(code,slot);c[0]+=3;assert gen_expr(src,tok,c,code,syms,funcs,0)==1,"Range requires integer";gen_store(code,slot+1)
   } else {gen_store(code,slot+1);gen_bytes(code,"31c0");gen_store(code,slot)}
   gen_expect(src,tok,c,")");gen_expect(src,tok,c,"{")
   hidden="@bound"+text(depth)
   assert dictionary.set(syms,counter,-slot),"Variable limit"
   assert dictionary.set(syms,hidden,slot+1),"Variable limit"
   enter=gen_jump(code,"e9");stop_label=buffer.size(code);stop_fix=gen_jump(code,"e9")
   next_label=buffer.size(code);next_fix=gen_jump(code,"e9")
   start=buffer.size(code);gen_patch(code,enter,start)
   gen_load(code,slot+1);gen_bytes(code,"50");gen_load(code,slot);gen_bytes(code,"594839c8")
   skip=gen_jump(code,"0f8d")
   gen_statements(src,tok,c,code,syms,funcs,depth+1,result_type,stop_label,next_label);gen_expect(src,tok,c,"}")
   gen_patch(code,next_fix,buffer.size(code))
   gen_load(code,slot);gen_bytes(code,"4883c001");gen_guard(code);gen_store(code,slot)
   back=gen_jump(code,"e9");gen_patch(code,back,start);gen_patch(code,skip,buffer.size(code));gen_patch(code,stop_fix,buffer.size(code))
   dictionary.remove(syms,counter);dictionary.remove(syms,hidden)
  } else {
   name=gen_name(src,tok,c);op=boot_peek(src,tok,c)
   assert op=="=" or op=="+=" or op=="-=" or op=="*=" or op=="/=" or op=="%=","Expected assignment"
   c[0]+=3
   if op!="=" {
    assert dictionary.contains(syms,name) and dictionary.get(syms,name)>0,"Compound assignment requires mutable variable"
    assert gen_slot_type(dictionary.get(syms,name))==1,"Compound assignment requires integer"
    gen_load(code,dictionary.get(syms,name));gen_bytes(code,"50")
   }
   typ=gen_expr(src,tok,c,code,syms,funcs,0)
   if op!="=" {assert typ==1,"Compound assignment requires integer"}
   if op=="+=" {gen_binary(code,4)}
   if op=="-=" {gen_binary(code,5)}
   if op=="*=" {gen_binary(code,6)}
   if op=="/=" {gen_binary(code,7)}
   if op=="%=" {gen_binary(code,8)}
   if not dictionary.contains(syms,name) {
    assert depth==0,"Declare variables before control flow"
    slot=dictionary.size(syms)+1+64*(typ-1);assert dictionary.set(syms,name,slot),"Variable limit"
   }
   slot=dictionary.get(syms,name);assert slot>0,"Immutable range counter"
   assert gen_slot_type(slot)==typ,"Assignment type mismatch"
   gen_store(code,slot)
  }
  // Control blocks consume separators while looking for else; ordinary
  // statements require a delimiter or end of block/file.
  sep=boot_peek(src,tok,c)
  if name!="if" and name!="while" and name!="for" {assert sep==";" or sep=="\n" or sep=="}" or sep=="","Expected separator"}
  gen_separators(src,tok,c)
 }
 return 0
}
func gen_if(src:string,tok:ints,c:ints,code:ints,syms:ints,funcs:ints,depth:int,result_type:int,stop:int,next:int)->int {
 assert depth<=16,"If nesting limit"
 gen_expect(src,tok,c,"if");skip=gen_condition(src,tok,c,code,syms,funcs)
 gen_expect(src,tok,c,"{")
 gen_statements(src,tok,c,code,syms,funcs,depth+1,result_type,stop,next)
 gen_expect(src,tok,c,"}");gen_separators(src,tok,c)
 if boot_peek(src,tok,c)=="else" {
  done=gen_jump(code,"e9");gen_patch(code,skip,buffer.size(code));c[0]+=3
  if boot_peek(src,tok,c)=="if" {gen_if(src,tok,c,code,syms,funcs,depth+1,result_type,stop,next)}
  else {
   gen_expect(src,tok,c,"{");gen_statements(src,tok,c,code,syms,funcs,depth+1,result_type,stop,next);gen_expect(src,tok,c,"}")
  }
  gen_patch(code,done,buffer.size(code))
 } else {gen_patch(code,skip,buffer.size(code))}
 return 0
}
func gen_type(src:string,tok:ints,c:ints)->int {
 word=boot_peek(src,tok,c);c[0]+=3
 if word=="int" {return 1}
 assert word=="bool","Expected int or bool";return 2
}
// Declaration pass establishes signatures and trampoline indices before
// emitting any bodies. Each call can reference its stable 5-byte jump stub.
func gen_collect_functions(src:string,tok:ints,funcs:ints)->int {
 scan=ints(1);gen_separators(src,tok,scan)
 while boot_peek(src,tok,scan)=="func" {
  scan[0]+=3;name=gen_name(src,tok,scan)
  assert not dictionary.contains(funcs,name),"Duplicate function"
  gen_expect(src,tok,scan,"(");n=0;mask=0;bit=1
  if boot_peek(src,tok,scan)!=")" {
   more=true
   while more {
    param=gen_name(src,tok,scan)
    gen_expect(src,tok,scan,":");typ=gen_type(src,tok,scan)
    mask+=(typ-1)*bit;bit*=2
    n+=1;assert n<=8,"Argument limit"
    more=boot_peek(src,tok,scan)==","
    if more {scan[0]+=3}
   }
  }
  gen_expect(src,tok,scan,")");gen_expect(src,tok,scan,"->");ret=gen_type(src,tok,scan)
  gen_expect(src,tok,scan,"{")
  slot=dictionary.size(funcs);assert dictionary.set(funcs,name,slot*8192+mask*32+(ret-1)*16+n),"Function limit"
  depth=1
  while depth>0 {
   assert scan[0]<len(tok),"Unclosed function"
   word=boot_peek(src,tok,scan);scan[0]+=3
   if word=="{" {depth+=1}
   if word=="}" {depth-=1}
  }
  gen_separators(src,tok,scan)
 }
 return dictionary.size(funcs)
}
func gen_function(src:string,tok:ints,c:ints,code:ints,funcs:ints)->int {
 gen_expect(src,tok,c,"func");name=gen_name(src,tok,c)
 assert dictionary.contains(funcs,name),"Missing function signature"
 signature=dictionary.get(funcs,name)
 syms=dictionary.create(32);n=0;mask=signature/32%256
 gen_expect(src,tok,c,"(")
 if boot_peek(src,tok,c)!=")" {
  more=true
  while more {
   param=gen_name(src,tok,c);assert n<8 and not dictionary.contains(syms,param),"Invalid parameter"
   gen_expect(src,tok,c,":");typ=gen_type(src,tok,c)
   assert typ==1+mask%2,"Signature type mismatch";mask/=2
   n+=1;assert dictionary.set(syms,param,n+64*(typ-1)),"Parameter limit"
   more=boot_peek(src,tok,c)==","
   if more {c[0]+=3}
  }
 }
 gen_expect(src,tok,c,")");gen_expect(src,tok,c,"->");ret=gen_type(src,tok,c);gen_expect(src,tok,c,"{")
 assert n==signature%16 and ret==1+signature/16%2,"Function signature mismatch"
 gen_patch(code,16+signature/8192*5,buffer.size(code))
 // Separate frame; callers push arguments left-to-right.
 gen_bytes(code,"554889e54881ec00010000")
 for i in range(n) {
  gen_bytes(code,"488b85");gen_imm(code,16+(n-i-1)*8,4);gen_store(code,i+1)
 }
 assert gen_statements(src,tok,c,code,syms,funcs,0,ret)==1,"Function requires final return"
 gen_expect(src,tok,c,"}");gen_separators(src,tok,c);return 0
}
func gen_runtime(source:string,target:string="linux")->ints {
 assert target=="linux" or target=="windows","Unsupported target"
 tok=boot_lex(source);c=ints(1);code=buffer.create(65536);syms=dictionary.create(32);funcs=dictionary.create(32)
 count=gen_collect_functions(source,tok,funcs)
 entry=gen_jump(code,"e9");print_jump=gen_jump(code,"e9");exit_jump=gen_jump(code,"e9")
 for i in range(count) {gen_jump(code,"e9")}
 gen_patch(code,print_jump,buffer.size(code));print_start=buffer.size(code)
 if target=="linux" {
  gen_bytes(code,"4883ec20488d74241fc6060a4989f04989c14531d24885c0790948f7d841ba01000000b90a00000031d248f7f180c23048ffce88164885c075ee4585d2740648ffcec6062d4c89c24829f248ffc2b801000000bf010000000f054883c420c3")
 } else {
  // Windows x64 ABI: aligned stack, shadow space, explicit WriteFile length.
  gen_bytes(code,"554889e54883e4f04883ec60488d74245fc6060a4989f14531c04885c0790948f7d841b801000000b90a00000031d248f7f180c23048ffce88164885c075ee4585c0740648ffcec6062d4929f149ffc148897424304c894c2438b9f5ffffffff15000000004889c1488b5424304c8b4424384c8d4c242848c744242000000000ff1500000000c9c3")
 }
 gen_patch(code,exit_jump,buffer.size(code));exit_start=buffer.size(code)
 if target=="linux" {gen_bytes(code,"89c7b83c0000000f050f0b")}
 else {gen_bytes(code,"89c14883e4f04883ec20ff15000000000f0b")}
 gen_separators(source,tok,c)
 while boot_peek(source,tok,c)=="func" {gen_function(source,tok,c,code,funcs)}
 gen_patch(code,entry,buffer.size(code));gen_bytes(code,"4889e54881ec00010000")
 gen_statements(source,tok,c,code,syms,funcs,0,0)
 assert c[0]==len(tok),"Unexpected trailing token"
 gen_bytes(code,"31c0");last=gen_jump(code,"e9");gen_patch(code,last,10)
 if target=="windows" {
  idrva=genesis_align(4096+buffer.size(code),4096)
  gen_patch(code,print_start+97,idrva-4096+72)
  gen_patch(code,print_start+130,idrva-4096+80)
  gen_patch(code,exit_start+12,idrva-4096+88)
  return genesis_code_pe(buffer.values(code))
 }
 return genesis_code_elf(buffer.values(code))
}
