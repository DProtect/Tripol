import tripol.validate
import tripol.collections
// Self-hosting experiment: ASCII lexer, not the production compiler frontend.
// Flat triples [kind,start,endExclusive]. Kinds: 1=id, 2=number, 3=string,
// 4=operator, 5=newline. Comments and horizontal whitespace are skipped.
func boot_identifier(b:int)->bool {return validate.letter(b) or b==95}
func boot_op(b:int)->bool {
 return b==43 or b==45 or b==42 or b==47 or b==37 or b==60 or b==62 or b==61 or b==33 or b==40 or b==41 or b==123 or b==125 or b==91 or b==93 or b==44 or b==46 or b==58 or b==59 or b==38 or b==124
}
func boot_pair(a:int,b:int)->bool {
 return (b==61 and (a==43 or a==45 or a==42 or a==47 or a==37 or a==60 or a==62 or a==61 or a==33)) or (a==45 and b==62) or (a==61 and b==62) or (a==38 and b==38) or (a==124 and b==124)
}
func boot_lex(source:string)->ints {
 n=len(source);assert n<=4096,"Bootstrap source limit"
 out=ints(n*3);count=0;i=0
 while i<n {
  b=byte_at(source,i)
  start=i;kind=0
  if b==32 or b==9 or b==13 {i+=1}
  else if b==35 or (b==47 and i+1<n and byte_at(source,i+1)==47) {
   while i<n and byte_at(source,i)!=10 {i+=1}
  } else if b==10 {kind=5;i+=1}
  else if boot_identifier(b) {
   kind=1;i+=1
   while i<n and (boot_identifier(byte_at(source,i)) or validate.digit(byte_at(source,i))) {i+=1}
  } else if validate.digit(b) {
   kind=2;i+=1
   while i<n and validate.digit(byte_at(source,i)) {i+=1}
   if i+1<n and byte_at(source,i)==46 and validate.digit(byte_at(source,i+1)) {
    i+=1;while i<n and validate.digit(byte_at(source,i)) {i+=1}
   }
  } else if b==34 {
   kind=3;i+=1;closed=false
   while i<n and not closed {
    c=byte_at(source,i)
    if c==92 {i+=2;assert i<=n,"Unterminated escape"}
    else if c==34 {i+=1;closed=true}
    else {assert c!=10 and c!=13,"Newline in string";i+=1}
   }
   assert closed,"Unterminated string"
  } else {
   assert boot_op(b),"Unknown bootstrap character"
   kind=4;i+=1
   if i<n and boot_pair(b,byte_at(source,i)) {i+=1}
  }
  if kind!=0 {out[count]=kind;out[count+1]=start;out[count+2]=i;count+=3}
 }
 return collections.part(out,0,count)
}
