import "runtime.tri"
import tripol.encoding
// R1 remains compatible. R2 adds semicolon-separated integer assignments.
source=input()
image=ints(0)
if has_prefix(source,"show ") {
 value=boot_eval(slice(source,5,len(source)))
 image=genesis_elf(text(value)+"\n")
} else {
 image=gen_runtime(source)
}
encoded=""
for byte in image {encoded+=encoding.hex_byte(byte)}
show encoded
